main: (argc: int, argv: **const char) ~> int
{
#note ("before")
    vv: &immer.vector(v_string_t) := {};
#note ("after")

    vv := vv.push_back("превед");
    vv := vv.push_back("медвед");
    vv := vv.push_back("кагдила");

    for (s = vv.size, i: &int := 0; i < s; ++i)
    {
        printf("vv[%d]: %s\n", i, vv[i].data);
    }

}




