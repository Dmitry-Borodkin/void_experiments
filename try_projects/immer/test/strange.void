


//---------------------------------------------------------------------
#template _instantiate_equal: [](NS: v_static_namespace_t, Iter1: v_static_type_t, Iter2: v_static_type_t)
{
    inlinehint
    _equal: (i1: Iter1, i2: Iter2, n: size_t) ~> bool
    {
        e1 = i1 + n;
        i1: &Iter1 := i1;
        i2: &Iter2 := i2;

        for (; i1 < e1; ++i1, ++i2)
        {
            if (!(*i1 == *i2))  return  false;
        }

        return  true;
    }
}

//---------------------------------------------------------------------
#define equal: [](i1, i2, n: size_t = 1) ~> bool  =
{
    Iter1 = typeof(i1);
    Iter2 = typeof(i2);

    ns = v_generic_ns(equal_args, T[Iter1, Iter2]);

    _instantiate_equal(ns, Iter1, Iter2);

    ns._equal(i1, i2, n)
};




//---------------------------------------------------------------------
#define unref_typeof: (x) ~> v_static_type_t  =
{
    T = typeof(x);  #if (T.is_reference)  T = T.element_type;  #endif

    T
};

//---------------------------------------------------------------------
#define equal: [](i1, i2, n: size_t = 1) ~> bool  =
{
    Iter1 = unref_typeof(i1);
    Iter2 = unref_typeof(i2);

    ns = v_generic_ns(equal_args, T[Iter1, Iter2]);

    #template _: [ns, Iter1, Iter2]()
    {
        inlinehint
        _equal: (i1: Iter1, i2: Iter2, n: size_t) ~> bool
        {
            e1 = i1 + n;
            i1: &Iter1 := i1;
            i2: &Iter2 := i2;

            for (; i1 < e1; ++i1, ++i2)
            {
                if (!(*i1 == *i2))  return  false;
            }

            return  true;
        }
    }

    ns._equal(i1, i2, n)
};


//---------------------------------------------------------------------
visitor_t = v_static_namespace_t;

#define visitor_base: [](Derived: visitor_t) ~> visitor_t  =
{
    ns = v_generic_ns(visitor_base_tag, Q(v_namespace_get_name(Derived)));

    #template _: [ns, Derived]()
    {
        _base    = ns;
        _derived = Derived;

        #define visit_relaxed: [](pos, args) ~> _derived.result_t  =  _derived.visit_inner(pos, args);
        #define visit_regular: [](pos, args) ~> _derived.result_t  =  _derived.visit_inner(pos, args);
        #define visit_inner:   [](pos, args) ~> _derived.result_t  =  _derived.visit_node(pos, args);
        #define visit_leaf:    [](pos, args) ~> _derived.result_t  =  _derived.visit_node(pos, args);
        #define visit_node:    [](pos, args) ~> _derived.result_t  =  v_assert(false && "Kinda, unreachable...");
    }

    ns
};


namespace my_visitor
{
    using namespace visitor_base(my_visitor);

    //- ...

}


#define array_for_visitor: [](T: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(array_for_visitor_tag, T(T));

    #template _: [vis, T]()
    {
        using namespace visitor_base(vis);

        result_t = *T;

        #define visit_inner: [](pos, idx: size_t) ~> result_t  =  pos.descend(vis, idx);
        #define visit_leaf:  [](pos, idx: size_t) ~> result_t  =  pos.node->leaf;
    }

    vis
};


#define region_for_visitor: [](T: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(region_for_visitor_tag, T(T));

    #template _: [vis, T]()
    {
        using namespace visitor_base(vis);

        result_t = struct { *T; size_t; size_t; };

        #define visit_inner: [](pos, idx: size_t) ~> result_t  =  pos.towards(vis, idx);
        #define visit_leaf:  [](pos, idx: size_t) ~> result_t  =  {pos.node->leaf, pos.index(idx), pos.count};
    }

    vis
};


#define get_visitor: [](T: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(get_visitor_tag, T(T));

    #template _: [vis, T]()
    {
        using namespace visitor_base(vis);

        result_t = &const T;

        #define visit_inner: [](pos, idx: size_t) ~> result_t  =  pos.descend(vis, idx);
        #define visit_leaf:  [](pos, idx: size_t) ~> result_t  =  pos.node->leaf[pos.index(idx)];
    }

    vis
};


for_each_chunk_visitor  =
{
    vis = v_generic_ns(for_each_chunk_visitor_tag);

    #template _: [vis]()
    {
        using namespace visitor_base(vis);

        result_t = void;

        #define visit_inner: [](pos, fn) ~> result_t  =  pos.each(vis, fn);
        #define visit_leaf:  [](pos, fn) ~> result_t  =  { data = pos.node->leaf;  fn(data, data + pos.count) };
    }

    vis
};


for_each_chunk_p_visitor  =
{
    vis = v_generic_ns(for_each_chunk_p_visitor_tag);

    #template _: [vis]()
    {
        using namespace visitor_base(vis);

        result_t = bool;

        #define visit_inner: [](pos, fn) ~> result_t  =  pos.each_pred(vis, fn);
        #define visit_leaf:  [](pos, fn) ~> result_t  =  { data = pos.node->leaf;  fn(data, data + pos.count) };
    }

    vis
};


















