{ v_import("mainline.void"); }
{ v_enable_mainline(); }
//---------------------------------------------------------------------
{
    v_import("cstdio.void");

    v_import("string.void");

    v_import("../../config.void");
    v_import("../../memory_policy.void");

    v_import("../../detail/rbts/rrbtree.void");
    v_import("../../detail/rbts/rrbtree_iterator.void");
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }



//---------------------------------------------------------------------
namespace qwe
{
    using namespace .immer.detail;

    #define rrbtree: [](T:  v_static_type_t,
                        MP: v_static_namespace_t = default_memory_policy,
                        B:  rbts.bits_t          = default_bits,
                        BL: rbts.bits_t          = rbts.derive_bits_leaf(T, MP, B)
                        ) ~> v_static_type_t
      =  rbts.rrbtree(T, MP, B, BL);
}

using qwe.rrbtree;


//---------------------------------------------------------------------
{
#note ("before")
    t0: &rrbtree(int) := {};
#note ("after")
    t1: &rrbtree(int) := {};

    N = 1000000;

    for (i: &int := 0; i < N; ++i)
    {
        t0 := t0.push_back(i);
        t1 := t1.push_back(i);
    }

    printf("ok: %d\n", (t0.equals(t1) : int));

    for (i: &int := 0; i < N; ++i)
    {
        t1.get_mut(i) := t0.get(N-1-i);
    }

    printf("nok: %d\n", (t0.equals(t1) : int));

    t2: &rrbtree(int) := {};

    for (i: &int := 0; i < N; ++i)
    {
        t2.push_back_mut(t1.get(N-1-i));
    }

    printf("ok: %d\n", (t0.equals(t2) : int));


}

