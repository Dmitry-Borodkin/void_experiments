{
    printf("BL: %d\n", my.BL);

    printf("max_size: %zu\n", my.rbtree_t.max_size);

    printf("tree: %p\n", &tree);

    printf("my.rbtree_t._empty_root: %p\n", my.rbtree_t._empty_root);
    printf("my.rbtree_t._empty_tail: %p\n", my.rbtree_t._empty_tail);

