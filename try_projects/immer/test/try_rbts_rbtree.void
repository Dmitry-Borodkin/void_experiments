{
    nt = tree.push_back(7);

    nt = nt.push_back(8);
    nt = nt.push_back(9);
    nt = nt.push_back(10);

    printf("size: %zu\n", (&nt: *const my.rbtree_t.impl_t)->size);

    v0 = nt.get(0);  printf("v0: %d\n", v0);
    v1 = nt.get(1);  printf("v1: %d\n", v1);
    v2 = nt.get(2);  printf("v2: %d\n", v2);
    v3 = nt.get(3);  printf("v3: %d\n", v3);


}


tree_: &my.rbtree_t := {};


{   tr: &my.rbtree_t := {};

    for (i: &int := 0; i < 100000; ++i)
    {
        tr := tr.push_back(i);
    }

    for (i: &int := 0; i < 100000; i += 999)
    {
        v = tr.get(i);  printf("tr[%d]: %d\n", i, v);
    }





}




























