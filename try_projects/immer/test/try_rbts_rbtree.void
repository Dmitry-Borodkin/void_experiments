my_type = long;
//my_type = char;


namespace my
{
    using namespace immer.detail.rbts;

    policy = default_memory_policy;

    BL = derive_bits_leaf(my_type, policy, 5);

    rbtree_t = rbtree(my_type, policy, 5, BL);


}   //- namespace my


//---------------------------------------------------------------------
tree: &my.rbtree_t := {};



//{ voidc_verify_jit_module_optimized(true); }
//{ v_debug_print_module(2); }
//---------------------------------------------------------------------
{
    printf("BL: %d\n", my.BL);

    printf("max_size: %zu\n", my.rbtree_t.max_size);

    printf("tree: %p\n", &tree);

    tree1: &my.rbtree_t := {};

    printf("tree1: %p\n", &tree1);

    tree2: &my.rbtree_t := {};

    printf("tree2: %p\n", &tree2);


}


//{ voidc_verify_jit_module_optimized(true); }
//{ v_debug_print_module(2); }
//---------------------------------------------------------------------
{
    nt = tree.push_back(7);

    nt = nt.push_back(8);
    nt = nt.push_back(9);
    nt = nt.push_back(10);

    printf("size: %zu\n", (&nt: *const my.rbtree_t.impl_t)->size);

    v0 = nt.get(0);  printf("v0: %d\n", v0);
    v1 = nt.get(1);  printf("v1: %d\n", v1);
    v2 = nt.get(2);  printf("v2: %d\n", v2);
    v3 = nt.get(3);  printf("v3: %d\n", v3);


}


tree_: &my.rbtree_t := {};


{   tr: &my.rbtree_t := {};

    sz = 1000000;

    for (i: &int := 0; i < sz; ++i)
    {
        tr := tr.push_back(i);
    }

    {   tmp: &my.rbtree_t := tr;

        tr := tree;         //- Empty...

        for (i: &int := 0; i < sz; ++i)
        {
            tr := tr.push_back(tmp.get(sz-1-i));
        }
    }

    for (i: &int := 0; i < sz; i += sz/100-1)
    {
        v = tr.get(i);  printf("tr[%d]: %ld\n", i, v);
    }

}


//---------------------------------------------------------------------
namespace qwe
{
    using namespace .immer.detail;

    #define rbtree: [](T:  v_static_type_t,
                       MP: v_static_namespace_t = default_memory_policy,
                       B:  rbts.bits_t          = 5,
                       BL: rbts.bits_t          = rbts.derive_bits_leaf(T, MP, B)
                       ) ~> v_static_type_t
      =  rbts.rbtree(T, MP, B, BL);
}

using qwe.rbtree;


tstr: &rbtree(v_string_t) := {};


{   ts: &rbtree(v_string_t) := {};

    ts := ts.push_back("Превед");
    ts := ts.push_back("медвед");
    ts := ts.push_back("Кагдила?");

    s0 = ts.get(0);  printf("s0: %s\n", s0.data);
    s1 = ts.get(1);  printf("s1: %s\n", s1.data);
    s2 = ts.get(2);  printf("s2: %s\n", s2.data);

}

{   tq: &rbtree(v_string_t) := {};

    Q = v_quark_from_string("ЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫЫ");

    for (i: &int := 1; i < Q; ++i)
    {
        tq := tq.push_back(v_quark_to_string(i));
    }

    for (i: &int := 1; i < Q; ++i)
    {
        printf("q[%d]: %s\n", i, tq.get(i-1).data);
    }

}


//---------------------------------------------------------------------
{   t0: &rbtree(int) := {};
    t1: &rbtree(int) := {};

    N = 1000000;

    for (i: &int := 0; i < N; ++i)
    {
        t0 := t0.push_back(i);
        t1 := t1.push_back(i);
    }

    printf("ok: %d\n", (t0.equals(t1) : int));

    for (i: &int := 0; i < N; ++i)
    {
        t1.get_mut(i) := t0.get(N-1-i);
    }

    printf("nok: %d\n", (t0.equals(t1) : int));

    t2: &rbtree(int) := {};

    for (i: &int := 0; i < N; ++i)
    {
        t2.push_back_mut(t1.get(N-1-i));
    }

    printf("ok: %d\n", (t0.equals(t2) : int));


}

//---------------------------------------------------------------------
{   ts: &rbtree(v_string_t) := {};

    ts.push_back_mut("a");
    ts.push_back_mut("b");
    ts.push_back_mut("c");

    for (i: &int := 0; i < 3; ++i)
    {
        ts := ts.assoc(i, ts.get(i) + "!");
    }

    for (i: &int := 0; i < 3; ++i)
    {
        printf("ts[%d]: %s\n", i, ts.get(i).data);
    }


}



