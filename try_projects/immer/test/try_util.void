    i = 4;  printf("ipow(%ld, %d): %ld\n", n, i, util.ipow(n, i));
    i = 5;  printf("ipow(%ld, %d): %ld\n", n, i, util.ipow(n, i));
    i = 6;  printf("ipow(%ld, %d): %ld\n", n, i, util.ipow(n, i));
    i = 7;  printf("ipow(%ld, %d): %ld\n", n, i, util.ipow(n, i));
