{ v_import("mainline.void"); }
{ v_enable_mainline(); }
//---------------------------------------------------------------------
{
    v_import("cstdio.void");

    v_import("../detail/util.void");
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


{ v_debug_print_module(2); }
//---------------------------------------------------------------------
#define some: (j: int)
{'stmt_list'

    #define inst_foo: ()
    {'unit_defn_list'

      namespace my
      {
        linkonce_odr
        foo: (i: int) ~> void
        {
            printf("foo: %d\n", i);
        }
      }

    'unit_defn_list'}

    v_execute_outer(inst_foo);


    my.foo(j + 7);


'stmt_list'}


bar: (k: int) ~> void
{
    some(k);
    some(k+1);
}

//---------------------------------------------------------------------
{
    bar(5);

    some(3);

}


//---------------------------------------------------------------------
//{ voidc_verify_jit_module_optimized(true); }
//{ v_debug_print_module(2); }

baz: () ~> void
{
    using namespace .immer.detail;

    a: &int[] := { 7, 7, 8 };

    f1 = util.equal(a+0, a+1);

    printf("f1: %d\n", (f1: int));

    f2 = util.equal(a+0, a+1, 2);

    printf("f2: %d\n", (f2: int));
}

{
    baz();
}


//---------------------------------------------------------------------
//{ voidc_verify_jit_module_optimized(true); }
//{ v_debug_print_module(2); }
{
    a: &int := 42;

    v = { r: int = a; r };

    printf("v: %d\n", v);

}


//---------------------------------------------------------------------
{
    using namespace .immer.detail;

    for (i: &int := 0; i < 10; ++i)
    {
        m = util.min(i, 5);

        printf("m: %d\n", m);
    }

}

//---------------------------------------------------------------------
test_t = v_generic(test_type);

#do (v_set_implementation_type(test_t, int))

#do (v_make_trivial_coercion(v_coe_projective,  test_t,  int),
     v_make_trivial_coercion(v_coe_projective, *test_t, *int),
     v_make_trivial_coercion(v_coe_projective, &test_t, &int),
     )

{   v: &test_t := (77: test_t);

    u: &int = v;    u += 11;

    printf("v: %d\n", v);
}


//---------------------------------------------------------------------
{
    #define (_.ident): (t: v_static_type_t)  =  v_type_name(t);

    printf("t: %s\n", v_ast_expr_t.ident);


}


