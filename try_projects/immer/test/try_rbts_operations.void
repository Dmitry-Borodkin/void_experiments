namespace my
{
    using namespace immer.detail.rbts;

    #do (instantiate_default_memory_policy())

    policy = default_memory_policy;

    BL = derive_bits_leaf(my_type, policy, 5);

    #do (instantiate_node(my_type, policy, 5, BL))


    node_t = node(my_type, policy, 5, BL);


    #do (instantiate_get_visitor(my_type))

    visitor = get_visitor(my_type);


    using namespace position(node_t);

    #do (instantiate_leaf_pos(node_t))

    #do (leaf_pos.instantiate_visit(visitor, size_t, &const my_type))




//---------------------------------------------------------------------
}   //- namespace my


{ voidc_verify_jit_module_optimized(true); }
{ v_debug_print_module(2); }


some: (node: *my.node_t) ~> &const my_type  =
{
    pos = my.make_leaf_pos(node, 10);

    ns = my.position_args(my.leaf_pos, my.visitor, size_t, &const my_type);
    ns.visit(pos, 8)
};











