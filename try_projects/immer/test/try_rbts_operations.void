my_type = v_string_t;
//my_type = int;
//my_type = char;


namespace my
{
    using namespace immer.detail.rbts;

    policy = default_memory_policy;

    BL = derive_bits_leaf(my_type, policy, 5);

    node_t = node(my_type, policy, 5, BL);

    using namespace position(node_t);


    get_vis = get_visitor(my_type);


//  upd_vis = update_visitor(node_t);


}   //- namespace my


//---------------------------------------------------------------------
{ printf("BL: %d\n", my.BL); }


//{ voidc_verify_jit_module_optimized(true); }
//{ v_debug_print_module(2); }


N = my.BL;      //- Sic!


some: (node: *my.node_t, n: unsigned) ~> &const my_type  =
{
    pos = my.make_leaf_pos(node, N);

    pos.visit(my.get_vis, n)
};

