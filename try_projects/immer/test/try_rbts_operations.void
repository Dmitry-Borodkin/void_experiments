{   node = my.node_t.make_leaf_n(N);

    my.util.conditional_initialize(node->leaf, N);

    i = 1;

    #if (my_type.is_integer)

      node->leaf[i] := 77;

    #endif

    #if (my_type == v_string_t)

      node->leaf[i] := "aaa";

    #endif

    v = some(node, i);

    #if (my_type.is_integer)

      printf("v: %d\n", (v: int));

    #endif

    #if (my_type == v_string_t)

      printf("v: %s\n", v.data);

    #endif

//    node2 = some2(node, i, foo);
//
