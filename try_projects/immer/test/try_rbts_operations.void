#define hzns: (i: int) ~> v_static_namespace_t  =  v_generic_ns(hz_ns, N(i));

bar: (i: int) ~> int
{
    hzns(5).qwerty: (int) ~> int;

    return hzns(5).qwerty(i);
}

namespace hzns(5)
{
    qwerty: (i: int) ~> int  =  i + 1;
}


{
    printf("%d\n", bar(7));
}




