{ voidc_import("libvoidc.void"); }
{ voidc_make_header("iterator_facade"); }
//---------------------------------------------------------------------
{
    v_export_import("util.void");
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
//- <immer/detail/iterator_facade.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {


//---------------------------------------------------------------------
#template instantiate_iterator_facade: [](IteratorT:       v_static_type_t,
                                          AccessNS:        v_static_namespace_t,
                                          T:               v_static_type_t,
                                          ReferenceT:      v_static_type_t = &T,
                                          DifferenceTypeT: v_static_type_t = intptr_t,
                                          PointerT:        v_static_type_t = *T)
{
    using namespace .immer.detail;

    _iterator = IteratorT;

    private access = AccessNS;

    value_type      = T;
    difference_type = DifferenceTypeT;
    pointer         = PointerT;
    reference       = ReferenceT;

    alwaysinline
    (*_): (self: _iterator) ~> reference  =  access.dereference(self);

    alwaysinline
    (_->): (self: _iterator) ~> pointer  =  &access.dereference(self);

    alwaysinline
    (_[]): (self: _iterator, n: difference_type) ~> reference;

    alwaysinline
    (_==_): (a: &const _iterator, b: &const _iterator) ~> bool
      =  access.equal(a, b);

    alwaysinline
    (_!=_): (a: &const _iterator, b: &const _iterator) ~> bool
      =  !access.equal(a, b);

    inlinehint
    (++_): (self: &_iterator) ~> &_iterator  =
    {
        access.increment(self);
        self
    };

    inlinehint
    (_++): (self: &_iterator) ~> _iterator  =
    {
        tmp: _iterator = self;
        access.increment(self);
        tmp
    };

    inlinehint
    (--_): (self: &_iterator) ~> &_iterator  =
    {
        access.decrement(self);
        self
    };

    inlinehint
    (_--): (self: &_iterator) ~> _iterator  =
    {
        tmp: _iterator = self;
        access.decrement(self);
        tmp
    };

    inlinehint
    (_+=_): (self: &_iterator, n: difference_type) ~> &_iterator  =
    {
        access.advance(self, n);
        self
    };

    inlinehint
    (_-=_): (self: &_iterator, n: difference_type) ~> &_iterator  =
    {
        access.advance(self, -n);
        self
    };

    inlinehint
    (_+_): (self: _iterator, n: difference_type) ~> _iterator  =
    {
        tmp: &_iterator := self;
        tmp += n
    };

    alwaysinline
    (_+__): (n: difference_type, self: _iterator) ~> _iterator  =  self + n;

    alwaysinline
    (_[]): (self: _iterator, n: difference_type) ~> reference  =  *(self + n);

    inlinehint
    _minus_number: (a: _iterator, n: difference_type) ~> _iterator  =
    {
        tmp: &_iterator := a;
        tmp -= n
    };

    inlinehint
    _minus_iterator: (a: _iterator, b: _iterator) ~> difference_type
      =  access.distance_to(b, a);

    #define (_-_): [](a: _iterator, b)  =
    (
        #if (util.unref_typeof(b) == _iterator)  _minus_iterator(a, b)
        #else                                    _minus_number(a, b)
        #endif
    );

    inlinehint
    (_<_): (a: &const _iterator, b: &const _iterator) ~> bool
      =  access.distance_to(a, b) > 0;

    inlinehint
    (_<=_): (a: &const _iterator, b: &const _iterator) ~> bool
      =  access.distance_to(a, b) >= 0;

    inlinehint
    (_>_): (a: &const _iterator, b: &const _iterator) ~> bool
      =  access.distance_to(a, b) < 0;

    inlinehint
    (_>=_): (a: &const _iterator, b: &const _iterator) ~> bool
      =  access.distance_to(a, b) <= 0;

}   //- #template


//---------------------------------------------------------------------
}   //- namespace detail
}   //- namespace .immer

