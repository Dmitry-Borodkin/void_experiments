namespace util
{

//---------------------------------------------------------------------
#define unref_typeof: [](x) ~> v_static_type_t  =
{
    t = typeof(x);  #if (t.is_reference)  t = t.element_type;  #endif

    t
};

//---------------------------------------------------------------------
#define if_: [](c, x, y, T: v_static_type_t = unref_typeof(x))  =
{
    r: &T := undef;

    if (c)  r := x;
    else    r := y;

    (r: T)
};

#define min: [](x, y, T: v_static_type_t = unref_typeof(x))  =  if_(x < y, x, y, T);
#define max: [](x, y, T: v_static_type_t = unref_typeof(x))  =  if_(x > y, x, y, T);


//---------------------------------------------------------------------
#define equal: [](i1, i2, n: size_t = 1) ~> bool  =
{
    Iter1 = unref_typeof(i1);
    Iter2 = unref_typeof(i2);

    ns = v_generic_ns(equal_args, T[Iter1, Iter2]);

    #template [ns, Iter1, Iter2]()
    {
        inlinehint
        _equal: (i1: Iter1, i2: Iter2, n: size_t) ~> bool
        {
            e1 = i1 + n;
            i1: &Iter1 := i1;
            i2: &Iter2 := i2;

            for (; i1 < e1; ++i1, ++i2)
            {
                if (!(*i1 == *i2))  return  false;
            }

            return  true;
        }
    }

    ns._equal(i1, i2, n)
};



//---------------------------------------------------------------------
#define conditional_initialize: [](p, n: size_t = 1)
{'stmt'

    {   T = unref_typeof(p).element_type;

        #if (T.is_special(v_initialize))  v_initialize(p, n);   #endif
    }

'stmt'}

#define conditional_terminate: [](p, n: size_t = 1)
{'stmt'

    {   T = unref_typeof(p).element_type;

        #if (T.is_special(v_terminate))  v_terminate(p, n);   #endif
    }

'stmt'}

//---------------------------------------------------------------------
#define conditional_copy: [](d, s, n: size_t = 1)
{'stmt'

    {   T = unref_typeof(d).element_type;

        #if (T.is_special(v_copy))

            v_assert(d+n <= s  ||  s+n <= d);

            v_copy(d, s, n);

        #else

            memmove(d, s, n*sizeof(T));

        #endif
    }

'stmt'}

#define conditional_move: [](d, s, n: size_t = 1)
{'stmt'

    {   T = unref_typeof(d).element_type;

        #if (T.is_special(v_move))

            v_assert(d+n <= s  ||  s+n <= d);

            v_move(d, s, n);

        #else

            memmove(d, s, n*sizeof(T));

        #endif
    }

'stmt'}

//---------------------------------------------------------------------
#define uninitialized_copy: [](d, s, n: size_t = 1)
{'stmt_list'

    conditional_initialize(d, n);
    conditional_copy(d, s, n);

'stmt_list'}

#define uninitialized_move: [](d, s, n: size_t = 1)
{'stmt_list'

    conditional_initialize(d, n);
    conditional_move(d, s, n);

'stmt_list'}


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
#define move_in_place: [](p, s: intptr_t, n: size_t) ~> void  =
{
    T = unref_typeof(p).element_type;

    ns = v_generic_ns(move_in_place_args, T(T));

    #template [ns, T]()
    {
        inlinehint
        _move_in_place: (p: *T, s: intptr_t, n: size_t) ~> void
        {
            if (n == 0)  return;    //- Nothing to do...
            if (s == 0)  return;    //- ...

            n: &size_t := n;

            if (s > 0)              //- Move from right to left (forward)
            {
                s = (s: size_t);

                p: &*T := p;

                loop
                {
                    m = min(s, n);

                    conditional_move(p, p+s, m);

                    if (m == n)
                    {
                        conditional_terminate(p+s, m);

                        break;
                    }

                    p += m;
                    n -= m;
                }
            }
            else                    //- Move from left to right (backward)
            {
                s = (-s : size_t);

                p: &*T := p + n;

                loop
                {
                    m = min(s, n);

                    p -= m;

                    conditional_move(p, p-s, m);

                    if (m == n)
                    {
                        conditional_terminate(p-s, m);

                        break;
                    }

                    n -= m;
                }
            }
        }
    }

    ns._move_in_place(p, s, n)
};


//---------------------------------------------------------------------
#define ipow: [](num, pow: unsigned) ~> typeof(num)  =
{
    #if   (pow == 0)  ret = 1;
    #elif (pow == 1)  ret = num;
    #else

        r2 = ipow(num, pow/2);

        ret = r2 * r2;

        #if (pow & 1)  ret = ret * num;  #endif

    #endif

    ret
};


