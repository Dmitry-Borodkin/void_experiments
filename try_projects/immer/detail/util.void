//- ...
//---------------------------------------------------------------------
v_internal_immer_detail_util_effort: (*void) ~> void
{
//printf("v_internal_immer_detail_util_enable: start\n");
//defer printf("v_internal_immer_detail_util_enable: stop\n");

    v_add_intrinsic("v_namespace_get_name", namespace_get_name_intrinsic, 0);
    v_add_intrinsic("v_static_log2",        static_log2_intrinsic,        0);
    v_add_intrinsic("v_guard_ns",           guard_ns_intrinsic,           0);

//    ctx = new my_util_ctx_t;
//
//    v_add_local_cleaner(my_util_ctx_cleaner, ctx);
//
//    ctx->push.fun := v_get_push_variables_hook(&ctx->push.aux);
//    ctx->pop.fun  := v_get_pop_variables_hook (&ctx->pop.aux);
//
//    v_set_push_variables_hook(my_push_variables, ctx);
//    v_set_pop_variables_hook (my_pop_variables,  ctx);
//
//    v_add_intrinsic("v_register_inst", register_inst_intrinsic, ctx);

    v_add_intrinsic("v_execute_inst", execute_inst_intrinsic, 0);
}

