{ voidc_import("libvoidc.void"); }
{ voidc_make_header("util"); }
//---------------------------------------------------------------------
{
    v_import("llvm-c/Core.void");

    v_export_import("type_traits.void");
    v_export_import("cstring.void");

    v_export_import("cstdio.void");
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
{   gctx = v_target_get_global_ctx();
    vctx = v_target_get_voidc_global_ctx();

    v_target_set_global_ctx(vctx);      //- Sic!

    v_add_symbol("cur_gctx", v_target_global_ctx_t, gctx);

    q_ref = v_reference_type(v_quark_t, 0);

    q = v_quark_ptr_from_string;

    v_add_symbol("true_q", q_ref, q("true"));

    v_add_symbol("unit_val_defn_q", q_ref, q("unit_val_defn"));

    v_add_symbol("unit_namespace_open_q", q_ref, q("unit_namespace_open"));
    v_add_symbol("unit_defn_close_q",     q_ref, q("unit_defn_close"));

    v_add_symbol("q_current_namespace_list", q_ref, q("v.current_namespace_list"));

    v_add_symbol("q_internal_namespace_guard", q_ref, q("v.internal.namespace_guard"));
}

//=====================================================================
{ voidc_unit_begin_module("utility_module"); }

//---------------------------------------------------------------------
private
namespace_get_name_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);        //- namespace

    v_push_result();

    v_set_result_type(v_find_type("v_static_namespace_t"));

    v_ast_accept_visitor(arg0, vis);

    ns = (v_get_result_value() : *v_namespace_t);

    expr: &v_ast_expr_t := {};

    v_ast_make_expr_string(&expr, v_quark_to_string(ns->name));

    v_pop_result();

    v_ast_accept_visitor(&expr, vis);
}

//---------------------------------------------------------------------
private
static_log2_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);        //- number

    v_push_result();

    v_ast_accept_visitor(arg0, vis);

    v = v_get_result_value();

    n = LLVMConstIntGetZExtValue(v);

    .log2: (float(64)) ~> float(64);

    r = (.log2(n) : unsigned);

    t = v_uint_type(32);

    v = LLVMConstInt(v_type_get_llvm_type(t), r, 0);

    v_pop_result();

    v_adopt_result(t, v);
}

//---------------------------------------------------------------------
private
guard_ns_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    v_push_result();

    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    n = v_list_get_size(args);

    if (n)      //- Got custom namespace...
    {
        arg0 = v_list_get_item(args, 0);

        qualif: &v_ast_expr_t := {};

        v_ast_make_expr_integer(&qualif, 0);

        list: &v_ast_generic_list_t := {};

        v_make_list(&list, unit_namespace_open_q, &qualif);

        v_list_append(&list, &list, arg0);

        //- Open custom namespace

        v_ast_accept_visitor(&list, vis);
    }

    lst = v_std_any_get_pointer(v_util_list_t, v_get_property_q(q_current_namespace_list));

    s = v_list_get_size(lst);
    v_assert(s);

    r = v_list_get_item(lst, s-1);

    cur_ns = (v_std_any_get_value(intptr_t, r) : *v_namespace_t);

    ret = v_map_find(&cur_ns->map, (q_internal_namespace_guard: intptr_t)) == 0;

    if (ret)    //- Not found!
    {
        //- Define guard constant...

        v_add_constant_q(q_internal_namespace_guard, v_void_type(), 0);
    }

    if (n)      //- Got custom namespace...
    {
        list: &v_ast_generic_list_t := {};

        v_make_list_nil(&list, unit_defn_close_q);

        //- Close custom namespace

        v_ast_accept_visitor(&list, vis);
    }

    v_pop_result();

    bool_ = v_uint_type(1);

    v_adopt_result(bool_, LLVMConstInt(v_type_get_llvm_type(bool_), ret, 0));
}


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
private
my_obtain_module: (void_mod: *void) ~> LLVMModuleRef
{
    mod = (void_mod: LLVMModuleRef);

    v_assert(mod);

    return  mod;
}

//---------------------------------------------------------------------
private
execute_outer_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
//printf("execute_outer_intrinsic: start\n");
//defer printf("execute_outer_intrinsic: stop\n");

    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);        //- Macro

    v_reset_result();

    v_ast_accept_visitor(arg0, vis);

    v_assert(v_get_result_type() == v_find_type("v_object_intrinsic_t"));

    q = (v_get_result_value() : v_quark_t);

    ptr: &*const v_macro_definition_t := 0;

    fun = voidc_get_macro_definition(q, &ptr);

    v_assert(fun && ptr);

    expr: &v_ast_expr_t      := {};
    list: &v_ast_expr_list_t := {};

    v_make_list_nil(&list);

    {   n = v_list_get_size(args);

        for (i: &int := 1; i < n; ++i)      //- Arguments
        {
            v_reset_result();

            v_ast_accept_visitor(v_list_get_item(args, i), vis);

            t = v_get_result_type();
            v = v_get_result_value();

            v_ast_make_expr_compiled(&expr, t, v);

            v_list_append(&list, &list, &expr);
        }
    }

    v_ast_make_expr_identifier(&expr, "dummy");

    v_ast_make_expr_call(&expr, &expr, &list);

    //----------------------
    v_hide_variables();
    //----------------------

    saved_obtain_module_ctx: &*void := undef;
    saved_obtain_module_fun: &*((*void) ~> LLVMModuleRef) := undef;

    saved_module = v_get_module();

    if (saved_module)
    {
        saved_obtain_module_fun := v_get_obtain_module_hook(&saved_obtain_module_ctx);

        v_set_obtain_module_hook(my_obtain_module, saved_module);
    }

    v_set_module(0);        //- Sic!

    //----------------------
    fun(ptr, vis, &expr);
    //----------------------

    v_set_module(saved_module);

    if (saved_module)
    {
        v_set_obtain_module_hook(saved_obtain_module_fun, saved_obtain_module_ctx);
    }

    //----------------------
    v_show_variables();
    //----------------------
}


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
v_internal_immer_detail_util_effort: (*void) ~> void
{
//printf("v_internal_immer_detail_util_enable: start\n");
//defer printf("v_internal_immer_detail_util_enable: stop\n");

    v_add_intrinsic("v_namespace_get_name", namespace_get_name_intrinsic, 0);
    v_add_intrinsic("v_static_log2",        static_log2_intrinsic,        0);
    v_add_intrinsic("v_guard_ns",           guard_ns_intrinsic,           0);

    v_add_intrinsic("v_execute_outer", execute_outer_intrinsic, 0);
}

//---------------------------------------------------------------------
{   if (v_find_symbol_value("v_internal_immer_detail_util_enable"))
    {
        voidc_skip_object_file_load(1);
    }
}

//=====================================================================
{ voidc_unit_end_module(); }

//---------------------------------------------------------------------
{   v_target_set_global_ctx(cur_gctx);

    v_export_effort(v_internal_immer_detail_util_effort, 0);
}


//---------------------------------------------------------------------
//- <immer/detail/util.hpp>     ?
//---------------------------------------------------------------------
namespace .immer {
namespace detail {


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
#define _instantiate_equal: [](NS: v_static_namespace_t, Iter1: v_static_type_t, Iter2: v_static_type_t)
{'unit_defn_list'

    inlinehint
    NS.equal_impl: (i1: Iter1, i2: Iter2, n: size_t) ~> bool
    {
        e1 = i1 + n;
        i1: &Iter1 := i1;
        i2: &Iter2 := i2;

        for (; i1 < e1; ++i1, ++i2)
        {
            if (!(*i1 == *i2))  return  false;
        }

        return  true;
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
namespace util
{

//---------------------------------------------------------------------
#define equal: [](i1, i2, n: size_t = 1) ~> bool  =
{
    Iter1 = typeof(i1);
    Iter2 = typeof(i2);

    ns = v_generic_ns(equal_args, T[Iter1, Iter2]);

    #if (!v_defined(ns, equal_impl))

        v_execute_outer(_instantiate_equal, ns, Iter1, Iter2);

    #endif

    ns.equal_impl(i1, i2, n)
};


//---------------------------------------------------------------------
#define conditional_initialize: [](p, n: size_t = 1)
{'stmt'

    {   T = typeof(p).element_type;

        #if (T.is_special(v_initialize))  v_initialize(p, n);   #endif
    }

'stmt'}

#define conditional_terminate: [](p, n: size_t = 1)
{'stmt'

    {   T = typeof(p).element_type;

        #if (T.is_special(v_terminate))  v_terminate(p, n);   #endif
    }

'stmt'}

//---------------------------------------------------------------------
#define conditional_copy: [](d, s, n: size_t = 1)
{'stmt'

    {   T = typeof(d).element_type;

        #if (T.is_special(v_copy))  v_copy(d, s, n);
        #else                       memmove(d, s, n*sizeof(T));
        #endif
    }

'stmt'}

#define conditional_move: [](d, s, n: size_t = 1)
{'stmt'

    {   T = typeof(d).element_type;

        #if (T.is_special(v_move))  v_move(d, s, n);
        #else                       memmove(d, s, n*sizeof(T));
        #endif
    }

'stmt'}

//---------------------------------------------------------------------
#define uninitialized_copy: [](d, s, n: size_t = 1)
{'stmt_list'

    conditional_initialize(d, n);
    conditional_copy(d, s, n);

'stmt_list'}

#define uninitialized_move: [](d, s, n: size_t = 1)
{'stmt_list'

    conditional_initialize(d, n);
    conditional_move(d, s, n);

'stmt_list'}


//---------------------------------------------------------------------
}   //- namespace util


//---------------------------------------------------------------------
}   //- namespace detail
}   //- namespace .immer

