    v_export_effort(v_internal_immer_detail_util_effort, 0);
}


//---------------------------------------------------------------------
//- <immer/detail/util.hpp>     ?
//---------------------------------------------------------------------
namespace .immer {
namespace detail {


//---------------------------------------------------------------------
#define util2: [](T1: v_static_type_t, T2: v_static_type_t) ~> v_static_namespace_t
  =  v_generic_ns(util2_ns, T[T1,T2]);

#define instantiate_equal: [](Iter1: v_static_type_t, Iter2: v_static_type_t)
{'unit_defn_list'

    namespace util2(Iter1, Iter2)
    {
      #if (v_guard_ns(guard_equal))

        inlinehint
        equal: (i1: Iter1, i2: Iter2, n: size_t) ~> bool
        {
            e1 = i1 + n;
            i1: &Iter1 := i1;
            i2: &Iter2 := i2;

            for (; i1 < e1; ++i1, ++i2)
            {
                if (!(*i1 == *i2))  return  false;
            }

            return  true;
        }

      #endif
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
namespace util
{

//---------------------------------------------------------------------
#define equal: [](i1, i2, n: size_t = 1) ~> bool  =
{
    IT1 = typeof(i1);
    IT2 = typeof(i2);

    ns = util2(IT1, IT2);

    #if (!v_defined(ns, equal))

        #define instantiate: [*, IT1, IT2]()
        {'unit_defn_list'

            #do (instantiate_equal(IT1, IT2))

        'unit_defn_list'}

        v_execute_inst(instantiate);

    #endif

    ns.equal(i1, i2, n)
};


//---------------------------------------------------------------------
#define conditional_initialize: [](p, n: size_t = 1)
{'stmt'

    {   T = typeof(p).element_type;

        #if (T.is_special(v_initialize))  v_initialize(p, n);   #endif
    }

'stmt'}

#define conditional_terminate: [](p, n: size_t = 1)
{'stmt'

    {   T = typeof(p).element_type;

        #if (T.is_special(v_terminate))  v_terminate(p, n);   #endif
    }

'stmt'}

//---------------------------------------------------------------------
#define conditional_copy: [](d, s, n: size_t = 1)
{'stmt'

    {   T = typeof(d).element_type;

        #if (T.is_special(v_copy))  v_copy(d, s, n);
        #else                       memmove(d, s, n*sizeof(T));
        #endif
    }

'stmt'}

#define conditional_move: [](d, s, n: size_t = 1)
{'stmt'

    {   T = typeof(d).element_type;

        #if (T.is_special(v_move))  v_move(d, s, n);
        #else                       memmove(d, s, n*sizeof(T));
        #endif
    }

'stmt'}

//---------------------------------------------------------------------
#define uninitialized_copy: [](d, s, n: size_t = 1)
{'stmt_list'

    conditional_initialize(d, n);
    conditional_copy(d, s, n);

'stmt_list'}

#define uninitialized_move: [](d, s, n: size_t = 1)
{'stmt_list'

    conditional_initialize(d, n);
    conditional_move(d, s, n);

'stmt_list'}


//---------------------------------------------------------------------
}   //- namespace util


//---------------------------------------------------------------------
}   //- namespace detail
}   //- namespace .immer

