//- ...
//---------------------------------------------------------------------
private
print_llvm_value_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);

    v_push_result();

    v_ast_accept_visitor(arg0, vis);

    v = v_get_result_value();

    str = LLVMPrintValueToString(v);

    printf("%s\n", str);

    LLVMDisposeMessage(str);

    v_pop_result();
}

//---------------------------------------------------------------------
private
print_type_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);

    v_push_result();

    v_set_result_type(v_find_type("v_static_type_t"));

    v_ast_accept_visitor(arg0, vis);

    t = (v_get_result_value() : *v_type_t);

    sstr: &v_std_string_t := {};

    voidc_internal_std_string_append_type(&sstr, t);

    printf("%s\n", v_std_string_get(&sstr));

    v_pop_result();
}

//---------------------------------------------------------------------
private
type_name_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);

    v_push_result();

    v_set_result_type(v_find_type("v_static_type_t"));

    v_ast_accept_visitor(arg0, vis);

    t = (v_get_result_value() : *v_type_t);

    sstr: &v_std_string_t := {};

    voidc_internal_std_string_append_type(&sstr, t);

    expr: &v_ast_expr_t := {};

    v_ast_make_expr_string(&expr, v_std_string_get(&sstr));

    v_pop_result();

    v_ast_accept_visitor(&expr, vis);
}


//---------------------------------------------------------------------
private
check_builder_intrinsic: (*void, vis: *voidc_visitor_t, *v_ast_base_t) ~> void
{
    if (LLVMGetInsertBlock(v_target_get_builder()))
    {
        printf("check builder: dirty\n");
    }
    else
    {
        printf("check builder: clean\n");
    }
}





//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
private
make_trivial_coercion_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);        //- Kind
    arg1 = v_list_get_item(args, 1);        //- Type from
    arg2 = v_list_get_item(args, 2);        //- Type to

    v_reset_result();           //- Sic!

    v_ast_accept_visitor(arg0, vis);        //- Kind

    kind_v = v_get_result_value();

    kind = (LLVMConstIntGetZExtValue(kind_v) : int);

    static_type_t = v_find_type("v_static_type_t");

    v_reset_result();

    v_set_result_type(static_type_t);

    v_ast_accept_visitor(arg1, vis);        //- Type from

    t0 = (v_get_result_value() : *v_type_t);

    v_reset_result();

    v_set_result_type(static_type_t);

    v_ast_accept_visitor(arg2, vis);        //- Type to

    t1 = (v_get_result_value() : *v_type_t);

    sstr: &v_std_string_t := {};

    v_std_string_set(&sstr, "immer.trivial_coercion_to.");

    voidc_internal_std_string_append_type(&sstr, t0);

    q0 = v_quark_from_string(v_std_string_get(&sstr));

    v_add_intrinsic_q(q0, voidc_trivial_coercion_intrinsic, t0);        //- cast

    v_std_string_set(&sstr, "immer.trivial_coercion_to.");

    voidc_internal_std_string_append_type(&sstr, t1);

    q1 = v_quark_from_string(v_std_string_get(&sstr));

    v_add_intrinsic_q(q1, voidc_trivial_coercion_intrinsic, t1);        //- convert

    v_add_coercion(kind, q1, q0, t0, t1);
}


