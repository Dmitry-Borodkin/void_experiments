{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
//- <immer/detail/rbts/operations.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {
namespace rbts {


//---------------------------------------------------------------------
//- array_for_visitor
//---------------------------------------------------------------------
#define array_for_visitor: [](T: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(array_for_visitor_tag, T(T));

    #template [vis, T]()
    {
        using namespace visitor_base(vis);

        result_t = *T;

        #define visit_inner: [](pos, idx: size_t) ~> result_t  =  pos.descend(vis, idx);
        #define visit_leaf:  [](pos, idx: size_t) ~> result_t  =  pos.node->leaf;
    }

    vis
};


//---------------------------------------------------------------------
//- region_for_visitor
//---------------------------------------------------------------------
#define region_for_visitor: [](T: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(region_for_visitor_tag, T(T));

    #template [vis, T]()
    {
        using namespace visitor_base(vis);

        result_t = struct { *T; size_t; size_t; };

        #define visit_inner: [](pos, idx: size_t) ~> result_t  =  pos.towards(vis, idx);
        #define visit_leaf:  [](pos, idx: size_t) ~> result_t  =  {pos.node->leaf, pos.index(idx), pos.count};
    }

    vis
};


//---------------------------------------------------------------------
//- get_visitor
//---------------------------------------------------------------------
#define get_visitor: [](T: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(get_visitor_tag, T(T));

    #template [vis, T]()
    {
        using namespace visitor_base(vis);

        result_t = &const T;

        #define visit_inner: [](pos, idx: size_t) ~> result_t  =  pos.descend(vis, idx);
        #define visit_leaf:  [](pos, idx: size_t) ~> result_t  =  pos.node->leaf[pos.index(idx)];
    }

    vis
};


//---------------------------------------------------------------------
//- for_each_chunk_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_visitor
{
    vis = for_each_chunk_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_inner: [](pos, fn) ~> void  =  pos.each(vis, fn);
    #define visit_leaf:  [](pos, fn) ~> void  =  { data = pos.node->leaf;  fn(data, data + pos.count) };
}


//---------------------------------------------------------------------
//- for_each_chunk_p_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_visitor
{
    vis = for_each_chunk_p_visitor;

    using namespace visitor_base(vis);

    result_t = bool;

    #define visit_inner: [](pos, fn) ~> bool  =  pos.each_pred(vis, fn);
    #define visit_leaf:  [](pos, fn) ~> bool  =  { data = pos.node->leaf;  fn(data, data + pos.count) };
}


//---------------------------------------------------------------------
//- for_each_chunk_left_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_left_visitor
{
    vis = for_each_chunk_left_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_inner: [](pos, args) ~> void  =
    {
        last = args[0];
        fn   = args[1];

        l = pos.index(last);
        pos.each_left(for_each_chunk_visitor, l, fn);
        pos.towards_oh(vis, last, l, fn)
    };

    #define visit_leaf: [](pos, args) ~> void  =
    {
        last = args[0];
        fn   = args[1];

        data = pos.node->leaf;
        l    = pos.index(last);
        fn(data, data + l + 1)
    };
}


//---------------------------------------------------------------------
//- for_each_chunk_right_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_right_visitor
{
    vis = for_each_chunk_right_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_inner: [](pos, args) ~> void  =
    {
        first = args[0];
        fn    = args[1];

        f = pos.index(first);
        pos.towards_oh(vis, first, f, fn);
        pos.each_right(for_each_chunk_visitor, f + 1, fn)
    };

    #define visit_leaf: [](pos, args) ~> void  =
    {
        first = args[0];
        fn    = args[1];

        data = pos.node->leaf;
        f    = pos.index(first);
        fn(data + f, data + pos.count)
    };
}


//---------------------------------------------------------------------
//- for_each_chunk_i_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_i_visitor
{
    vis = for_each_chunk_i_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_relaxed: [](pos, args) ~> void  =
    {
        first = args[0];
        last  = args[1];
        fn    = args[2];

        f = pos.index(first);
        l = pos.index(last - 1);

        if (f == l)
        {
            sbh = pos.size_before(f);

            pos.towards_oh_sbh(vis, first, f, sbh, last - sbh, fn);
        }
        else
        {
            v_assert(f < l);

            pos.towards_oh(for_each_chunk_right_visitor, first, f, fn);
            pos.each_i(for_each_chunk_visitor, f + 1, l, fn);
            pos.towards_oh(for_each_chunk_left_visitor, last - 1, l, fn);
        }

        undef       //- Sic!
    };

    #define visit_regular: [](pos, args) ~> void  =
    {
        first = args[0];
        last  = args[1];
        fn    = args[2];

        if (first < last)
        {
            f = pos.index(first);
            l = pos.index(last - 1);

            if (f == l)
            {
                pos.towards_oh(vis, first, f, last, fn);
            }
            else
            {
                v_assert(f < l);

                pos.towards_oh(for_each_chunk_right_visitor, first, f, fn);
                pos.each_i(for_each_chunk_visitor, f + 1, l, fn);
                pos.towards_oh(for_each_chunk_left_visitor, last - 1, l, fn);
            }
        }

        undef       //- Sic!
    };

    #define visit_leaf: [](pos, args) ~> void  =
    {
        first = args[0];
        last  = args[1];
        fn    = args[2];

        data = pos.node->leaf;

        if (first < last)
        {
            f = pos.index(first);
            l = pos.index(last - 1);
            fn(data + f, data + l + 1);
        }

        undef       //- Sic!
    };
}


//---------------------------------------------------------------------
//- for_each_chunk_p_left_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_left_visitor
{
    vis = for_each_chunk_p_left_visitor;

    using namespace visitor_base(vis);

    result_t = bool;

    #define visit_inner: [](pos, args) ~> bool  =
    {
        last = args[0];
        fn   = args[1];

        l = pos.index(last);
        pos.each_pred_left(for_each_chunk_p_visitor, l, fn)  &&
        pos.towards_oh(vis, last, l, fn)
    };

    #define visit_leaf: [](pos, args) ~> bool  =
    {
        last = args[0];
        fn   = args[1];

        data = pos.node->leaf;
        l    = pos.index(last);
        fn(data, data + l + 1)
    };
}


//---------------------------------------------------------------------
//- for_each_chunk_p_right_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_right_visitor
{
    vis = for_each_chunk_p_right_visitor;

    using namespace visitor_base(vis);

    result_t = bool;

    #define visit_inner: [](pos, args) ~> bool  =
    {
        first = args[0];
        fn    = args[1];

        f = pos.index(first);
        pos.towards_oh(vis, first, f, fn)  &&
        pos.each_pred_right(for_each_chunk_p_visitor, f + 1, fn)
    };

    #define visit_leaf: [](pos, args) ~> bool  =
    {
        first = args[0];
        fn    = args[1];

        data = pos.node->leaf;
        f    = pos.index(first);
        fn(data + f, data + pos.count)
    };
}


//---------------------------------------------------------------------
//- for_each_chunk_p_i_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_i_visitor
{
    vis = for_each_chunk_p_i_visitor;

    using namespace visitor_base(vis);

    result_t = bool;

    #define visit_relaxed: [](pos, args) ~> bool  =
    {
        first = args[0];
        last  = args[1];
        fn    = args[2];

        (block
        {
            if (first < last)
            {
                f = pos.index(first);
                l = pos.index(last - 1);

                if (f == l)
                {
                    sbh = pos.size_before(f);

                    break  pos.towards_oh_sbh(vis, first, f, sbh, last - sbh, fn);
                }
                else
                {
                    v_assert(f < l);

                    break  pos.towards_oh(for_each_chunk_p_right_visitor, first, f, fn)  &&
                           pos.each_pred_i(for_each_chunk_p_visitor, f + 1, l, fn)  &&
                           pos.towards_oh(for_each_chunk_p_left_visitor, last - 1, l, fn);
                }
            }

            break  true;
        })
    };

    #define visit_regular: [](pos, args) ~> bool  =
    {
        first = args[0];
        last  = args[1];
        fn    = args[2];

        (block
        {
            if (first < last)
            {
                f = pos.index(first);
                l = pos.index(last - 1);

                if (f == l)
                {
                    break  pos.towards_oh(vis, first, f, last, fn);
                }
                else
                {
                    v_assert(f < l);

                    break  pos.towards_oh(for_each_chunk_p_right_visitor, first, f, fn)  &&
                           pos.each_i(for_each_chunk_p_visitor, f + 1, l, fn)  &&
                           pos.towards_oh(for_each_chunk_p_left_visitor, last - 1, l, fn);
                }
            }

            break  true;
        })
    };

    #define visit_leaf: [](pos, args) ~> bool  =
    {
        first = args[0];
        last  = args[1];
        fn    = args[2];

        (block
        {
            if (first < last)
            {
                f = pos.index(first);
                l = pos.index(last - 1);
                break  fn(data + f, data + l + 1);
            }

            break  true;
        })
    };
}


//---------------------------------------------------------------------
//- equals_visitor
//---------------------------------------------------------------------
namespace equals_visitor
{
    using namespace visitor_base(equals_visitor);

    result_t = bool;

    namespace this_aux
    {
        using namespace visitor_base(this_aux);

        result_t = bool;

        #define visit_inner: [](posr, args) ~> bool  =
        {
            i     = args[0];
            posl  = args[1];
            first = args[2];
            idx   = args[3];

            posl.nth_sub(i, equals_visitor, {posr, first, idx})
        };

        #define visit_leaf: [](posr, args) ~> bool  =
        {
            i     = args[0];
            posl  = args[1];
            first = args[2];
            idx   = args[3];

            posl.nth_sub_leaf(i, equals_visitor, {posr, first, idx})
        };
    }

    namespace rrb
    {
        using namespace visitor_base(rrb);

        result_t = bool;

        #define visit_node: [](posr, args) ~> bool  =
        {
            first  = args[0];
            rootl  = args[1];
            shiftl = args[2];
            sizel  = args[3];

            v_assert(shiftl <= posr.shift);

            (block
            {
                if (shiftl == posr.shift)
                {
                    break  visit_maybe_relaxed_sub(rootl, shiftl, sizel, equals_visitor, {posr, first, (undef: size_t)});
                }
                else
                {
                    break  posr.first_sub_inner(rrb, {first, rootl, shiftl, sizel});
                }

                break  true;
            })
        };
    }

    #define equal_chunk_p: [](T: v_static_type_t, Iter: v_static_type_t = *T) ~> v_static_type_t  =
    {
        type = v_generic(equal_chunk_p, T(T, Iter));

        #template [type, T, Iter]()
        {
            #do (v_set_implementation_type(type, Iter))

            inlinehint
            (_()): (p: *type, f: *T, e: *T) ~> bool
            {
                iter = *(p: *Iter);

                if (f == &*iter)
                {
                    iter += e - f;
                    return  true;
                }

                for (f: &*T := f; f < e; ++f, ++iter)
                {
                    if (!(*f == *iter))  return  false;
                }

                return  true;
            }
        }

        type
    };

    #define visit_relaxed: [](posl, args) ~> bool  =
    {
        PosL  = typeof(posl);
        ArgsT = typeof(args);

        ns = PosL.v_generic_ns(equals_visit_relaxed, T(ArgsT));

        #template [ns, PosL, ArgsT]()
        {
            inlinehint
            _visit_relaxed: (posl: PosL, args: ArgsT) ~> bool
            {
                posr  = args[0];
                first = args[1];
                idx   = args[2];

                nl = posl.node;
                nr = posr.node;
                if (nl == nr)  return  true;

                cl = posl.count;
                cr = posr.count;
                v_assert(cr > 0);
                sbr: &size_t  := 0;
                i:   &count_t := 0;
                j:   &count_t := 0;

                for (; i < cl; ++i)
                {
                    sbl = posl.size_before(i);
                    for (; j + 1 < cr && (sbr := posr.size_before(j)) < sbl; ++j) ;

                    if (sbl == sbr)
                    {
                        if (!posr.nth_sub(j, this_aux, {posl, first, idx + sbl}))  return  false;
                    }
                    else
                    {
                        T    = typeof(posr).value_t;
                        Iter = typeof(first);

                        ecp: &Iter := first + (idx + sbl);        //- ?!?!?
                        ecp = (&ecp: *equal_chunk_p(T, Iter));

                        if (!posl.nth_sub(i, for_each_chunk_p_visitor, ecp))  return  false;
                    }
                }

                return  true;
            }
        }

        ns._visit_relaxed(posl, args)
    };

    #define visit_regular: [](posl, args) ~> bool  =
    {
        ArgsT = typeof(args);

        #if (ArgsT.is_struct)

            #if (is_relaxed(ArgsT.element_types[0]))

                visit_relaxed(posl, args)

            #else

                (block
                {
                    posr = args[0];

                    if (posl.count >= posr.count)
                    {
                        break  equals_visitor.visit_regular(posl, posr.node);
                    }
                    else
                    {
                        break  equals_visitor.visit_regular(posr, posl.node);
                    }
                })

            #endif

        #else     //- Short...

            {   pos   = posl;
                other = args;

                node = pos.node;

                node == other  ||  pos.each_pred_zip(equals_visitor, other)
            }

        #endif
    };

    #define visit_leaf: [](posl, args) ~> bool  =
    {
        ArgsT = typeof(args);

        #if (ArgsT.is_struct)

            {   posr  = args[0];
                first = args[1];
                idx   = args[2];

                if (posl.node == posr.node)  return  true;

                cl = posl.count;
                cr = posr.count;
                mp = util.min(cl, cr);
                util.equal(posl.node->leaf, posr.node->leaf, mp)  &&
                util.equal(posl.node->leaf + mp, first + (idx + mp), posl.count - mp)
            }

        #else     //- Short...

            {   pos   = posl;
                other = args;

                node = pos.node;

                node == other  ||  util.equal(node->leaf, other->leaf, pos.count)
            }

        #endif
    };
}


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
#define visitor_args: (Vis: visitor_t, Pos: v_static_type_t, ArgsT: v_static_type_t) ~> v_static_namespace_t
  =  Vis.v_generic_ns(visitor_args_ns, T[Pos, ArgsT]);

#define prepare_visitor_args: [](Vis, pos, args)
{'stmt_list'

    Pos   = typeof(pos);
    ArgsT = typeof(args);

    NS = visitor_args(Vis, Pos, ArgsT);

'stmt_list'}


//---------------------------------------------------------------------
//- update_visitor
//---------------------------------------------------------------------
#define update_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(update_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        result_t = *NodeT;

        #define visit_relaxed: [*, vis](pos, args) ~> result_t  =
        {
            prepare_visitor_args(vis, pos, args);

            #template visit_relaxed: [NS, Pos, ArgsT]()
            {
                inlinehint
                _visit_relaxed: (pos: Pos, args: ArgsT) ~> result_t
                {
                    idx = args[0];
                    fn  = args[1];

                    offset = pos.index(idx);
                    count  = pos.count;
                    node   = node_t.make_inner_sr_n(count, pos.relaxed);

                    child = pos.towards_oh(vis, idx, offset, fn);

                    node_t.do_copy_inner_replace_sr(
                        node, pos.node, count, offset, child);

                    return  node;
                }
            }

            NS._visit_relaxed(pos, args)
        };

        #define visit_regular: [*, vis](pos, args) ~> result_t  =
        {
            prepare_visitor_args(vis, pos, args);

            #template visit_regular: [NS, Pos, ArgsT]()
            {
                inlinehint
                _visit_regular: (pos: Pos, args: ArgsT) ~> result_t
                {
                    idx = args[0];
                    fn  = args[1];

                    offset = pos.index(idx);
                    count  = pos.count;
                    node   = node_t.make_inner_n(count);

                    child = pos.towards_oh_ch(vis, idx, offset, count, fn);

                    node_t.do_copy_inner_replace(
                        node, pos.node, count, offset, child);

                    return  node;
                }
            }

            NS._visit_regular(pos, args)
        };

        #define visit_leaf: [*, vis](pos, args) ~> result_t  =
        {
            prepare_visitor_args(vis, pos, args);

            #template visit_leaf: [NS, Pos, ArgsT]()
            {
                inlinehint
                _visit_leaf: (pos: Pos, args: ArgsT) ~> result_t
                {
                    idx = args[0];
                    fn  = args[1];

                    offset = pos.index(idx);
                    count  = pos.count;
                    node   = node_t.make_leaf_n(count);

                    dst = node->leaf;
                    src = pos.node->leaf;

                    util.conditional_initialize(dst, count);
                    util.conditional_copy(dst, src, offset);

                    dst[offset] := fn(src[offset]);           //- ...

                    off1 = offset + 1;
                    util.conditional_copy(dst + off1, src + off1, count - off1);

                    return  node;
                }
            }

            NS._visit_leaf(pos, args)
        };
    }

    vis
};


//---------------------------------------------------------------------
//- dec_visitor
//---------------------------------------------------------------------
namespace dec_visitor
{
    vis = dec_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_relaxed: [](pos, args) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            pos.each(vis, {});
            node_t.delete_inner_r(node, pos.count);
        }

        undef       //- Sic!
    };

    #define visit_regular: [](pos, args) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            pos.each(vis, {});
            node_t.delete_inner(node, pos.count);
        }

        undef       //- Sic!
    };

    #define visit_leaf: [](pos, args) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            node_t.delete_leaf(node, pos.count);
        }

        undef       //- Sic!
    };
}

//---------------------------------------------------------------------
#define dec_leaf: [](node, n: count_t) ~> void
  =  make_leaf_sub_pos(node, n).visit(dec_visitor, {});

#define dec_inner: [](node, shift: shift_t, size: size_t) ~> void
  =  visit_maybe_relaxed_sub(node, shift, size, dec_visitor, {});

#define dec_relaxed: [](node, shift: shift_t) ~> void
  =  make_relaxed_pos(node, shift, node->relaxed).visit(dec_visitor, {});

#define dec_regular: [](node, shift: shift_t, size: size_t) ~> void
  =  make_regular_pos(node, shift, size).visit(dec_visitor, {});

#define dec_empty_regular: [](node) ~> void
  =  make_empty_regular_pos(node).visit(dec_visitor, {});


//---------------------------------------------------------------------
//- get_mut_visitor
//---------------------------------------------------------------------
#define get_mut_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(get_mut_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        value_t  = NodeT.value_t;
        result_t = &value_t;

        #define visit_relaxed: [*, vis](pos, args) ~> result_t  =
        {
            idx      = args[0];
            location = args[1];

            offset = pos.index(idx);
            count  = pos.count;
            node   = pos.node;

            res: &*value_t := undef;

            if (node->can_mutate)
            {
                res := &pos.towards_oh(vis, idx, offset, &node->inner[offset]);
            }
            else
            {
                new_node = node_t.copy_inner_sr_e(node, count);

                res := &pos.towards_oh(vis, idx, offset, &new_node->inner[offset]);

                pos.visit(dec_visitor, {});

                *location := new_node;
            }

            *res
        };

        #define visit_regular: [*, vis](pos, args) ~> result_t  =
        {
            idx      = args[0];
            location = args[1];

            v_assert(pos.node == *location);
            offset = pos.index(idx);
            count  = pos.count;
            node   = pos.node;

            res: &*value_t := undef;

            if (node->can_mutate)
            {
                res := &pos.towards_oh_ch(vis, idx, offset, count, &node->inner[offset]);
            }
            else
            {
                new_node = node_t.copy_inner_e(node, count);

                res := &pos.towards_oh_ch(vis, idx, offset, count, &new_node->inner[offset]);

                pos.visit(dec_visitor, {});

                *location := new_node;
            }

            *res
        };

        #define visit_leaf: [*, vis](pos, args) ~> result_t  =
        {
            idx      = args[0];
            location = args[1];

            v_assert(pos.node == *location);
            node = pos.node;

            res: &*value_t := undef;

            if (node->can_mutate)
            {
                res := &node->leaf[pos.index(idx)];
            }
            else
            {
                new_node = node_t.copy_leaf_e(pos.node, pos.count);

                pos.visit(dec_visitor, {});

                *location := new_node;

                res := &new_node->leaf[pos.index(idx)];
            }

            *res
        };
    }

    vis
};


//---------------------------------------------------------------------
//- push_tail_mut_visitor
//---------------------------------------------------------------------
#define push_tail_mut_visitor: [](NodeT: v_static_type_t, Mutating: bool = true) ~> visitor_t  =
{
    vis = v_generic_ns(push_tail_mut_visitor_ns, T(NodeT), N(Mutating));

    #template [vis, NodeT, Mutating]()
    {
        using namespace visitor_base(vis);
        using namespace position(NodeT);

        result_t = *NodeT;

        this_vis        = vis;
        this_no_mut_vis = push_tail_mut_visitor(NodeT, false);

        mutating = Mutating;

        #define visit_relaxed: [*, vis](pos, args) ~> result_t  =
        {
            Pos   = typeof(pos);
            ArgsT = typeof(args);

            #template visit_relaxed: [*, vis, Pos, ArgsT]()
            {
                inlinehint
                _visit_relaxed: (pos: Pos, args: ArgsT) ~> result_t
                {
                    tail = args[0];
                    ts   = args[1];

                    node     = pos.node;
                    level    = pos.shift;
                    idx      = pos.count - 1;
                    children = pos.size(idx);

                    new_idx: &count_t := undef;
                    if (children == (1: size_t) << level  ||  level == BL)  new_idx := idx + 1;
                    else                                                    new_idx := idx;

                    new_child: &*node_t := 0;

                    mutate = mutating && node->can_mutate;

                    if (new_idx >= branches(B))
                    {
                        return  0;
                    }
                    else if (idx == new_idx)
                    {
                        if (mutate)
                        {
                            new_child := pos.last_oh_csh(this_vis, idx, children, {tail, ts});
                        }
                        else
                        {
                            new_child := pos.last_oh_csh(this_no_mut_vis, idx, children, {tail, ts});
                        }

                        if (!new_child)
                        {
                            if (++new_idx < branches(B))  new_child := node_t.make_path_e(level - B, tail);
                            else                          return  0;
                        }
                    }
                    else
                    {
                        new_child := node_t.make_path_e(level - B, tail);
                    }

                    if (mutate)
                    {
                        count   = new_idx + 1;
                        relaxed = node->ensure_mutable_relaxed_n(new_idx);
                        node->inner[new_idx] := new_child;
                        relaxed->d.sizes[new_idx] := pos.size + ts;
                        relaxed->d.count          := count;
                        v_assert(relaxed->d.sizes[new_idx]);
                        return  node;
                    }
                    else
                    {
                        count    = new_idx + 1;
                        new_node = node_t.copy_inner_r_e(pos.node, new_idx);
                        relaxed  = new_node->relaxed;
                        new_node->inner[new_idx]  := new_child;
                        relaxed->d.sizes[new_idx] := pos.size + ts;
                        relaxed->d.count          := count;
                        v_assert(relaxed->d.sizes[new_idx]);
                        if (mutating)
                        {
                            pos.visit(dec_visitor, {});
                        }
                        return  new_node;
                    }
                }
            }

            vis._visit_relaxed(pos, args)
        };

        #define visit_regular: [*, vis](pos, args) ~> result_t  =
        {
            Pos   = typeof(pos);
            ArgsT = typeof(args);

            #template visit_regular: [*, vis, Pos, ArgsT]()
            {
                inlinehint
                _visit_regular: (pos: Pos, args: ArgsT) ~> result_t
                {
                    tail = args[0];

                    v_assert((pos.size & mask(BL)) == 0);
                    node    = pos.node;
                    idx     = pos.index(pos.size - 1);
                    new_idx = pos.index(pos.size + branches(BL) - 1);
                    mutate  = mutating && node->can_mutate;
                    if (mutate)
                    {
                        if (idx == new_idx)
                        {
                            node->inner[new_idx] := pos.last_oh(this_vis, idx, tail);
                        }
                        else
                        {
                            node->inner[new_idx] := node_t.make_path_e(pos.shift - B, tail);
                        }
                        return  node;
                    }
                    else
                    {
                        new_parent = node_t.make_inner_e();
                        if (idx == new_idx)
                        {
                            new_parent->inner[new_idx] := pos.last_oh(this_no_mut_vis, idx, tail);
                        }
                        else
                        {
                            new_parent->inner[new_idx] := node_t.make_path_e(pos.shift - B, tail);
                        }
                        node_t.do_copy_inner(new_parent, node, new_idx);
                        if (mutating)
                        {
                            pos.visit(dec_visitor, {});
                        }
                        return  new_parent;
                    }
                }
            }

            vis._visit_regular(pos, args)
        };

        #define visit_leaf: [](pos, args) ~> result_t  =  v_assert(false && "Kinda, unreachable");
    }

    vis
};


//---------------------------------------------------------------------
//- push_tail_visitor
//---------------------------------------------------------------------
#define push_tail_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(push_tail_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);
        using namespace position(NodeT);

        result_t = *NodeT;

        #define visit_relaxed: [*, vis](pos, args) ~> result_t  =
        {
            Pos   = typeof(pos);
            ArgsT = typeof(args);

            #template visit_relaxed: [*, vis, Pos, ArgsT]()
            {
                inlinehint
                _visit_relaxed: (pos: Pos, args: ArgsT) ~> result_t
                {
                    tail = args[0];
                    ts   = args[1];

                    level    = pos.shift;
                    idx      = pos.count - 1;
                    children = pos.size(idx);

                    new_idx: &count_t := undef;
                    if (children == (1: size_t) << level  ||  level == BL)  new_idx := idx + 1;
                    else                                                    new_idx := idx;

                    new_child: &*node_t := 0;

                    if (new_idx >= branches(B))
                    {
                        return  0;
                    }
                    else if (idx == new_idx)
                    {
                        new_child := pos.last_oh_csh(vis, idx, children, {tail, ts});

                        if (!new_child)
                        {
                            if (++new_idx < branches(B))  new_child := node_t.make_path(level - B, tail);
                            else                          return  0;
                        }
                    }
                    else
                    {
                        new_child := node_t.make_path(level - B, tail);
                    }

                    count = new_idx + 1;
                    new_parent = node_t.copy_inner_n(count, pos.node, new_idx);
                    new_relaxed = new_parent->relaxed;
                    new_parent->inner[new_idx]    := new_child;
                    new_relaxed->d.sizes[new_idx] := pos.size + ts;
                    new_relaxed->d.count          := count;
                    v_assert(new_relaxed->d.sizes[new_idx]);
                    return  new_parent;
                }
            }

            vis._visit_relaxed(pos, args)
        };

        #define visit_regular: [*, vis](pos, args) ~> result_t  =
        {
            Pos   = typeof(pos);
            ArgsT = typeof(args);

            #template visit_regular: [*, vis, Pos, ArgsT]()
            {
                inlinehint
                _visit_regular: (pos: Pos, args: ArgsT) ~> result_t
                {
                    tail = args[0];

                    v_assert((pos.size & mask(BL)) == 0);

                    idx        = pos.index(pos.size - 1);
                    new_idx    = pos.index(pos.size + branches(BL) - 1);
                    count      = new_idx + 1;
                    new_parent = node_t.make_inner_n(count);
                    if (idx == new_idx)
                    {
                        new_parent->inner[new_idx] := pos.last_oh(vis, idx, tail);
                    }
                    else
                    {
                        new_parent->inner[new_idx] := node_t.make_path(pos.shift - B, tail);
                    }
                    return  node_t.do_copy_inner(new_parent, node, new_idx);
                }
            }

            vis._visit_regular(pos, args)
        };

        #define visit_leaf: [](pos, args) ~> result_t  =  v_assert(false && "Kinda, unreachable");
    }

    vis
};


//---------------------------------------------------------------------
//- dec_right_visitor
//---------------------------------------------------------------------
namespace dec_right_visitor
{
    using namespace visitor_base(dec_right_visitor);

    result_t = void;

    #define visit_relaxed: [](pos, idx: count_t) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            pos.each_right(dec_visitor, idx, {});
            node_t.delete_inner_r(node, pos.count);
        }

        undef           //- Sic!
    };

    #define visit_regular: [](pos, idx: count_t) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            pos.each_right(dec_visitor, idx, {});
            node_t.delete_inner(node, pos.count);
        }

        undef           //- Sic!
    };

    #define visit_leaf: [](pos, idx: count_t) ~> void  =  v_assert(false && "Kinda, unreachable");
}


//---------------------------------------------------------------------
//- slice_right_mut_visitor
//---------------------------------------------------------------------
#define slice_right_mut_visitor: [](NodeT: v_static_type_t,
                                    Collapse: bool = true, Mutating: bool = true) ~> visitor_t  =
{
    vis = v_generic_ns(slice_right_mut_visitor_ns, T(NodeT), N(2*Collapse + Mutating));

    #template [vis, NodeT, Collapse, Mutating]()
    {
        using namespace visitor_base(vis);
        using namespace position(NodeT);

        this_vis               = vis;
        no_collapse_vis        = slice_right_mut_visitor(NodeT, false, true);
        no_collapse_no_mut_vis = slice_right_mut_visitor(NodeT, false, false);
        no_mut_vis             = slice_right_mut_visitor(NodeT, true,  false);

        // returns a new shift, new root, the new tail size and the new tail
        result_t = struct {shift_t; *NodeT; count_t; *NodeT;};

        mutating = Mutating;
        collapse = Collapse;

        #define visit_relaxed: [*, vis](pos, last: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_relaxed: [*, vis, Pos]()
            {
                inlinehint
                _visit_relaxed: (pos: Pos, last: size_t) ~> result_t
                {
                    idx    = pos.index(last);
                    node   = pos.node;
                    mutate = mutating && node->can_mutate;
                    if (collapse  &&  idx == 0)
                    {
                        res: &result_t := undef;
                        if (mutate)
                        {
                            res := pos.towards_oh(this_vis, last, idx, {});
                        }
                        else
                        {
                            res := pos.towards_oh(no_mut_vis, last, idx, {});
                        }

                        if (mutating)
                        {
                            pos.visit(dec_right_visitor, 1);
                        }
                        return  res;
                    }
                    else
                    {
                        subs: &result_t := undef;
                        if (mutate)
                        {
                            subs := pos.towards_oh(no_collapse_vis, last, idx, {});
                        }
                        else
                        {
                            subs := pos.towards_oh(no_collapse_no_mut_vis, last, idx, {});
                        }

                        next = subs[1];
                        ts   = subs[2];
                        tail = subs[3];

                        if (next)
                        {
                            if (mutate)
                            {
                                nodr = node->ensure_mutable_relaxed_n(idx);

                                pos.each_right(dec_visitor, idx + 1, {});

                                node->inner[idx]   := next;
                                nodr->d.sizes[idx] := last + 1 - ts;
                                nodr->d.count      := idx + 1;
                                v_assert(nodr->d.sizes[idx]);
                                return  {pos.shift, node, ts, tail};
                            }
                            else
                            {
                                newn = node_t.copy_inner_r_e(node, idx);
                                newr = newn->relaxed;
                                newn->inner[idx]   := next;
                                newr->d.sizes[idx] := last + 1 - ts;
                                newr->d.count      := idx + 1;
                                v_assert(newr->d.sizes[idx]);

                                if (mutating)
                                {
                                    pos.visit(dec_visitor, {});
                                }

                                return  {pos.shift, newn, ts, tail};
                            }
                        }
                        else if (idx == 0)
                        {
                            if (mutating)
                            {
                                pos.visit(dec_right_visitor, 1);
                            }

                            return  {pos.shift, 0, ts, tail};
                        }
                        else if (collapse  &&  idx == 1  &&  pos.shift > BL)
                        {
                            newn = pos.node->inner[0];
                            if (!mutate)  newn->inc;

                            if (mutating)
                            {
                                pos.visit(dec_right_visitor, 2);
                            }

                            return  {pos.shift - B, newn, ts, tail};
                        }
                        else
                        {
                            if (mutate)
                            {
                                pos.each_right(dec_visitor, idx + 1, {});

                                node->ensure_mutable_relaxed_n(idx)->d.count := idx;
                                return  {pos.shift, node, ts, tail};
                            }
                            else
                            {
                                newn = node_t.copy_inner_r_e(node, idx);

                                if (mutating)
                                {
                                    pos.visit(dec_visitor, {});
                                }

                                return  {pos.shift, newn, ts, tail};
                            }
                        }
                    }
                }
            }

            vis._visit_relaxed(pos, last)
        };

        #define visit_regular: [*, vis](pos, last: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_regular: [*, vis, Pos]()
            {
                inlinehint
                _visit_regular: (pos: Pos, last: size_t) ~> result_t
                {
                    idx    = pos.index(last);
                    node   = pos.node;
                    mutate = mutating && node->can_mutate;
                    if (collapse  &&  idx == 0)
                    {
                        res: &result_t := undef;
                        if (mutate)
                        {
                            res := pos.towards_oh(this_vis, last, idx, {});
                        }
                        else
                        {
                            res := pos.towards_oh(no_mut_vis, last, idx, {});
                        }

                        if (mutating)
                        {
                            pos.visit(dec_right_visitor, 1);
                        }
                        return  res;
                    }
                    else
                    {
                        subs: &result_t := undef;
                        if (mutate)
                        {
                            subs := pos.towards_oh(no_collapse_vis, last, idx, {});
                        }
                        else
                        {
                            subs := pos.towards_oh(no_collapse_no_mut_vis, last, idx, {});
                        }

                        next = subs[1];
                        ts   = subs[2];
                        tail = subs[3];

                        if (next)
                        {
                            if (mutate)
                            {
                                node->inner[idx] := next;

                                pos.each_right(dec_visitor, idx + 1, {});

                                return  {pos.shift, node, ts, tail};
                            }
                            else
                            {
                                newn = node_t.copy_inner_e(node, idx);
                                newn->inner[idx] := next;

                                if (mutating)
                                {
                                    pos.visit(dec_visitor, {});
                                }

                                return  {pos.shift, newn, ts, tail};
                            }
                        }
                        else if (idx == 0)
                        {
                            if (mutating)
                            {
                                pos.visit(dec_right_visitor, 1);
                            }

                            return  {pos.shift, 0, ts, tail};
                        }
                        else if (collapse  &&  idx == 1  &&  pos.shift > BL)
                        {
                            newn = pos.node->inner[0];
                            if (!mutate)  newn->inc;

                            if (mutating)
                            {
                                pos.visit(dec_right_visitor, 2);
                            }

                            return  {pos.shift - B, newn, ts, tail};
                        }
                        else
                        {
                            if (mutate)
                            {
                                po.each_right(dec_visitor, idx + 1, {});

                                return  {pos.shift, node, ts, tail};
                            }
                            else
                            {
                                newn = node_t.copy_inner_e(node, idx);

                                if (mutating)
                                {
                                    pos.visit(dec_visitor, {});
                                }

                                return  {pos.shift, newn, ts, tail};
                            }
                        }
                    }
                }
            }

            vis._visit_regular(pos, last)
        };

        #define visit_leaf: [*, vis](pos, last: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_leaf: [*, vis, Pos]()
            {
                inlinehint
                _visit_leaf: (pos: Pos, last: size_t) ~> result_t
                {
                    old_tail_size = pos.count;
                    new_tail_size = pos.index(last) + 1;
                    node          = pos.node;
                    mutate = mutating && node->can_mutate;
                    if (new_tail_size == old_tail_size)
                    {
                        if (!mutating)  node->inc;

                        return  {0, 0, new_tail_size, node};
                    }
                    else if (mutate)
                    {
                        util.conditional_terminate(node->leaf + new_tail_size,
                                                   old_tail_size - new_tail_size);

                        return  {0, 0, new_tail_size, node};
                    }
                    else
                    {
                        new_tail = node_t.copy_leaf_e(node, new_tail_size);

                        if (mutating)
                        {
                            pos.visit(dec_visitor, {});
                        }

                        return  {0, 0, new_tail_size, new_tail};
                    }
                }
            }

            vis._visit_leaf(pos, last)
        };
    }

    vis
};


//---------------------------------------------------------------------
//- slice_right_visitor
//---------------------------------------------------------------------
#define slice_right_visitor: [](NodeT: v_static_type_t, Collapse: bool = true) ~> visitor_t  =
{
    vis = v_generic_ns(slice_right_visitor_ns, T(NodeT), N(Collapse));

    #template [vis, NodeT, Collapse]()
    {
        using namespace visitor_base(vis);
        using namespace position(NodeT);

        this_vis        = vis;
        no_collapse_vis = slice_right_visitor(NodeT, false);

        // returns a new shift, new root, the new tail size and the new tail
        result_t = struct {shift_t; *NodeT; count_t; *NodeT;};

        collapse = Collapse;

        #define visit_relaxed: [*, vis](pos, last: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_relaxed: [*, vis, Pos]()
            {
                inlinehint
                _visit_relaxed: (pos: Pos, last: size_t) ~> result_t
                {
                    idx    = pos.index(last);
                    if (collapse  &&  idx == 0)
                    {
                        return  pos.towards_oh(this_vis, last, idx, {});
                    }
                    else
                    {
                        subs = pos.towards_oh(no_collapse_vis, last, idx, {});
                        next = subs[1];
                        ts   = subs[2];
                        tail = subs[3];

                        if (next)
                        {
                            count = idx + 1;
                            newn  = node_t.copy_inner_r_n(count, pos.node, idx);
                            newr  = newn->relaxed;
                            newn->inner[idx]   := next;
                            newr->d.sizes[idx] := last + 1 - ts;
                            newr->d.count      := idx + 1;
                            v_assert(newr->d.sizes[idx]);
                            return  {pos.shift, newn, ts, tail};
                        }
                        else if (idx == 0)
                        {
                            return  {pos.shift, 0, ts, tail};
                        }
                        else if (collapse  &&  idx == 1  &&  pos.shift > BL)
                        {
                            newn = pos.node->inner[0];
                            return  {pos.shift - B, &newn->inc, ts, tail};
                        }
                        else
                        {
                            newn = node_t.copy_inner_r(pos.node, idx);
                            return  {pos.shift, newn, ts, tail};
                        }
                    }
                }
            }

            vis._visit_relaxed(pos, last)
        };

        #define visit_regular: [*, vis](pos, last: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_regular: [*, vis, Pos]()
            {
                inlinehint
                _visit_regular: (pos: Pos, last: size_t) ~> result_t
                {
                    idx    = pos.index(last);
                    if (collapse  &&  idx == 0)
                    {
                        return  pos.towards_oh(this_vis, last, idx, {});
                    }
                    else
                    {
                        subs = pos.towards_oh(no_collapse_vis, last, idx, {});
                        next = subs[1];
                        ts   = subs[2];
                        tail = subs[3];

                        if (next)
                        {
                            newn = node_t.copy_inner_n(idx + 1, pos.node, idx);
                            newn->inner[idx] := next;
                            return  {pos.shift, newn, ts, tail};
                        }
                        else if (idx == 0)
                        {
                            return  {pos.shift, 0, ts, tail};
                        }
                        else if (collapse  &&  idx == 1  &&  pos.shift > BL)
                        {
                            newn = pos.node->inner[0];
                            return  {pos.shift - B, &newn->inc, ts, tail};
                        }
                        else
                        {
                            newn = node_t.copy_inner_n(idx, pos.node, idx);
                            return  {pos.shift, newn, ts, tail};
                        }
                    }
                }
            }

            vis._visit_regular(pos, last)
        };

        #define visit_leaf: [*, vis](pos, last: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_leaf: [*, vis, Pos]()
            {
                inlinehint
                _visit_leaf: (pos: Pos, last: size_t) ~> result_t
                {
                    old_tail_size = pos.count;
                    new_tail_size = pos.index(last) + 1;

                    new_tail: &*node_t := undef;

                    if (new_tail_size == old_tail_size)
                    {
                        new_tail := &pos.node()->inc;
                    }
                    else
                    {
                        new_tail := node_t.copy_leaf(pos.node, new_tail_size);
                    }

                    return  {0, 0, new_tail_size, new_tail};
                }
            }

            vis._visit_leaf(pos, last)
        };
    }

    vis
};


//---------------------------------------------------------------------
//- dec_left_visitor
//---------------------------------------------------------------------
namespace dec_left_visitor
{
    using namespace visitor_base(dec_left_visitor);

    result_t = void;

    #define visit_relaxed: [](pos, idx: count_t) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            pos.each_left(dec_visitor, idx, {});
            node_t.delete_inner_r(node, pos.count);
        }

        undef           //- Sic!
    };

    #define visit_regular: [](pos, idx: count_t) ~> void  =
    {
        node_t = typeof(pos).node_t;
        node = pos.node;
        if (node->dec)
        {
            pos.each_left(dec_visitor, idx, {});
            node_t.delete_inner(node, pos.count);
        }

        undef           //- Sic!
    };

    #define visit_leaf: [](pos, idx: count_t) ~> void  =  v_assert(false && "Kinda, unreachable");
}


//---------------------------------------------------------------------
//- slice_left_mut_visitor
//---------------------------------------------------------------------
#define slice_left_mut_visitor: [](NodeT: v_static_type_t,
                                   Collapse: bool = true, Mutating: bool = true) ~> visitor_t  =
{
    vis = v_generic_ns(slice_left_mut_visitor_ns, T(NodeT), N(2*Collapse + Mutating));

    #template [vis, NodeT, Collapse, Mutating]()
    {
        using namespace visitor_base(vis);
        using namespace position(NodeT);

        this_vis               = vis;
        no_collapse_vis        = slice_left_mut_visitor(NodeT, false, true);
        no_collapse_no_mut_vis = slice_left_mut_visitor(NodeT, false, false);
        no_mut_vis             = slice_left_mut_visitor(NodeT, true,  false);

        // returns a new shift and new root
        result_t = struct {shift_t; *NodeT;};

        mutating = Mutating;
        collapse = Collapse;

        #define visit_relaxed: [*, vis](pos, first: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_relaxed: [*, vis, Pos]()
            {
                inlinehint
                _visit_relaxed: (pos: Pos, first: size_t) ~> result_t
                {
                    idx                = pos.subindex(first);
                    count              = pos.count;
                    node               = pos.node;
                    mutate             = mutating && node->can_mutate;
                    left_size          = pos.size_before(idx);
                    child_size         = pos.size_sbh(idx, left_size);
                    dropped_size       = first;
                    child_dropped_size = dropped_size - left_size;

                    if (collapse  &&  pos.shift > BL  &&  idx == pos.count - 1)
                    {
                        r: &result_t := undef;

                        if (mutate)  r := pos.towards_sub_oh(this_vis, first, idx, {});
                        else         r := pos.towards_sub_oh(no_mut_vis, first, idx, {});

                        if (mutate)         pos.visit(dec_left_visitor, idx);
                        else if (mutating)  pos.visit(dec_visitor, {});
                        return r;
                    }
                    else
                    {
                        newn: &*node_t := undef;

                        if (mutate)  newn := {node->ensure_mutable_relaxed(); node};
                        else         newn := node_t.make_inner_r_e();

                        newr     = newn->relaxed;
                        newcount = count - idx;
                        new_child_size = child_size - child_dropped_size;

                        subs: &result_t := undef;

                        if (mutate)  subs := pos.towards_sub_oh(no_collapse_vis, first, idx, {});
                        else         subs := pos.towards_sub_oh(no_collapse_no_mut_vis, first, idx, {});
                        if (mutate)  pos.each_left(dec_visitor, idx);
                        pos.copy_sizes(idx + 1, newcount - 1, new_child_size, newr->d.sizes + 1);

                        util.conditional_copy(newn->inner + 1, node->inner + idx + 1, count - idx - 1);

                        newn->inner[0]   := subs[1];
                        newr->d.sizes[0] := new_child_size;
                        newr->d.count    := newcount;
                        v_assert(new_child_size);
                        if (!mutate)
                        {
                            node_t.inc_nodes(newn->inner + 1, newcount - 1);
                            if (mutating)  pos.visit(dec_visitor, {});
                        }
                        return {pos.shift, newn};
                    }
                }
            }

            vis._visit_relaxed(pos, first)
        };

        #define visit_regular: [*, vis](pos, first: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_regular: [*, vis, Pos]()
            {
                inlinehint
                _visit_regular: (pos: Pos, first: size_t) ~> result_t
                {
                    idx    = pos.subindex(first);
                    count  = pos.count;
                    node   = pos.node;
                    mutate = mutating
                             // this is more restrictive than actually needed because
                             // it causes the algorithm to also avoid mutating the leaf
                             // in place
                             &&  !node_t.embed_relaxed  &&  node->can_mutate;
                    left_size          = pos.size_before(idx);
                    child_size         = pos.size_sbh(idx, left_size);
                    dropped_size       = first;
                    child_dropped_size = dropped_size - left_size;
                    if (collapse  &&  pos.shift > BL  &&  idx == pos.count() - 1)
                    {
                        r: &result_t := undef;

                        if (mutate)  r := pos.towards_sub_oh(this_vis, first, idx, {});
                        else         r := pos.towards_sub_oh(no_mut_vis, first, idx, {});

                        if (mutate)         pos.visit(dec_left_visitor, idx);
                        else if (mutating)  pos.visit(dec_visitor, {});
                        return r;
                    }
                    else
                    {
                        // if possible, we convert the node to a relaxed one simply by
                        // allocating a `relaxed_t` size table for it... maybe some of this
                        // magic should be moved as a `node<...>` static method...              //- ?..
                        newcount = count - idx;

                        newn: &*node_t := undef;

                        if (mutate)
                        {
                            r = node_t.heap.allocate(node_t.max_sizeof_relaxed);
                            r = (r: *relaxed_t);

                            util.conditional_initialize(r);

                            node->impl.d.data.inner.relaxed := r;

                            newn := node;
                        }
                        else
                        {
                            newn := node_t.make_inner_r_e();
                        }

                        newr = newn->relaxed;

                        subs: &result_t := undef;

                        if (mutate)  subs := pos.towards_sub_oh(no_collapse_vis, first, idx, {});
                        else         subs := pos.towards_sub_oh(no_collapse_no_mut_vis, first, idx, {});
                        if (mutate)  pos.each_left(dec_visitor, idx);
                        newr->d.sizes[0] := child_size - child_dropped_size;
                        v_assert(newr->d.sizes[0]);
                        pos.copy_sizes(idx + 1, newcount - 1, newr->d.sizes[0], newr->d.sizes + 1);
                        newr->d.count  := newcount;
                        newn->inner[0] := subs[1];

                        util.conditional_copy(newn->inner + 1, node->inner + idx + 1, count - idx - 1);

                        if (!mutate)
                        {
                            node_t.inc_nodes(newn->inner + 1, newcount - 1);
                            if (vutating)  pos.visit(dec_visitor, {});
                        }
                        return {pos.shift, newn};
                    }
                }
            }

            vis._visit_regular(pos, first)
        };

        #define visit_leaf: [*, vis](pos, first: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_leaf: [*, vis, Pos]()
            {
                inlinehint
                _visit_leaf: (pos: Pos, first: size_t) ~> result_t
                {
                    node   = pos.node;
                    idx    = pos.index(first);
                    count  = pos.count;
                    mutate = mutating  &&  node->can_mutate;    //- ?!?!?!?!?
                    if (mutate)
                    {
                        data     = node->leaf;
                        newcount = count - idx;

                        util.move_in_place(data, idx, newcount);

                        return  {0, node};
                    }
                    else
                    {
                        newn = node_t.copy_leaf_e(node, idx, count);
                        if (mutating)  pos.visit(dec_visitor, {});
                        return  {0, newn};
                    }
                }
            }

            vis._visit_leaf(pos, first)
        };
    }

    vis
};


//---------------------------------------------------------------------
//- slice_left_visitor
//---------------------------------------------------------------------
#define slice_left_visitor: [](NodeT: v_static_type_t, Collapse: bool = true) ~> visitor_t  =
{
    vis = v_generic_ns(slice_left_visitor_ns, T(NodeT), N(Collapse));

    #template [vis, NodeT, Collapse]()
    {
        using namespace visitor_base(vis);
        using namespace position(NodeT);

        this_vis        = vis;
        no_collapse_vis = slice_left_visitor(NodeT, false);

        // returns a new shift and new root
        result_t = struct {shift_t; *NodeT;};

        collapse = Collapse;

        #define visit_inner: [*, vis](pos, first: size_t) ~> result_t  =
        {
            Pos = typeof(pos);

            #template visit_inner: [*, vis, Pos]()
            {
                inlinehint
                _visit_inner: (pos: Pos, first: size_t) ~> result_t
                {
                    idx                = pos.subindex(first);
                    count              = pos.count;
                    left_size          = pos.size_before(idx);
                    child_size         = pos.size_sbh(idx, left_size);
                    dropped_size       = first;
                    child_dropped_size = dropped_size - left_size;
                    if (collapse  &&  pos.shift > BL  &&  idx == pos.count - 1)
                    {
                        return  pos.towards_sub_oh(this_vis, first, idx, {});
                    }
                    else
                    {
                        n    = pos.node;
                        newc = count - idx;
                        newn = node_t.make_inner_r_n(newc);
                        subs = pos.towards_sub_oh(no_collapse_vis, first, idx, {});
                        newr = newn->relaxed;
                        newr->d.count    := count - idx;
                        newr->d.sizes[0] := child_size - child_dropped_size;
                        v_assert(newr->d.sizes[0]);
                        pos.copy_sizes(idx + 1,
                                       newr->d.count - 1,
                                       newr->d.sizes[0],
                                       newr->d.sizes + 1);
                        v_assert(newr->d.sizes[newr->d.count - 1] == pos.size - dropped_size);
                        newn->inner()[0] := subs[1];

                        util.conditional_copy(newn->inner + 1, n->inner + idx + 1, count - idx - 1);

                        node_t.inc_nodes(newn->inner + 1, newr->d.count - 1);
                        return  {pos.shift, newn};
                    }
                }
            }

            vis._visit_inner(pos, first)
        };

        #define visit_leaf: [*, vis](pos, first: size_t) ~> result_t  =
        {
            n = node_t.copy_leaf(pos.node, pos.index(first), pos.count);

            {0, n}
        };
    }

    vis
};


//---------------------------------------------------------------------
//- concat_center_pos
//---------------------------------------------------------------------
#template _instantiate_concat_center_pos: [](NS, NodeT: v_static_type_t)
{
    struct concat_center_pos;

    namespace concat_center_pos
    {
        using namespace NS;

        max_children = 3;
    }

    private max_children = concat_center_pos.max_children;

    struct concat_center_pos
    {
        shift_: shift_t;
        count_: count_t;
        nodes_: node_t[max_children];
        sizes_: size_t[max_children];
    };

    alwaysinline
    (_.shift): (p: concat_center_pos) ~> shift_t  =  p.shift_;

    #define (_.each_sub()): [](p: concat_center_pos, v: visitor_t, args)  =
    {
        prepare_position_args(p, v, args);

        #template each_sub: [NS, Pos, v, ArgsT]()
        {
            inlinehint
            _each_sub: (pos: Pos, args: ArgsT) ~> void
            {
                if (pos.shift_ == BL)
                {
                    s: &size_t := 0;

                    for (i: &count_t := 0; i < pos.count_; ++i)
                    {
                        make_leaf_sub_pos(pos.nodes_[i], pos.sizes_[i] - s).visit(v, args);
                        s := pos.sizes_[i];
                    }
                }
                else
                {
                    for (i: &count_t := 0; i < pos.count_; ++i)
                    {
                        make_relaxed_pos(pos.nodes_[i], pos.shift_ - B, pos.nodes_[i]->relaxed)
                            .visit(v, args);
                    }
                }
            }
        }

        NS._each_sub(p, args)
    };

    inlinehint
    (_.realize): (p: &concat_center_pos) ~> NS.relaxed_pos
    {
        if (p.count_ > 1)
        {
            result = node_t.make_inner_r_n(p.count_);
            r      = result->relaxed;
            r->d.count := p.count_;

            util.conditional_copy(result->inner, p.nodes_, p.count);
            util.conditional_copy(r->d.sizes,    p.sizes_, p.count);
            return  {result, shift_, r};
        }
        else
        {
            v_assert(p.shift_ >= B + BL);
            return  {p.nodes_[0], p.shift_ - B, p.nodes_[0]->relaxed};
        }
    }

    inlinehint
    (_.realize_e): (p: &concat_center_pos) ~> NS.relaxed_pos
    {
        if (p.count_ > 1)
        {
            result = node_t.make_inner_r_n_e();
            r      = result->relaxed;
            r->d.count := p.count_;

            util.conditional_copy(result->inner, p.nodes_, p.count);
            util.conditional_copy(r->d.sizes,    p.sizes_, p.count);
            return  {result, p.shift_, r};
        }
        else
        {
            v_assert(p.shift_ >= B + BL);
            return  {p.nodes_[0], p.shift_ - B, p.nodes_[0]->relaxed};
        }
    }

}   //- #template

//---------------------------------------------------------------------
#define make_concat_center_pos_1: (s: shift_t, n0, s0: size_t)  =
{
    prepare_position(n0);

    _instantiate_concat_center_pos(NS, NodeT);

    ret: NS.concat_center_pos = {s, 1, {n0}, {s0}};

    ret
};

#define make_concat_center_pos_2: (s: shift_t, n0, s0: size_t, n1, s1: size_t)  =
{
    prepare_position(n0);

    _instantiate_concat_center_pos(NS, NodeT);

    ret: NS.concat_center_pos = {s, 2, {n0, n1}, {s0, s0 + s1}};

    ret
};

#define make_concat_center_pos_3: (s: shift_t, n0, s0: size_t, n1, s1: size_t, n2, s2: size_t)  =
{
    prepare_position(n0);

    _instantiate_concat_center_pos(NS, NodeT);

    ret: NS.concat_center_pos = {s, 3, {n0, n1, n2}, {s0, s0 + s1, s0 + s1 + s2}};

    ret
};


//---------------------------------------------------------------------
//- concat_merger
//---------------------------------------------------------------------
#template _instantiate_concat_merger: [](NS, NodeT: v_static_type_t)
{
    private result_t = NS.concat_center_pos;

    struct concat_merger
    {
        curr_:   *count_t;
        n_:      count_t;
        result_: result_t;

        to_:        *node_t;
        to_offset_: count_t;
        to_size_:   size_t;
    };

    namespace concat_merger { using namespace NS; }

    inlinehint
    (_.add_child()): (self: &concat_merger, p: *node_t, size: size_t) ~> void
    {
        v_assert(size);
        ++self.curr_;
        parent:  &*node_t    := self.result_.nodes_[self.result_.count_ - 1];
        relaxed: &*relaxed_t := parent->relaxed;
        if (relaxed->d.count == branches(B))
        {
            v_assert(self.result_.count_ < result_t.max_children);
            self.n_ -= branches(B);
            parent  := node_t.make_inner_r_n(util.min(self.n_, branches(B)));
            relaxed := parent->relaxed;
            self.result_.nodes_[self.result_.count_] := parent;
            self.result_.sizes_[self.result_.count_] := self.result_.sizes_[self.result_.count_ - 1];
            v_assert(self.result_.sizes_[self.result_.count_]);
            ++self.result_.count_;
        }
        idx = self.relaxed->d.count++;
        self.result_.sizes_[self.result_.count_ - 1] += size;
        v_assert(self.result_.sizes_[self.result_.count_ - 1]);

        if (idx)  relaxed->d.sizes[idx] := size + relaxed->d.sizes[idx - 1];
        else      relaxed->d.sizes[idx] := size;

        v_assert(relaxed->d.sizes[idx]);
        parent->inner[idx] := p;
    }

    #define (_.merge_leaf()): [*, NS](self: &concat_merger, p) ~> void  =
    {
        Pos = typeof(p);

        #template merge_leaf: [*, NS, Pos]()
        {
            inlinehint
            _merge_leaf: (self: &concat_merger, p: Pos) ~> void
            {
                from       = p.node;
                from_size  = p.size;
                from_count = p.count;
                v_assert(from_size);
                if (!self.to_  &&  *self.curr_ == from_count)
                {
                    self.add_child(from, from_size);
                    from->inc;
                }
                else
                {
                    from_offset: &count_t := 0;
                    from_data = from->leaf;
                    loop
                    {
                        if (!self.to_)
                        {
                            self.to_        := node_t.make_leaf_n(*self.curr_);
                            self.to_offset_ := 0;
                        }
                        data = self.to_->leaf;
                        to_copy = util.min(from_count - from_offset, *self.curr_ - self.to_offset_);

                        util.uninitialized_copy(data + self.to_offset_, from_data + from_offset, to_copy);

                        self.to_offset_ += to_copy;
                        from_offset     += to_copy;
                        if (*self.curr_ == self.to_offset_)
                        {
                            self.add_child(self.to_, self.to_offset_);
                            self.to_ := 0;
                        }

                        if (from_offset == from_count)  break;
                    }
                }
            }
        }

        NS._merge_leaf(self, p)
    };

    #define (_.merge_inner()): [*, NS](self: &concat_merger, p) ~> void  =
    {
        Pos = typeof(p);

        #template merge_inner: [*, NS, Pos]()
        {
            inlinehint
            _merge_inner: (self: &concat_merger, p: Pos) ~> void
            {
                from       = p.node;
                from_size  = p.size;
                from_count = p.count;
                v_assert(from_size);
                if (!self.to_  &&  *self.curr_ == from_count)
                {
                    self.add_child(from, from_size);
                    from->inc;
                }
                else
                {
                    from_offset: &count_t := 0;
                    from_data = from->inner;
                    loop
                    {
                        if (!self.to_)
                        {
                            self.to_        := node_t.make_inner_r_n(*self.curr_);
                            self.to_offset_ := 0;
                            self.to_size_   := 0;
                        }
                        data = self.to_->inner;
                        to_copy = util.min(from_count - from_offset, *self.curr_ - self.to_offset_);

                        util.uninitialized_copy(data + self.to_offset_, from_data + from_offset, to_copy);

                        node_t.inc_nodes(from_data + from_offset, to_copy);
                        sizes = self.to_->relaxed->d.sizes;
                        p.copy_sizes(from_offset, to_copy, self.to_size_, sizes + self.to_offset_);
                        self.to_offset_ += to_copy;
                        from_offset     += to_copy;
                        self.to_size_ := sizes[self.to_offset_ - 1];
                        v_assert(self.to_size_);
                        if (*self.curr_ == self.to_offset_)
                        {
                            self.to_->relaxed->d.count := self.to_offset_;
                            self.add_child(self.to_, self.to_size_);
                            self.to_ := 0;
                        }

                        if (from_offset == from_count)  break;
                    }
                }
            }
        }

        NS._merge_inner(self, p)
    };

    alwaysinline
    (_.finish): (self: &concat_merger) ~> result_t  =
    {
        v_assert(!self.to_);

        self.result_
    };

//    inlinehint
//    (_.abort): (self: &concat_merger) ~> void
//    {
//        shift = self.result_.shift_ - B;
//        if (self.to_)
//        {
//            if (shift == BL)
//            {
//                node_t.delete_leaf(self.to_, self.to_offset_);
//            }
//            else
//            {
//                self.to_->relaxed->d.count := self.to_offset_;
//                dec_relaxed(self.to_, shift - B);
//            }
//        }
//        self.result_.each_sub(dec_visitor, {});
//    }

}   //- #template

//---------------------------------------------------------------------
#define make_concat_merger: (NT: v_static_type_t, shift: shift_t, counts: *count_t, n: count_t)  =
{
    prepare_position((undef: *NT));             //- ?!?!?!?!?

    _instantiate_concat_merger(NS, NodeT);

    m = util.min(n, branches(B));

    ret: NS.concat_merger = {counts, n, make_concat_center_pos_1(shift + B, node_t.make_inner_r_n(m), 0), 0,0,0};

    ret
};


//---------------------------------------------------------------------
//- concat_merger_visitor
//---------------------------------------------------------------------
namespace concat_merger_visitor
{
    vis = concat_merger_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_inner: [](p, merger) ~> void  =  merger.merge_inner(p);
    #define visit_leaf:  [](p, merger) ~> void  =  merger.merge_leaf(p);
}


//---------------------------------------------------------------------
//- concat_rebalance_plan_fill_visitor
//---------------------------------------------------------------------
namespace concat_rebalance_plan_fill_visitor
{
    vis = concat_rebalance_plan_fill_visitor;

    using namespace visitor_base(vis);

    result_t = void;

    #define visit_node: [](p, plan) ~> void  =
    {
        count = p.count;
        v_assert(plan.n < typeof(plan).element_type.max_children);
        plan.counts[plan.n++] := count;
        plan.total += count;

        undef       //- Sic!
    };
}


//---------------------------------------------------------------------
//- concat_rebalance_plan
//---------------------------------------------------------------------
#define concat_rebalance_plan: [](B: bits_t, BL: bits_t) ~> v_static_type_t  =
{
    crp_t = v_generic(concat_rebalance_plan_tag, N[B,BL]);

    #template [*, crp_t, B, BL]()
    {
        max_children = 2 * branches(B) + 1;

        private
        impl_t = struct
        {
            counts: count_t[max_children];
            n:      count_t;
            total:  count_t;
        };

        #do (v_set_implementation_type(crp_t, impl_t))

        alwaysinline
        ({_}): () ~> crp_t
        {
            ret = v_get_return_value();

            *(&ret : *impl_t) := {{}, 0, 0};
        }

        #define (_.fill()): (self: &crp_t, lpos, cpos, rpos) ~> void  =
        {
            impl = *(&self : *impl_t);

            v_assert(impl.n == 0);
            v_assert(impl.total == 0);

            vis = concat_rebalance_plan_fill_visitor;
            lpos.each_left_sub(vis, self);
            cpos.each_sub(vis, self);
            rpos.each_right_sub(vis, self);

            undef       //- Sic!
        };

        inlinehint
        (_.shuffle()): (self: &crp_t, shift: shift_t) ~> void
        {
            self = *(&self : *impl_t);

            rrb_extras    = 2;
            rrb_invariant = 1;

            bits: &bits_t := undef;

            if (shift == BL)  bits := BL;
            else              bits := B;

            branches = (1: count_t) << bits;
            optimal  = ((self.total - 1) >> bits) + 1;

            i: &count_t := 0;
            while (self.n >= optimal + rrb_extras)
            {
                // skip ok nodes
                while (self.counts[i] > branches - rrb_invariant)
                    i++;
                v_assert(i < self.n);
                // short node, redistribute
                remaining: &count_t := self.counts[i];
                loop
                {
                    next  = self.counts[i + 1];
                    count = util.min(remaining + next, branches);
                    self.counts[i] := count;
                    v_assert(self.counts[i]);
                    remaining += next - count;
                    ++i;

                    if (remaining <= 0)  break;
                }
                // remove node
                util.conditional_move(self.counts + i, self.counts + i + 1, self.n - i - 1);
                --self.n;
                --i;
            }
        }

        #define (_.merge()): (self: &crp_t, lpos, cpos, rpos)  =
        {
            self = *(&self : *impl_t);

            node_t = typeof(cpos).node_t;
            merger = make_concat_merger(node_t, cpos.shift, self.counts, self.n);
            vis    = concat_merger_visitor;
            lpos.each_left_sub(vis, merger);
            cpos.each_sub(vis, merger);
            rpos.each_right_sub(vis, merger);
            cpos.each_sub(dec_visitor, {});

            merger.finish
        };
    }

    crp_t
};


//---------------------------------------------------------------------
//- concat_rebalance
//---------------------------------------------------------------------
#define concat_rebalance: [](lpos, cpos, rpos)  =
{
    node_t = typeof(cpos).node_t;

    plan: &concat_rebalance_plan(node_t.bits, node_t.bits_leaf) := {};

    plan.fill(lpos, cpos, rpos);
    plan.shuffle(cpos.shift);

    plan.merge(lpos, cpos, rpos)
};


//---------------------------------------------------------------------
//- concat_leafs
//---------------------------------------------------------------------
#define concat_leafs: [](lpos, tpos, rpos)  =
{
    node_t = typeof(tpos).node_t;

    #assert (node_t.bits >= 2)

    v_assert(lpos.shift == tpos.shift);
    v_assert(lpos.shift == rpos.shift);
    v_assert(lpos.shift == 0);

    BL = node_t.bits_leaf;

    ret_t = position(node_t).concat_center_pos;

    ret: &ret_t := undef;

    if (tpos.count > 0)
    {
        ret := make_concat_center_3(BL, lpos.node->inc, lpos.count,
                                        tpos.node->inc, tpos.count,
                                        rpos.node->inc, rpos.count);
    }
    else
    {
        ret := make_concat_center_3(BL, lpos.node->inc, lpos.count,
                                        rpos.node->inc, rpos.count);
    }

    (ret: ret_t)
};


//---------------------------------------------------------------------
//- concat_inners
//---------------------------------------------------------------------
#define concat_inners: [](lpos, tpos, rpos)  =
{
    node_t = typeof(tpos).node_t;

    lshift = lpos.shift;
    rshift = rpos.shift;

    ret_t = position(node_t).concat_center_pos;

    ret: &ret_t := undef;

    if (lshift > rshift)
    {
        cpos = lpos.last_sub(concat_left_visitor(node_t), {tpos, rpos});
        ret := concat_rebalance(lpos, cpos, make_null_sub_pos());
    }
    else if (lshift < rshift)
    {
        cpos = rpos.first_sub(concat_right_visitor(node_t), {lpos, tpos});
        ret := concat_rebalance(make_null_sub_pos(), cpos, rpos);
    }
    else
    {
        v_assert(lshift == rshift);
        v_assert(node_t.bits_leaf == 0  ||  lshift > 0);
        cpos = lpos.last_sub(concat_both_visitor(node_t), {tpos, rpos});
        ret := concat_rebalance(lpos, cpos, rpos);
    }

    (ret: ret_t)
};


//---------------------------------------------------------------------
//- concat_left_visitor
//---------------------------------------------------------------------
#define concat_left_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(concat_left_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        result_t = position(NodeT).concat_center_pos;

        #define visit_inner: [](lpos, args) ~> result_t  =
        {
            tpos = args[0];
            rpos = args[1];

            concat_inners(lpos, tpos, rpos)
        };

        #define visit_leaf: [](lpos, args) ~> result_t  =
        {
            v_assert(false  &&  "Kinda, unreachable...");

            undef
        };
    }

    vis
};


//---------------------------------------------------------------------
//- concat_right_visitor
//---------------------------------------------------------------------
#define concat_right_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(concat_right_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        result_t = position(NodeT).concat_center_pos;

        #define visit_inner: [](rpos, args) ~> result_t  =
        {
            lpos = args[0];
            tpos = args[1];

            concat_inners(lpos, tpos, rpos)
        };

        #define visit_leaf: [](rpos, args) ~> result_t  =
        {
            lpos = args[0];
            tpos = args[1];

            concat_leafs(lpos, tpos, rpos)
        };
    }

    vis
};


//---------------------------------------------------------------------
//- concat_both_visitor
//---------------------------------------------------------------------
#define concat_both_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(concat_both_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        result_t = position(NodeT).concat_center_pos;

        #define visit_inner: [*, NodeT](lpos, args) ~> result_t  =
        {
            tpos = args[0];
            rpos = args[1];

            rpos.first_sub(concat_right_visitor(NodeT), {lpos, tpos})
        };

        #define visit_leaf: [](lpos, args) ~> result_t  =
        {
            tpos = args[0];
            rpos = args[1];

            rpos.first_sub_leaf(concat_right_visitor(NodeT), {lpos, tpos})
        };
    }

    vis
};


//---------------------------------------------------------------------
//- concat_trees_right_visitor
//---------------------------------------------------------------------
#define concat_trees_right_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(concat_trees_right_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        result_t = position(NodeT).concat_center_pos;

        #define visit_node: [](rpos, args) ~> result_t  =
        {
            lpos = args[0];
            tpos = args[1];

            concat_inners(lpos, tpos, rpos)
        };
    }

    vis
};


//---------------------------------------------------------------------
//- concat_trees_left_visitor
//---------------------------------------------------------------------
#define concat_trees_left_visitor: [](NodeT: v_static_type_t) ~> visitor_t  =
{
    vis = v_generic_ns(concat_trees_left_visitor_tag, T(NodeT));

    #template [vis, NodeT]()
    {
        using namespace visitor_base(vis);

        result_t = position(NodeT).concat_center_pos;

        #define visit_node: [](lpos, args) ~> result_t  =
        {
            tpos   = args[0];
            lroot  = args[1];
            lshift = args[2];
            lsize  = args[3];

            visit_maybe_relaxed_sub(lroot, lshift, lsize,
                                    concat_trees_right_visitor(NodeT), {lpos, tpos})
        };
    }

    vis
};












































