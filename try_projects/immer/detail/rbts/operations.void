//---------------------------------------------------------------------
//- <immer/detail/rbts/operations.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {
namespace rbts {


//---------------------------------------------------------------------
//- array_for_visitor
//---------------------------------------------------------------------
#define array_for_visitor: [](T: v_static_type_t) ~> v_static_namespace_t
  =  v_generic_ns(array_for_visitor_ns, T(T));

#define instantiate_array_for_visitor: [](T: v_static_type_t)
{'unit_defn_list'

    namespace array_for_visitor(T)
    {
      #if (v_guard_ns())

        value_t = T;

        #do (instantiate_visitor_base(array_for_visitor(T)))

        #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(args_derived_ns))

              #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
              #assert (ArgsT.element_types[0].node_t.value_t == value_t)
              #assert (ArgsT.element_types[1] == size_t)
              #assert (RetT == *value_t)

              #do (instantiate_args(ArgsT, RetT))

              PosT = ArgsT.element_types[0];

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_inner_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   PosT.instantiate_descend(derived_ns, size_t, RetT),
                   )

              alwaysinline
              visit_inner: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  ns = position_args(PosT, derived_ns, size_t, RetT);
                  ns.descend(pos, idx)
              };

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_leaf_ns))

              #do (instantiate_args_derived(ArgsT, RetT))

              alwaysinline
              visit_leaf: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];

                  pos.node->leaf
              };

            #endif
          }

        'unit_defn_list'}

      #endif
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- region_for_visitor
//---------------------------------------------------------------------
#define region_for_visitor: [](T: v_static_type_t) ~> v_static_namespace_t
  =  v_generic_ns(region_for_visitor_ns, T(T));

#define instantiate_region_for_visitor: [](T: v_static_type_t)
{'unit_defn_list'

    namespace region_for_visitor(T)
    {
      #if (v_guard_ns())

        value_t = T;

        #do (instantiate_visitor_base(region_for_visitor(T)))

        #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(args_derived_ns))

              #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
              #assert (ArgsT.element_types[0].node_t.value_t == value_t)
              #assert (ArgsT.element_types[1] == size_t)
              #assert (RetT == struct { *value_t; size_t; size_t; })

              #do (instantiate_args(ArgsT, RetT))

              PosT = ArgsT.element_types[0];

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_inner_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   PosT.instantiate_towards(derived_ns, size_t, RetT),
                   )

              alwaysinline
              visit_inner: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  ns = position_args(PosT, derived_ns, size_t, RetT);
                  ns.towards(pos, idx)
              };

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_leaf_ns))

              #do (instantiate_args_derived(ArgsT, RetT))

              alwaysinline
              visit_leaf: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  {pos.node->leaf, pos.index(idx), pos.count}
              };

            #endif
          }

        'unit_defn_list'}

      #endif
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- get_visitor
//---------------------------------------------------------------------
#define get_visitor: [](T: v_static_type_t) ~> v_static_namespace_t
  =  v_generic_ns(get_visitor_ns, T(T));

#define instantiate_get_visitor: [](T: v_static_type_t)
{'unit_defn_list'

    namespace get_visitor(T)
    {
      #if (v_guard_ns())

        value_t = T;

        #do (instantiate_visitor_base(get_visitor(T)))

        #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(args_derived_ns))

              #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
              #assert (ArgsT.element_types[0].node_t.value_t == value_t)
              #assert (ArgsT.element_types[1] == size_t)
              #assert (RetT == &const value_t)

              #do (instantiate_args(ArgsT, RetT))

              PosT = ArgsT.element_types[0];

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_inner_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   PosT.instantiate_descend(derived_ns, size_t, RetT),
                   )

              alwaysinline
              visit_inner: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  ns = position_args(PosT, derived_ns, size_t, RetT);
                  ns.descend(pos, idx)
              };

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_leaf_ns))

              #do (instantiate_args_derived(ArgsT, RetT))

              alwaysinline
              visit_leaf: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  pos.node->leaf[pos.index(idx)]
              };

            #endif
          }

        'unit_defn_list'}

      #endif
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- for_each_chunk_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
          #assert (RetT == void)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[1];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_inner_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_each(derived_ns, Fn),
               )

          alwaysinline
          visit_inner: (args: ArgsT) ~> void
          {
              pos = args[0];
              fn  = args[1];

              ns = position_args(Pos, derived_ns, Fn);
              ns.each(pos, fn);
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (args: ArgsT) ~> void
          {
              pos = args[0];
              fn  = args[1];

              data = pos.node->leaf;
              fn(data, data + pos.count);
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
//- for_each_chunk_p_visitor
