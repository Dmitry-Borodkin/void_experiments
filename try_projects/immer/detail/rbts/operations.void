//- update_visitor
//---------------------------------------------------------------------
#define update_visitor: [](NodeT: v_static_type_t) ~> v_static_namespace_t
  =  v_generic_ns(update_visitor_ns, T(NodeT));

#define instantiate_update_visitor: [](NodeT: v_static_type_t)
{'unit_defn_list'

    namespace update_visitor(NodeT)
    {
      #if (v_guard_ns())

        node_t  = NodeT;
        value_t = NodeT.value_t;

        #do (instantiate_visitor_base(update_visitor(NodeT)))

        #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(args_derived_ns))

              #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
              #assert (ArgsT.element_types[0].node_t == node_t)
              #assert (ArgsT.element_types[1].is_struct)
              #assert (ArgsT.element_types[1].element_count == 2)
              #assert (ArgsT.element_types[1].element_types[0] == size_t)
              #assert (RetT == *node_t)

              #do (instantiate_args(ArgsT, RetT))

              Pos = ArgsT.element_types[0];
              Fn  = ArgsT.element_types[1].element_types[1];

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_relaxed: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_relaxed_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   Pos.instantiate_towards_oh(derived_ns, Fn, RetT),
                   )

              inlinehint
              visit_relaxed: (args: ArgsT) ~> RetT
              {
                  pos = args[0];
                  idx = args[1][0];
                  fn  = args[1][1];

                  offset = pos.index(idx);
                  count  = pos.count;
                  node   = node_t.make_inner_sr_n(count, pos.relaxed);

                  ns = position_args(Pos, derived_ns, Fn, RetT);
                  child = ns.towards_oh(pos, idx, offset, fn);

                  node_t.do_copy_inner_replace_sr(
                      node, pos.node, count, offset, child);

                  return  node;
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_regular: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_regular_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   Pos.instantiate_towards_oh_ch(derived_ns, Fn, RetT),
                   )

              inlinehint
              visit_regular: (args: ArgsT) ~> RetT
              {
                  pos = args[0];
                  idx = args[1][0];
                  fn  = args[1][1];

                  offset = pos.index(idx);
                  count  = pos.count;
                  node   = node_t.make_inner_n(count);

                  ns = position_args(Pos, derived_ns, Fn, RetT);
                  child = ns.towards_oh_ch(pos, idx, offset, count, fn);

                  node_t.do_copy_inner_replace(
                      node, pos.node, count, offset, child);

                  return  node;
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_leaf_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   instantiate_conditional_initialize(value_t),
                   instantiate_conditional_copy(value_t),
                   )

              inlinehint
              visit_leaf: (args: ArgsT) ~> RetT
              {
                  pos = args[0];
                  idx = args[1][0];
                  fn  = args[1][1];

                  offset = pos.index(idx);
                  count  = pos.count;
                  node   = node_t.make_leaf_n(count);

                  dst = node->leaf;
                  src = pos.node->leaf;

                  using namespace util(value_t);

                  conditional_initialize(dst, count);
                  conditional_copy(dst, src, offset);

                  dst[offset] := fn(src[offset]);           //- ...

                  off1 = offset + 1;
                  conditional_copy(dst + off1, src + off1, count - off1);

                  return  node;
              }

            #endif
          }

        'unit_defn_list'}

      #endif
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- dec_visitor
//---------------------------------------------------------------------
namespace dec_visitor
{
    #do (instantiate_visitor_base(dec_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (RetT == void)

          #do (instantiate_args(ArgsT, RetT))

          Pos    = ArgsT;
          node_t = ArgsT.node_t;

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_relaxed: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_relaxed_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_each(derived_ns, struct {}),
               )

          alwaysinline
          visit_relaxed: (pos: Pos) ~> void
          {
              node = pos.node;

              if (node.dec)
              {
                  ns = position_args(Pos, derived_ns, struct {});
                  ns.each(pos, {});

                  node_t.delete_inner_r(node, pos.count);
              }
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_regular: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_regular_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_each(derived_ns, struct {}),
               )

          alwaysinline
          visit_regular: (pos: Pos) ~> void
          {
              node = pos.node;

              if (node.dec)
              {
                  ns = position_args(Pos, derived_ns, struct {});
                  ns.each(pos, {});

                  node_t.delete_inner(node, pos.count);
              }
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (pos: Pos) ~> void
          {
              node = pos.node;

              if (node.dec)
              {
                  node_t.delete_leaf(node, pos.count);
              }
          }

        #endif
      }

    'unit_defn_list'}
}


