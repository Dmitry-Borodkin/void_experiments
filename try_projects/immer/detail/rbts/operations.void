          alwaysinline
          visit_leaf: (args: ArgsT) ~> void
          {
              pos   = args[0];
              first = args[1];
              fn    = args[2];

              data = pos.node->leaf;
              f    = pos.index(first);
              fn(data + f, data + pos.count);
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
//- for_each_chunk_i_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_i_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_i_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 4)
          #assert (ArgsT.element_types[1] == size_t)
          #assert (ArgsT.element_types[2] == size_t)
          #assert (RetT == void)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[3];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_relaxed: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_relaxed_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_towards_oh_sbh(derived_ns, Fn),
               Pos.instantiate_towards_oh(for_each_chunk_right_visitor, Fn),
               Pos.instantiate_each_i(for_each_chunk_visitor, Fn),
               Pos.instantiate_towards_oh(for_each_chunk_left_visitor, Fn),
               )

          alwaysinline
          visit_relaxed: (args: ArgsT) ~> void
          {
              pos   = args[0];
              first = args[1];
              last  = args[2];
              fn    = args[3];

              f = pos.index(first);
              l = pos.index(last - 1);

              if (f == l)
              {
                  sbh = pos.size_before(f);

                  ns = position_args(Pos, derived_ns, Fn);
                  ns.towards_oh_sbh(pos, first, f, sbh, last - sbh, fn);
              }
              else
              {
                  v_assert(f < l);

                  ns = position_args(Pos, for_each_chunk_right_visitor, Fn);
                  ns.towards_oh(pos, first, f, fn);

                  ns = position_args(Pos, for_each_chunk_visitor, Fn);
                  ns.each_i(pos, f + 1, l, fn);

                  ns = position_args(Pos, for_each_chunk_left_visitor, Fn);
                  ns.towards_oh(pos, last - 1, l, fn);
              }
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_regular: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_regular_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_towards_oh(derived_ns, Fn),
               Pos.instantiate_towards_oh(for_each_chunk_right_visitor, Fn),
               Pos.instantiate_each_i(for_each_chunk_visitor, Fn),
               Pos.instantiate_towards_oh(for_each_chunk_left_visitor, Fn),
               )

          alwaysinline
          visit_regular: (args: ArgsT) ~> void
          {
              pos   = args[0];
              first = args[1];
              last  = args[2];
              fn    = args[3];

              if (first < last)
              {
                  f = pos.index(first);
                  l = pos.index(last - 1);

                  if (f == l)
                  {
                      ns = position_args(Pos, derived_ns, Fn);
                      ns.towards_oh(pos, first, f, last, fn);
                  }
                  else
                  {
                      v_assert(f < l);

                      ns = position_args(Pos, for_each_chunk_right_visitor, Fn);
                      ns.towards_oh(pos, first, f, fn);

                      ns = position_args(Pos, for_each_chunk_visitor, Fn);
                      ns.each_i(pos, f + 1, l, fn);

                      ns = position_args(Pos, for_each_chunk_left_visitor, Fn);
                      ns.towards_oh(pos, last - 1, l, fn);
                  }
              }
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (args: ArgsT) ~> void
          {
              pos   = args[0];
              first = args[1];
              last  = args[2];
              fn    = args[3];

              data = pos.node->leaf;

              if (first < last)
              {
                  f = pos.index(first);
                  l = pos.index(last - 1);
                  fn(data + f, data + l + 1);
              }
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
//- for_each_chunk_p_left_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_left_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_p_left_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 3)
          #assert (ArgsT.element_types[1] == size_t)
          #assert (RetT == bool)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[2];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_inner_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_each_pred_left(for_each_chunk_p_visitor, Fn),
               Pos.instantiate_towards_oh(derived_ns, Fn, bool),
               )

          alwaysinline
          visit_inner: (args: ArgsT) ~> bool
          {
              pos  = args[0];
              last = args[1];
              fn   = args[2];

              l = pos.index(last);

              ns = position_args(Pos, for_each_chunk_p_visitor, Fn);
              if (!ns.each_pred_left(pos, last, l, fn))  return  false;

              ns = position_args(Pos, derived_ns, Fn, bool);
              return  ns.towards_oh(pos, last, l, fn);
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (args: ArgsT) ~> bool
          {
              pos  = args[0];
              last = args[1];
              fn   = args[2];

              data = pos.node->leaf;
              l    = pos.index(last);
              return  fn(data, data + l + 1);
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
//- for_each_chunk_p_right_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_right_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_p_right_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 3)
          #assert (ArgsT.element_types[1] == size_t)
          #assert (RetT == bool)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[2];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_inner_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_towards_oh(derived_ns, Fn, bool),
               Pos.instantiate_each_pred_right(for_each_chunk_p_visitor, Fn),
               )

          alwaysinline
          visit_inner: (args: ArgsT) ~> bool
          {
              pos   = args[0];
              first = args[1];
              fn    = args[2];

              f = pos.index(first);

              ns = position_args(Pos, derived_ns, Fn, bool);
              if (!ns.towards_oh(pos, first, f, fn))  return  false;

              ns = position_args(Pos, for_each_chunk_p_visitor, Fn);
              return  ns.each_pred_right(pos, f + 1, fn);
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (args: ArgsT) ~> bool
          {
              pos   = args[0];
              first = args[1];
              fn    = args[2];

              data = pos.node->leaf;
              f    = pos.index(first);
              return  fn(data + f, data + pos.count);
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
//- for_each_chunk_p_i_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_p_i_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_p_i_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 4)
          #assert (ArgsT.element_types[1] == size_t)
          #assert (ArgsT.element_types[2] == size_t)
          #assert (RetT == bool)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[3];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_relaxed: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_relaxed_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_towards_oh_sbh(derived_ns, Fn, bool),
               Pos.instantiate_towards_oh(for_each_chunk_p_right_visitor, Fn, bool),
               Pos.instantiate_each_pred_i(for_each_chunk_p_visitor, Fn),
               Pos.instantiate_towards_oh(for_each_chunk_p_left_visitor, Fn, bool),
               )

          alwaysinline
          visit_relaxed: (args: ArgsT) ~> bool
          {
              pos   = args[0];
              first = args[1];
              last  = args[2];
              fn    = args[3];

              if (first < last)
              {
                  f = pos.index(first);
                  l = pos.index(last - 1);

                  if (f == l)
                  {
                      sbh = pos.size_before(f);

                      ns = position_args(Pos, derived_ns, Fn, bool);
                      return  ns.towards_oh_sbh(pos, first, f, sbh, last - sbh, fn);
                  }
                  else
                  {
                      v_assert(f < l);

                      ns = position_args(Pos, for_each_chunk_p_right_visitor, Fn, bool);
                      if (!ns.towards_oh(pos, first, f, fn))  return  false;

                      ns = position_args(Pos, for_each_chunk_p_visitor, Fn, bool);
                      if (!ns.each_pred_i(pos, f + 1, l, fn))  return  false;

                      ns = position_args(Pos, for_each_chunk_p_left_visitor, Fn, bool);
                      return  ns.towards_oh(pos, last - 1, l, fn);
                  }
              }

              return  true;
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_regular: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_regular_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_towards_oh(derived_ns, Fn, bool),
               Pos.instantiate_towards_oh(for_each_chunk_p_right_visitor, Fn, bool),
               Pos.instantiate_each_pred_i(for_each_chunk_p_visitor, Fn, bool),
               Pos.instantiate_towards_oh(for_each_chunk_p_left_visitor, Fn, bool),
               )

          alwaysinline
          visit_regular: (args: ArgsT) ~> bool
          {
              pos   = args[0];
              first = args[1];
              last  = args[2];
              fn    = args[3];

              if (first < last)
              {
                  f = pos.index(first);
                  l = pos.index(last - 1);

                  if (f == l)
                  {
                      ns = position_args(Pos, derived_ns, Fn);
                      return  ns.towards_oh(pos, first, f, last, fn);
                  }
                  else
                  {
                      v_assert(f < l);

                      ns = position_args(Pos, for_each_chunk_p_right_visitor, Fn, bool);
                      if (!ns.towards_oh(pos, first, f, fn))  return  false;

                      ns = position_args(Pos, for_each_chunk_p_visitor, Fn, bool);
                      if (!ns.each_i(pos, f + 1, l, fn))  return  false;

                      ns = position_args(Pos, for_each_chunk_p_left_visitor, Fn, bool);
                      return  ns.towards_oh(pos, last - 1, l, fn);
                  }
              }

              return  true;
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (args: ArgsT) ~> bool
          {
              pos   = args[0];
              first = args[1];
              last  = args[2];
              fn    = args[3];

              data = pos.node->leaf;

              if (first < last)
              {
                  f = pos.index(first);
                  l = pos.index(last - 1);
                  return  fn(data + f, data + l + 1);
              }

              return  true;
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
