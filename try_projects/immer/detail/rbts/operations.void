namespace equals_visitor
{
    #do (instantiate_visitor_base(equals_visitor))

    namespace this_aux_ns
    {
        #do (instantiate_visitor_base(this_aux_ns))

        #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(args_derived_ns))

              #assert (ArgsT.is_struct  &&  ArgsT.element_count == 5)
              #assert (ArgsT.element_types[1] == count_t)
              #assert (ArgsT.element_types[4] == size_t)
              #assert (RetT == bool)

              #do (instantiate_args(ArgsT, RetT))

              PosR = ArgsT.element_types[0];
              PosL = ArgsT.element_types[2];
              Iter = ArgsT.element_types[3];

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_inner_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   PosL.instantiate_nth_sub(equals_visitor, struct {PosR; Iter; size_t;}, RetT),
                   )

              alwaysinline
              visit_inner: (args: ArgsT) ~> bool
              {
                  posr  = args[0];
                  i     = args[1];
                  posl  = args[2];
                  first = args[3];
                  idx   = args[4];

                  ns = position_args(PosL, equals_visitor, struct {PosR; Iter; size_t;}, RetT);
                  return  ns.nth_sub(posl, i, {posr, first, idx});
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_leaf_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   PosL.instantiate_nth_sub_leaf(equals_visitor, struct {PosR; Iter; size_t;}, RetT),
                   )

              alwaysinline
              visit_leaf: (args: ArgsT) ~> bool
              {
                  posr  = args[0];
                  i     = args[1];
                  posl  = args[2];
                  first = args[3];
                  idx   = args[4];

                  ns = position_args(PosL, equals_visitor, struct {PosR; Iter; size_t;}, RetT);
                  return  ns.nth_sub_leaf(posl, i, {posr, first, idx});
              }

            #endif
          }

        'unit_defn_list'}
    }

    namespace rrb
    {
        #do (instantiate_visitor_base(rrb))

        #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(args_derived_ns))

              #assert (ArgsT.is_struct  &&  ArgsT.element_count == 5)
              #assert (ArgsT.element_types[2].is_pointer)
              #assert (ArgsT.element_types[3] == shift_t)
              #assert (ArgsT.element_types[4] == size_t)
              #assert (RetT == bool)

              #do (instantiate_args(ArgsT, RetT))

              PosR = ArgsT.element_types[0];
              Iter = ArgsT.element_types[1];
              Node = ArgsT.element_types[2].element_type;

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_node: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_node_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   instantiate_visit_maybe_relaxed_sub(Node, equals_visitor, struct {PosR; Iter; size_t;}, RetT),
                   PosR.instantiate_first_sub_inner(rrb, struct {Iter; *Node; shift_t; size_t;}, RetT),
                   )

              alwaysinline
              visit_node: (args: ArgsT) ~> bool
              {
                  posr   = args[0];
                  first  = args[1];
                  rootl  = args[2];
                  shiftl = args[3];
                  sizel  = args[4];

                  v_assert(shiftl <= posr.shift);

                  if (shiftl == posr.shift)
                  {
                      ns = relaxed_sub_args(Node, equals_visitor, struct {PosR; Iter; size_t;}, RetT);
                      return  ns.visit_maybe_relaxed_sub(rootl, shiftl, sizel, {posr, first, 0});
                  }
                  else
                  {
                      ns = position_args(PosR, rrb, struct {Iter; *Node; shift_t; size_t;}, RetT);
                      return  ns.first_sub_inner(posr, {first, rootl, shiftl, sizel});
                  }
              }

            #endif
          }

        'unit_defn_list'}
    }












