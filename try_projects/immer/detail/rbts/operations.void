              #assert (ArgsT.element_types[1].element_types[1].is_pointer)
              #assert (ArgsT.element_types[1].element_types[2] == shift_t)
              #assert (ArgsT.element_types[1].element_types[3] == size_t)
              #assert (RetT == bool)

