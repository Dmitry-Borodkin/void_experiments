//---------------------------------------------------------------------
//- for_each_chunk_left_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_left_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_left_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
          #assert (ArgsT.element_types[0].node_t == node_t)
          #assert (ArgsT.element_types[1].is_struct)
          #assert (ArgsT.element_types[1].element_count == 2)
          #assert (ArgsT.element_types[1].element_types[0] == size_t)
          #assert (RetT == void)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[1].element_types[1];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_inner_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_each_left(for_each_chunk_visitor, Fn),
               Pos.instantiate_towards_oh(derived_ns, Fn),
               )

          alwaysinline
          visit_inner: (args: ArgsT) ~> void
          {
              pos  = args[0];
              last = args[1][0];
              fn   = args[1][1];

              l = pos.index(last);

              ns = position_args(Pos, for_each_chunk_visitor, Fn);
              ns.each_left(pos, l, fn);

              ns = position_args(Pos, derived_ns, Fn);
              ns.towards_oh(pos, last, l, fn);
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_leaf_ns))

          #do (instantiate_args_derived(ArgsT, RetT))

          alwaysinline
          visit_leaf: (args: ArgsT) ~> void
          {
              pos  = args[0];
              last = args[1][0];
              fn   = args[1][1];

              data = pos.node->leaf;
              l    = pos.index(last);
              fn(data, data + l + 1);
          }

        #endif
      }

    'unit_defn_list'}
}


//---------------------------------------------------------------------
//- for_each_chunk_right_visitor
//---------------------------------------------------------------------
namespace for_each_chunk_right_visitor
{
    #do (instantiate_visitor_base(for_each_chunk_right_visitor))

    #define instantiate_args_derived: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(args_derived_ns))

          #assert (ArgsT.is_struct  &&  ArgsT.element_count == 2)
          #assert (ArgsT.element_types[0].node_t == node_t)
          #assert (ArgsT.element_types[1].is_struct)
          #assert (ArgsT.element_types[1].element_count == 2)
          #assert (ArgsT.element_types[1].element_types[0] == size_t)
          #assert (RetT == void)

          #do (instantiate_args(ArgsT, RetT))

          Pos = ArgsT.element_types[0];
          Fn  = ArgsT.element_types[1].element_types[1];

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_inner: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
        #if (v_guard_ns(visit_inner_ns))

          #do (instantiate_args_derived(ArgsT, RetT),
               Pos.instantiate_towards_oh(derived_ns, Fn),
               Pos.instantiate_each_right(for_each_chunk_visitor, Fn),
               )

          alwaysinline
          visit_inner: (args: ArgsT) ~> void
          {
              pos   = args[0];
              first = args[1][0];
              fn    = args[1][1];

              f = pos.index(first);

              ns = position_args(Pos, derived_ns, Fn);
              ns.towards_oh(pos, first, f, fn);

              ns = position_args(Pos, for_each_chunk_visitor, Fn);
              ns.each_right(pos, f + 1, fn);
          }

        #endif
      }

    'unit_defn_list'}

    #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
    {'unit_defn_list'

      namespace visitor_args(derived_ns, ArgsT, RetT)
      {
