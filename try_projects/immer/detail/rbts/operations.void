            #if (v_guard_ns(visit_inner_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   PosT.instantiate_towards(derived_ns, size_t, RetT),
                   )

              alwaysinline
              visit_inner: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  ns = position_args(PosT, derived_ns, size_t, RetT);
                  ns.towards(pos, idx)
              };

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit_leaf: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_leaf_ns))

              #do (instantiate_args_derived(ArgsT, RetT))

              alwaysinline
              visit_leaf: (args: ArgsT) ~> RetT  =
              {
                  pos = args[0];
                  idx = args[1];

                  {pos.node->leaf, pos.index(idx), pos.count}
              };

            #endif
          }

        'unit_defn_list'}

      #endif
    }

'unit_defn_list'}


