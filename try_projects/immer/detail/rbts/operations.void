        #define instantiate_visit_node: [](ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace visitor_args(derived_ns, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_node_ns))

              #do (instantiate_args_derived(ArgsT, RetT),
                   instantiate_visit_maybe_relaxed_sub(Node, equals_visitor, struct {PosR; Iter; size_t;}, RetT),
                   PosR.instantiate_first_sub_inner(rrb, struct {Iter; *Node; shift_t; size_t;}, RetT),
                   )

              alwaysinline
              visit_node: (args: ArgsT) ~> bool
              {
                  posr   = args[0];
                  first  = args[1][0];
                  rootl  = args[1][1];
                  shiftl = args[1][2];
                  sizel  = args[1][3];

                  v_assert(shiftl <= posr.shift);

                  if (shiftl == posr.shift)
                  {
                      ns = relaxed_sub_args(Node, equals_visitor, struct {PosR; Iter; size_t;}, RetT);
                      return  ns.visit_maybe_relaxed_sub(rootl, shiftl, sizel, {posr, first, 0});
                  }
                  else
                  {
                      ns = position_args(PosR, rrb, struct {Iter; *Node; shift_t; size_t;}, RetT);
                      return  ns.first_sub_inner(posr, {first, rootl, shiftl, sizel});
                  }
              }

            #endif
          }

        'unit_defn_list'}
