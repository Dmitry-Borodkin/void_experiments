{'unit_defn_list'

  namespace dec_args(NodeT)
  {
    #if (v_guard_ns(dec_leaf_ns))

      #do (instantiate_leaf_sub_pos(NodeT),
           position(NodeT).leaf_sub_pos.instantiate_visit(dec_visitor, struct {}),
           )

      linkonce_odr
      dec_leaf: (node: NodeT, n: count_t) ~> void
      {
          ns = position_args(leaf_sub_pos, dec_visitor, struct {});
          ns.visit(make_leaf_sub_pos(node, n), {});
      }

    #endif
  }

'unit_defn_list'}

