//---------------------------------------------------------------------
//- relaxed_pos
//---------------------------------------------------------------------
#define instantiate_relaxed_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

  namespace position(NodeT)
  {
    struct relaxed_pos;

    #if (v_guard_ns(relaxed_pos))

      struct relaxed_pos
      {
          node_:    *NodeT;
          shift_:   shift_t;
          relaxed_: *relaxedt;
      };

      relaxed_pos.node_t    = NodeT;
      relaxed_pos.relaxed_t = NodeT.relaxed_t;
      relaxed_pos.B         = NodeT.bits;
      relaxed_pos.BL        = NodeT.bits_leaf;

      alwaysinline
      (_.count): (pos: relaxed_pos) ~> count_t  =  pos.relaxed_->d.count;

      alwaysinline
      (_.node): (pos: relaxed_pos) ~> *NodeT  =  pos.node_;

      alwaysinline
      (_.size): (pos: relaxed_pos) ~> size_t  =  pos.relaxed_->d.sizes[pos.relaxed_->d.count - 1];

      alwaysinline
      (_.shift): (pos: relaxed_pos) ~> shift_t  =  pos.shift_;

      inlinehint
      (_.index()): (pos: relaxed_pos, idx: size_t) ~> count_t  =
      {
          offset: &count_t := (idx >> pos.shift_ : count_t);

          while (pos.relaxed_->d.sizes[offset] <= idx)  ++offset;

          offset
      };

      alwaysinline
      (_.subindex()): (pos: relaxed_pos, idx: size_t) ~> count_t  =  pos.index(idx);

      alwaysinline
      (_.relaxed): (pos: relaxed_pos) ~> *relaxed_t  =  pos.relaxed_;

      alwaysinline
      (_.size_before()): (pos: relaxed_pos, offset: count_t) ~> size_t
      {
          if (offset)  return  pos.relaxed_->d.sizes[offset - 1];
          else         return  0;
      }

      alwaysinline
      (_.size_sbh()): (pos: relaxed_pos, offset: count_t, size_before_hint: size_t) ~> size_t
      {
          v_assert(size_before_hint == pos.size_before(offset));
          return  pos.relaxed_->d.sizes[offset] - size_before_hint;
      }

      alwaysinline
      (_.size()): (pos: relaxed_pos, offset: count_t) ~> size_t
        =  pos.size_sbh(offset, pos.size_before(offset));

      inlinehint
      (_.copy_sizes()): (pos: relaxed_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
      {
          e = sizes + n;
          prev:  &size_t  := pos.size_before(offset);
          these: &*size_t := pos.relaxed_->d.sizes + offset;
          sizes: &*size_t := sizes;
          init:  &size_t  := init;
          for (; sizes != e; ++sizes, ++these)
          {
              this_size = *these;
              init := *sizes := init + (this_size - prev);
              v_assert(init);
              prev := this_size;
          }
      }


      namespace relaxed_pos
      {
        using namespace position(NodeT);

        #define instantiate_each: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(relaxed_pos, Vis, ArgsT)
          {
            #if (v_guard_ns(each_ns))

              #do (instantiate_each_left(relaxed_pos, Vis, ArgsT))

              alwaysinline
              each: (pos: relaxed_pos, args: ArgsT) ~> void
              {
                  each_left(pos, pos.relaxed_->d.count, args);
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_each_pred: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(relaxed_pos, Vis, ArgsT, bool)
          {
            #if (v_guard_ns(each_pred_ns))

              private NT = node_t;          //- ?

              #do (instantiate_leaf_sub_pos(NT), position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, bool),
                   instantiate_visit_maybe_relaxed_sub(NT, Vis, ArgsT, bool),
                   )

              inlinehint
              each_pred: (pos: relaxed_pos, args: ArgsT) ~> bool
              {
                  p = pos.node_->inner;
                  n = pos.count;
                  s: &size_t := 0;

                  if (pos.shift_ == BL)
                  {
                      for (i: &count_t := 0; i < n; ++i)
                      {
                          ns = position_args(leaf_sub_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_leaf_sub_pos(p[i], pos.relaxed_->d.sizes[i] - s), args))  return  false;
                          s := pos.relaxed_->d.sizes[i];
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;
                      for (i: &count_t := 0; i < n; ++i)
                      {
                          ns = relaxed_sub_args(NT, Vis, ArgsT, bool);
                          if (!ns.visit_maybe_relaxed_sub(p[i], ss, pos.relaxed_->d.sizes[i] - s, args))  return  false;
                          s := pos.relaxed_->d.sizes[i];
                      }
                  }

                  return  true;
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_each_pred_i: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(relaxed_pos, Vis, ArgsT, bool)
          {
            #if (v_guard_ns(each_pred_i_ns))

              private NT = node_t;          //- ?

              #do (instantiate_leaf_sub_pos(NT), position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, bool),
                   instantiate_visit_maybe_relaxed_sub(NT, Vis, ArgsT, bool),
                   )

              inlinehint
              each_pred_i: (pos: relaxed_pos, i: count_t, n: count_t, args: ArgsT) ~> bool
              {
                  p = pos.node_->inner;
                  s: &size_t := undef;
                  if (i > 0)  s := pos.relaxed_->d.sizes[i - 1];
                  else        s := 0;

                  if (pos.shift_ == BL)
                  {
                      for (i: &count_t := i; i < n; ++i)
                      {
                          ns = position_args(leaf_sub_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_leaf_sub_pos(p[i], pos.relaxed_->d.sizes[i] - s), args))  return  false;
                          s := pos.relaxed_->d.sizes[i];
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;
                      for (i: &count_t := i; i < n; ++i)
                      {
                          ns = relaxed_sub_args(NT, Vis, ArgsT, bool);
                          if (!ns.visit_maybe_relaxed_sub(p[i], ss, pos.relaxed_->d.sizes[i] - s, args))  return  false;
                          s := pos.relaxed_->d.sizes[i];
                      }
                  }

                  return  true;
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_each_pred_left: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(relaxed_pos, Vis, ArgsT, bool)
          {
            #if (v_guard_ns(each_pred_left_ns))

              private NT = node_t;          //- ?

              #do (instantiate_leaf_sub_pos(NT), position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, bool),
                   instantiate_visit_maybe_relaxed_sub(NT, Vis, ArgsT, bool),
                   )

              inlinehint
              each_pred_left: (pos: relaxed_pos, n: count_t, args: ArgsT) ~> bool
              {
                  p = pos.node_->inner;
                  s: &size_t := 0;

                  if (pos.shift_ == BL)
                  {
                      for (i: &count_t := 0; i < n; ++i)
                      {
                          ns = position_args(leaf_sub_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_leaf_sub_pos(p[i], pos.relaxed_->d.sizes[i] - s), args))  return  false;
                          s := pos.relaxed_->d.sizes[i];
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;
                      for (i: &count_t := 0; i < n; ++i)
                      {
                          ns = relaxed_sub_args(NT, Vis, ArgsT, bool);
                          if (!ns.visit_maybe_relaxed_sub(p[i], ss, pos.relaxed_->d.sizes[i] - s, args))  return  false;
                          s := pos.relaxed_->d.sizes[i];
                      }
                  }

                  return  true;
              }

            #endif
          }

