              alwaysinline
              towards_oh: (pos: regular_pos, idx: size_t, offset_hint: count_t, args: ArgsT) ~> RetT
              {
                  v_assert(offset_hint == pos.index(idx));
                  left_size: &size_t := undef;
                  if (offset_hint)  left_size := pos.relaxed_->d.sizes[offset_hint - 1];
                  else              left_size := 0;

                  return  towards_oh_sbh(pos, idx, offset_hint, left_size, args);
              }

            #endif
          }

