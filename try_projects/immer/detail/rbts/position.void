            B  = bits(Pos);
            BL = bits_leaf(Pos);

            v_assert(offset_hint == p.index(idx));

            is_leaf = p.shift == BL;
            child   = p.node->inner[offset_hint];
            lsize   = offset_hint << p.shift;
            size    = p.this_size;
            is_full = (size - lsize) >= ((1: size_t) << p.shift);

            if (is_full)
            {
                if (is_leaf)
                {
                    ns = position_args(full_leaf_pos, Vis, AT, RetT);
                    return  ns.visit(make_full_leaf_pos(child), {idx - lsize, args});
                }
                else
                {
                    ns = position_args(full_pos, Vis, AT, RetT);
                    return  ns.visit(make_full_pos(child, p.shift - B), {idx - lsize, args});
                }
            }
            else
            {
                if (is_leaf)
                {
                    ns = position_args(leaf_sub_pos, Vis, AT, RetT);
                    return  ns.visit(make_leaf_sub_pos(child, p.size - lsize), {idx - lsize, args});
                }
                else
                {
                    ns = position_args(regular_sub_pos, Vis, AT, RetT);
                    return  ns.visit(make_regular_sub_pos(child, p.shift - B, size - lsize), {idx - lsize, args});
                }
            }
        }

      #endif
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define instantiate_last_oh_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                        ArgsT: v_static_type_t, RetT: v_static_type_t = void)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT, RetT)
    {
      #if (v_guard_ns(last_oh_regular_ns))

        private
        NT = node_type(Pos);

        #do (instantiate_leaf_pos(NT),    position(NT).leaf_pos.instantiate_visit(Vis, ArgsT, RetT),
             instantiate_regular_pos(NT), position(NT).regular_pos.instantiate_visit(Vis, ArgsT, RetT),
             )

        linkonce_odr
        last_oh_regular: (p: Pos, offset_hint: count_t, args: ArgsT) ~> RetT
        {
            using namespace position(NT);

            B  = bits(Pos);
            BL = bits_leaf(Pos);

            v_assert(offset_hint == p.count - 1);

            is_leaf = p.shift == BL;
            child   = p.node->inner[offset_hint];

            if (is_leaf)
            {
                ns = position_args(leaf_pos, Vis, ArgsT, RetT);
                return  ns.visit(make_leaf_pos(child, p.size), args);
            }
            else
            {
                ns = position_args(regular_pos, Vis, ArgsT, RetT);
                return  ns.visit(make_regular_pos(child, p.shift - B, p.size), args);
            }
        }

      #endif
    }

'unit_defn_list'}


