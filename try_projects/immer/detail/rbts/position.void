          else                                        return  (1: size_t) << pos.shift_;
      }

      inlinehint
      (_.copy_sizes()): (pos: regular_sub_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
      {
          if (n == 0) return;

          last = offset + n - 1;
          e    = sizes  + n - 1;

          sizes: &*size_t := sizes;
          init:  &size_t  := init;

          for (; sizes != e; ++sizes)
          {
              init := *sizes := init + ((1: size_t) << pos.shift_);
              v_assert(init);
