#define instantiate_towards_oh_ch_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                              ArgsT: v_static_type_t, RetT: v_static_type_t = void)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT, RetT)
    {
      #if (v_guard_ns(towards_oh_ch_regular_ns))

        private NT = node_type(Pos);
        private AT = struct { size_t; ArgsT; };

        #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, AT, RetT),
             instantiate_full_pos(NT),      position(NT).full_pos.instantiate_visit(Vis, AT, RetT),
             instantiate_leaf_pos(NT),      position(NT).leaf_pos.instantiate_visit(Vis, AT, RetT),
             instantiate_regular_pos(NT),   position(NT).regular_pos.instantiate_visit(Vis, AT, RetT),
             )

        linkonce_odr
        towards_oh_ch_regular: (p: Pos,
                                idx: size_t,
                                offset_hint: count_t,
                                count_hint: count_t,
                                args: ArgsT) ~> RetT
        {
            using namespace position(NT);

            B  = bits(Pos);
            BL = bits_leaf(Pos);

            v_assert(offset_hint == p.index(idx));
            v_assert(count_hint == pcount);

            is_leaf = p.shift == BL;
            child   = p.node->inner[offset_hint];
            is_full = offset_hint + 1 != count_hint;

            if (is_full)
            {
                if (is_leaf)
                {
                    ns = position_args(full_leaf_pos, Vis, AT, RetT);
                    return  ns.visit(make_full_leaf_pos(child), {idx, args});
                }
                else
                {
                    ns = position_args(full_pos, Vis, AT, RetT);
                    return  ns.visit(make_full_pos(child, p.shift - B), {idx, args});
                }
            }
            else
            {
                if (is_leaf)
                {
                    ns = position_args(leaf_pos, Vis, AT, RetT);
                    return  ns.visit(make_leaf_pos(child, p.size), {idx, args});
                }
                else
                {
                    ns = position_args(regular_pos, Vis, AT, RetT);
                    return  ns.visit(make_regular_pos(child, p.shift - B, p.size), {idx, args});
                }
            }
        }

      #endif
    }

'unit_defn_list'}

