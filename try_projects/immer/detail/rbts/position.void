                   instantiate_leaf_sub_pos(NT),    position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_regular_sub_pos(NT), position(NT).regular_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   )

              inlinehint
              first_sub: (pos: regular_sub_pos, args: ArgsT) ~> RetT
              {
                  using namespace position(NT);

                  is_leaf = pos.shift_ == BL;
                  child   = pos.node_->inner[0];
                  is_full = pos.size_ >= ((1: size_t) << pos.shift_);

                  if (is_full)
                  {
                      if (is_leaf)
                      {
                          ns = position_args(full_leaf_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_full_leaf_pos(child), args);
                      }
                      else
                      {
                          ns = position_args(full_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_full_pos(child, pos.shift_ - B), args);
                      }
                  }
                  else
                  {
                      if (is_leaf)
                      {
                          ns = position_args(leaf_sub_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_leaf_sub_pos(child, pos.size_), args);
                      }
                      else
                      {
                          ns = position_args(regular_sub_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_regular_sub_pos(child, pos.shift_ - B, pos.size_), args);
                      }
                  }
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_first_sub_leaf: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(first_sub_leaf_ns))

              private
              NT = node_type(regular_sub_pos);

              #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_leaf_sub_pos(NT),  position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   )

              inlinehint
              first_sub_leaf: (pos: regular_sub_pos, args: ArgsT) ~> RetT
              {
                  using namespace position(NT);

                  v_assert(pos.shift_ == BL);
                  child   = pos.node_->inner[0];
                  is_full = pos.size_ >= branches(BL);

                  if (is_full)
                  {
                      ns = position_args(full_leaf_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_full_leaf_pos(child), args);
                  }
                  else
                  {
                      ns = position_args(leaf_sub_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_leaf_sub_pos(child, pos.size_), args);
                  }
              }

            #endif
