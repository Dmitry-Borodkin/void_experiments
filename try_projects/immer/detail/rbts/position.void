        'unit_defn_list'}

        #define instantiate_first_sub_inner: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(first_sub_inner_ns))

              private
              NT = node_type(regular_sub_pos);

              #do (instantiate_full_pos(NT),        position(NT).full_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_regular_sub_pos(NT), position(NT).regular_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   )

              inlinehint
              first_sub_inner: (pos: regular_sub_pos, args: ArgsT) ~> RetT
              {
                  using namespace position(NT);

                  v_assert(pos.shift_ == BL);
                  child   = pos.node_->inner[0];
                  is_full = pos.size_ >= branches(BL);

                  if (is_full)
                  {
                      ns = position_args(full_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_full_pos(child, pos.shift_ - B), args);
                  }
                  else
                  {
                      ns = position_args(regular_sub_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_regular_sub_pos(child, pos.shift_ - B, pos.size_), args);
                  }
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_nth_sub: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(nth_sub_ns))

              private
              NT = node_type(regular_sub_pos);

              #do (instantiate_full_leaf_pos(NT),   position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_full_pos(NT),        position(NT).full_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_leaf_sub_pos(NT),    position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_regular_sub_pos(NT), position(NT).regular_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   )

              inlinehint
              nth_sub: (pos: regular_sub_pos, idx: count_t, args: ArgsT) ~> RetT
              {
                  using namespace position(NT);

                  v_assert(idx < pos.count_);
                  is_leaf = pos.shift_ == BL;
                  child   = pos.node_->inner[idx];
                  lsize   = pos.size(idx);
                  is_full = idx + 1 < pos.count;

                  if (is_full)
                  {
                      if (is_leaf)
                      {
                          ns = position_args(full_leaf_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_full_leaf_pos(child), args);
                      }
                      else
                      {
                          ns = position_args(full_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_full_pos(child, pos.shift_ - B), args);
                      }
                  }
                  else
                  {
                      if (is_leaf)
                      {
                          ns = position_args(leaf_sub_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_leaf_sub_pos(child, lsize), args);
                      }
                      else
                      {
                          ns = position_args(regular_sub_pos, Vis, ArgsT, RetT);
                          return  ns.visit(make_regular_sub_pos(child, pos.shift_ - B, lsize), args);
                      }
                  }
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_nth_sub_leaf: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(nth_sub_leaf_ns))

              private
              NT = node_type(regular_sub_pos);

              #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_leaf_sub_pos(NT),  position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   )

              inlinehint
              nth_sub_leaf: (pos: regular_sub_pos, idx: count_t, args: ArgsT) ~> RetT
              {
                  using namespace position(NT);

                  v_assert(pos.shift_ == BL);
                  child   = pos.node_->inner[idx];
                  lsize   = pos.size(idx);
                  is_full = idx + 1 < pos.count;

                  if (is_full)
                  {
                      ns = position_args(full_leaf_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_full_leaf_pos(child), args);
                  }
                  else
                  {
                      ns = position_args(leaf_sub_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_leaf_sub_pos(child, lsize), args);
                  }
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_ns))

              #do (Vis.instantiate_visit_regular(struct {regular_sub_pos; ArgsT;}, RetT))

              alwaysinline
              visit: (pos: regular_sub_pos, args: ArgsT) ~> RetT
              {
                  ns = visitor_args(Vis, struct {regular_sub_pos; ArgsT;}, RetT);
                  return  ns.visit_regular({pos, args});
              }

            #endif
          }

        'unit_defn_list'}

      }     //- namespace regular_sub_pos


      alwaysinline
      make_regular_sub_pos: (node: *NodeT, shift: shift_t, size: size_t) ~> regular_sub_pos  =
      {
          v_assert(node);
          v_assert(shift >= NodeT.bits_leaf);
          v_assert(size > 0);
          v_assert(size <= (branches(NodeT.bits_leaf, size_t) << pos.shift_));
          {node, shift, size}
      };

    #endif

  }     //- namespace position(NodeT)

'unit_defn_list'}


//---------------------------------------------------------------------
#define position_shift: [](NodeT: v_static_type_t, Shift: shift_t) ~> v_static_namespace_t
  =  v_generic_ns(position_shift_ns, T(NodeT), N(Shift));

//---------------------------------------------------------------------
//- regular_descent_pos
//---------------------------------------------------------------------
#define instantiate_regular_descent_pos: [](NodeT: v_static_type_t, Shift: shift_t)
{'unit_defn_list'

  namespace position_shift(NodeT, Shift)
  {
    struct regular_descent_pos;

    #if (v_guard_ns(regular_descent_pos))

      #assert (Shift > 0  &&  "not leaf...")

      using namespace position(NodeT);

      struct regular_descent_pos
      {
          node_: *NodeT;
      };

      regular_descent_pos.node_t = NodeT;
      regular_descent_pos.B      = NodeT.bits;
      regular_descent_pos.BL     = NodeT.bits_leaf;

      alwaysinline
      (_.node): (pos: regular_descent_pos) ~> *NodeT  =  pos.node_;

      alwaysinline
      (_.shift): (regular_descent_pos) ~> shift_t  =  Shift;

      alwaysinline
      (_.index()): (regular_descent_pos, idx: size_t) ~> count_t  =  ((idx >> Shift) & mask(regular_descent_pos.BL) : count_t);


      namespace regular_descent_pos
      {
        using namespace position(NodeT);

        #define instantiate_descend: [](Vis: v_static_namespace_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_descent_pos, Vis, size_t, RetT)
          {
            #if (v_guard_ns(descend_ns))

              private
              NT = node_type(regular_descent_pos);

              #if (Shift == BL)

                #do (instantiate_leaf_descent_pos(NT),
                     position(NT).leaf_descent_pos.instantiate_visit(Vis, size_t, RetT))

              #else

                #do (instantiate_regular_descent_pos(NT, Shift - B),
                     position_shift(NT, Shift - B).regular_descent_pos.instantiate_visit(Vis, size_t, RetT))

              #endif

              alwaysinline
              descend: (pos: regular_descent_pos, idx: size_t) ~> RetT
              {
                  offset = pos.index(idx);
                  child  = pos.node_->inner[offset];

                  #if (Shift == BL)

                    ns = position_args(leaf_descent_pos, Vis, size_t, RetT);
                    return  ns.visit(make_leaf_descent_pos(child), idx);

                  #else

                    PT = position_shift(NT, Shift - B).regular_descent_pos;

                    ns = position_args(PT, Vis, size_t, RetT);
                    return  ns.visit({child}, idx);

                  #endif
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_descent_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_ns))

              #do (Vis.instantiate_visit_regular(struct {regular_descent_pos; ArgsT;}, RetT))

              alwaysinline
              visit: (pos: regular_descent_pos, args: ArgsT) ~> RetT
              {
                  ns = visitor_args(Vis, struct {regular_descent_pos; ArgsT;}, RetT);
                  return  ns.visit_regular({pos, args});
              }

            #endif
          }

        'unit_defn_list'}

      }     //- namespace regular_descent_pos

    #endif

  }     //- namespace position_shift(NodeT, Shift)

'unit_defn_list'}

//---------------------------------------------------------------------
#define regular_descent_args: [](NT: v_static_type_t, VS: v_static_namespace_t,
                                 RT: v_static_type_t = void) ~> v_static_namespace_t
  =  v_generic_ns(regular_descent_args_ns, Q(v_namespace_get_name(VS)), T[NT,RT]);

//---------------------------------------------------------------------
#define instantiate_visit_regular_descent: [](NodeT: v_static_type_t, Vis: v_static_namespace_t, RetT: v_static_type_t = void)
{'unit_defn_list'

  namespace regular_descent_args(NodeT, Vis, RetT)
  {
    #if (v_quard_ns())

      private NT = NodeT;
      private B  = NT.bits;
      private BL = NT.bits_leaf;

      private
      #define instantiate: (n)
      {'unit_defn_list'

          #do (instantiate_regular_descent_pos(NT, BL+B*n),
               position_shift(NT, BL+B*n).regular_descent_pos.instantiate_visit(Vis, size_t, RetT),
               )

      'unit_defn_list'}

      #do (instantiate(0),
           instantiate(1),
           instantiate(2),
           instantiate(3),
           instantiate(4),
           instantiate(5),
           instantiate_leaf_descent_pos(NT),
           position(NT).leaf_descent_pos.instantiate_visit(Vis, size_t, RetT)
           )

      linkonce_odr
      visit_regular_descent: (node: *NodeT, shift: shift_t, idx: size_t) ~> RetT
      {
          v_assert(node);
          v_assert(shift >= BL);

          #define doit: (n: shift_t)
          {'stmt'
            {
              PT = position_shift(NT, BL+B*n).regular_descent_pos;

              ns = position_args(PT, Vis, size_t, RetT);
              return  ns.visit({node}, idx);
            }
          'stmt'}

          switch(shift)
          {
          case BL+B*0:  doit(0);
          case BL+B*1:  doit(1);
          case BL+B*2:  doit(2);
          case BL+B*3:  doit(3);
          case BL+B*4:  doit(4);
          case BL+B*5:  doit(5);

          default:      //- IMMER_DESCENT_DEEP...
            {
              node: &*NT := node;

              for (level: &shift_t := sift; level != endshift(B, BL); level -= B)
              {
                  node := node->inner[(idx >> level) & mask(B)];
              }

              using namespace position(NT);

              ns = position_args(leaf_descent_pos, Vis, size_t, RetT);
              return  ns.visit(make_leaf_descent_pos(node), idx);
            }
          }
      }

    #endif

  }     //- namespace regular_descent_args(NodeT, Vis, RetT)

'unit_defn_list'}


//---------------------------------------------------------------------
//- full_pos
//---------------------------------------------------------------------
#define instantiate_full_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

  namespace position(NodeT)
  {
    struct full_pos;

    #if (v_guard_ns(full_pos))

      struct full_pos
      {
          node_:  *NodeT;
          shift_: shift_t;
      };

      full_pos.node_t = NodeT;
      full_pos.B      = NodeT.bits;
      full_pos.BL     = NodeT.bits_leaf;

      alwaysinline
      (_.count): (full_pos) ~> count_t  =  branches(full_pos.B);

      alwaysinline
      (_.node): (pos: full_pos) ~> *NodeT  =  pos.node_;

      alwaysinline
      (_.size): (pos: full_pos) ~> size_t  =  branches(full_pos.B, size_t) << pos.shift_;

      alwaysinline
      (_.shift): (pos: full_pos) ~> shift_t  =  pos.shift_;

      alwaysinline
      (_.index()): (pos: full_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(full_pos.B) : count_t);

      alwaysinline
      (_.subindex()): (pos: full_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

      alwaysinline
      (_.size()): (pos: full_pos, count_t) ~> size_t  =  (1: size_t) << pos.shift_;

      alwaysinline
      (_.size_sbh()): (pos: full_pos, count_t, size_t) ~> size_t  =  (1: size_t) << pos.shift_;

      alwaysinline
      (_.size_before()): (pos: full_pos, offset: count_t) ~> size_t  =  (offset: size_t) << pos.shift_;

      inlinehint
      (_.copy_sizes()): (pos: full_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
      {
          e = sizes + n;

          sizes: &*size_t := sizes;
          init:  &size_t  := init;

          for (; sizes != e; ++sizes)
          {
              init := *sizes := init + ((1: size_t) << pos.shift_);
              v_assert(init);
          }
      }


      namespace full_pos
      {
        using namespace position(NodeT);

        #define instantiate_each: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(full_pos, Vis, ArgsT)
          {
            #if (v_guard_ns(each_ns))

              private
              NT = node_type(full_pos);

              #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT),
                   instantiate_full_pos(NT),      position(NT).full_pos.instantiate_visit(Vis, ArgsT),
                   )

              inlinehint
              each: (pos: full_pos, args: ArgsT) ~> void
              {
                  p: &*NT := pos.node_->inner;
                  e        = p + branches(B);

                  if (pos.shift_ == BL)
                  {
                      for (; p != e; ++p)
                      {
                          ns = position_args(full_leaf_pos, Vis, ArgsT);
                          ns.visit(make_full_leaf_pos(*p), args);
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;

                      for (; p != e; ++p)
                      {
                          ns = position_args(full_pos, Vis, ArgsT);
                          ns.visit(make_full_pos(*p, ss), args);
                      }
                  }
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_each_pred: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(full_pos, Vis, ArgsT, bool)
          {
            #if (v_guard_ns(each_pred_ns))

              private
              NT = node_type(full_pos);

              #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, bool),
                   instantiate_full_pos(NT),      position(NT).full_pos.instantiate_visit(Vis, ArgsT, bool),
                   )

              inlinehint
              each_pred: (pos: full_pos, args: ArgsT) ~> bool
              {
                  p: &*NT := pos.node_->inner;
                  e        = p + branches(B);

                  if (pos.shift_ == BL)
                  {
                      for (; p != e; ++p)
                      {
                          ns = position_args(full_leaf_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_full_leaf_pos(*p), args))  return false;
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;

                      for (; p != e; ++p)
                      {
                          ns = position_args(full_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_full_pos(*p, ss), args))   return false;
                      }
                  }

                  return true;
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_each_pred_zip: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(full_pos, Vis, ArgsT, bool)
          {
            #if (v_guard_ns(each_pred_zip_ns))

              private NT = node_type(full_pos);
              private AT = struct { *NT; ArgsT; };

              #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, AT, bool),
                   instantiate_full_pos(NT),      position(NT).full_pos.instantiate_visit(Vis, AT, bool),
                   )

              inlinehint
              each_pred_zip: (pos: full_pos, other: *NT, args: ArgsT) ~> bool
              {
                  p:  &*NT := pos.node_->inner;
                  p2: &*NT := other->inner;
                  e         = p + branches(B);

                  if (pos.shift_ == BL)
                  {
                      for (; p != e; ++p, ++p2)
                      {
                          ns = position_args(full_leaf_pos, Vis, AT, bool);
                          if (!ns.visit(make_full_leaf_pos(*p), {*p2, args}))  return false;
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;

                      for (; p != e; ++p, ++p2)
                      {
                          ns = position_args(full_pos, Vis, AT, bool);
                          if (!ns.visit(make_full_pos(*p, ss), {*p2, args}))  return false;
                      }
                  }

                  return true;
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_each_pred_i: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t)
        {'unit_defn_list'

          namespace position_args(full_pos, Vis, ArgsT, bool)
          {
            #if (v_guard_ns(each_pred_i_ns))

              private NT = node_type(full_pos);

              #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, bool),
                   instantiate_full_pos(NT),      position(NT).full_pos.instantiate_visit(Vis, ArgsT, bool),
                   )

              inlinehint
              each_pred_i: (pos: full_pos, i: count_t, n: count_t, args: ArgsT) ~> bool
              {
                  p: &*NT := pos.node_->inner + i;
                  e        = pos.node_->inner + n;

                  if (pos.shift_ == BL)
                  {
                      for (; p != e; ++p)
                      {
                          ns = position_args(full_leaf_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_full_leaf_pos(*p), args))  return false;
                      }
                  }
                  else
                  {
                      ss = pos.shift_ - B;

                      for (; p != e; ++p)
                      {
                          ns = position_args(full_pos, Vis, ArgsT, bool);
                          if (!ns.visit(make_full_pos(*p, ss), args))  return false;
                      }
                  }

                  return true;
              }

