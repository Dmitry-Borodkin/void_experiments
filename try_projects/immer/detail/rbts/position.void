        #define instantiate_towards_sub_oh_sbh: [](Vis: v_static_namespace_t,
                                                   ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(relaxed_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(towards_sub_oh_sbh_ns))

              private NT = node_t;          //- ?
              private AT = struct { size_t; ArgsT; };

              #do (instantiate_leaf_sub_pos(NT), position(NT).leaf_sub_pos.instantiate_visit(Vis, AT, RetT),
                   instantiate_visit_maybe_relaxed_sub(NT, Vis, AT, RetT),
                   )

              inlinehint
              towards_sub_oh_sbh: (pos: regular_pos,
                                   idx: size_t,
                                   offset_hint: count_t,
                                   left_size_hint: size_t,
                                   args: ArgsT) ~> RetT
              {
                  v_assert(offset_hint == pos.index(idx));
                  v_assert({ lsh: &size_t := undef;
                             if (offset_hint)  lsh := pos.relaxed_->d.sizes[offset_hint - 1];
                             else              lsh := 0;
                             left_size_hint == lsh });

                  child     = pos.node_->inner[offset_hint];
                  is_leaf   = pos.shift_ == BL;
                  next_size = pos.relaxed_->d.sizes[offset_hint] - left_size_hint;
                  next_idx  = idx - left_size_hint;

                  if (is_leaf)
                  {
                      ns = position_args(leaf_sub_pos, Vis, AT, RetT);
                      return  ns.visit(make_leaf_sub_pos(child, next_size), {next_idx, args});
                  }
                  else
                  {
                      ns = relaxed_sub_args(NT, Vis, AT, RetT);
                      return  ns.visit_maybe_relaxed_sub(child, pos.shift_ - B, next_size, {next_idx, args});
                  }
              }

            #endif
          }

