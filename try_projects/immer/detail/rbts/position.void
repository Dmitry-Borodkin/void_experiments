#define instantiate_each_pred_i_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t, ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT, bool)
    {
      #if (v_guard_ns(each_pred_i_regular_ns))

        private
        NT = node_type(Pos);

        #do (instantiate_full_leaf_pos(NT), position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, bool),
             instantiate_leaf_pos(NT),      position(NT).leaf_pos.instantiate_visit(Vis, ArgsT, bool),
             instantiate_full_pos(NT),      position(NT).full_pos.instantiate_visit(Vis, ArgsT, bool),
             instantiate_regular_pos(NT),   position(NT).regular_pos.instantiate_visit(Vis, ArgsT, bool),
             )

        linkonce_odr
        each_pred_i_regular: (p: Pos, f: count_t, l: count_t, args: ArgsT) ~> bool
        {
            using namespace position(NT);

            B  = bits(Pos);
            BL = bits_leaf(Pos);

            if (p.shift == BL)
            {
                if (l > f)
                {
                    if (l < p.count)
                    {
                        n: &*NT := p.node->inner + f;
                        e:  *NT  = p.node->inner + l;

                        for (; n != e; ++n)
                        {
                            ns = position_args(full_leaf_pos, Vis, ArgsT, bool);
                            if (!ns.visit(make_full_leaf_pos(*n), args))  return false;
                        }
                    }
                    else
                    {
                        n: &*NT := p.node->inner + f;
                        e:  *NT  = p.node->inner + l - 1;

                        for (; n != e; ++n)
                        {
                            ns = position_args(full_leaf_pos, Vis, ArgsT, bool);
                            if (!ns.visit(make_full_leaf_pos(*n), args))  return false;
                        }

                        ns = position_args(leaf_pos, Vis, ArgsT, bool);
                        if (!ns.visit(make_leaf_pos(*n, p.size), args))  return false;
                    }
                }
            }
            else
            {
                if (l > f)
                {
                    ss = p.shift - B;

                    if (l < p.count)
                    {
                        n: &*NT := p.node->inner + f;
                        e:  *NT  = p.node->inner + l;

                        for (; n != e; ++n)
                        {
                            ns = position_args(full_pos, Vis, ArgsT, bool);
                            if (!ns.visit(make_full_pos(*n, ss), args))  return false;
                        }
                    }
                    else
                    {
                        n: &*NT := p.node->inner + f;
                        e:  *NT  = p.node->inner + l - 1;

                        for (; n != e; ++n)
                        {
                            ns = position_args(full_pos, Vis, ArgsT, bool);
                            if (!ns.visit(make_full_pos(*n, ss), args))  return false;
                        }

                        ns = position_args(regular_pos, Vis, ArgsT, bool);
                        if (!ns.visit(make_regular_pos(*n, ss, p.size), args))  return false;
                    }
                }
            }

            return  true;
        }

      #endif
    }

'unit_defn_list'}

