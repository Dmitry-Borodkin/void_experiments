      }     //- namespace relaxed_pos


      alwaysinline
      make_relaxed_pos: (node: *NodeT, shift: shift_t, relaxed: *NodeT.relaxed_t) ~> relaxed_pos  =
      {
          v_assert(node);
          v_assert(relaxed);
          v_assert(shift >= NodeT.bits_leaf);
          {node, shift, relaxed}
      };

    #endif

  }     //- namespace position(NodeT)

'unit_defn_list'}


//---------------------------------------------------------------------
#define is_relaxed: [](Pos: v_static_type_t) ~> bool
  =  position(Pos.node_t).relaxed_pos == Pos;

//---------------------------------------------------------------------
#define relaxed_sub_args: [](NT: v_static_type_t, VS: v_static_namespace_t,
                             AT: v_static_type_t, RT: v_static_type_t = void) ~> v_static_namespace_t
  =  v_generic_ns(relaxed_sub_args_ns, Q(v_namespace_get_name(VS)), T[NT,AT,RT]);

//---------------------------------------------------------------------
#define instantiate_visit_maybe_relaxed_sub: [](NodeT: v_static_type_t, Vis: v_static_namespace_t,
                                                ArgsT: v_static_type_t, RetT: v_static_type_t = void)
{'unit_defn_list'

  namespace relaxed_sub_args(NodeT, Vis, ArgsT, RetT)
  {
    #if (v_quard_ns())

      private NT = NodeT;

      #do (instantiate_relaxed_pos(NT),     position(NT).relaxed_pos.instantiate_visit(Vis, ArgsT, RetT),
           instantiate_regular_sub_pos(NT), position(NT).regular_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
           )

      linkonce_odr
      visit_maybe_relaxed_sub: (node: *NodeT, shift: shift_t, size: size_t, args: ArgsT) ~> RetT
      {
          v_assert(node);
          relaxed = node->relaxed;

          using namespace position(NodeT);

          if (relaxed)
          {
              v_assert(size == pos.relaxed_->d.sizes[pos.relaxed_->d.count - 1]);

              ns = position_args(relaxed_pos, Vis, ArgsT, RetT);
              return  ns.visit(make_relaxed_pos(node, shift, relaxed), args);
          }
          else
          {
              ns = position_args(regular_sub_pos, Vis, ArgsT, RetT);
              return  ns.visit(make_regular_sub_pos(node, shift, size), args);
          }
      }

    #endif

  }     //- namespace relaxed_sub_args(NodeT, Vis, ArgsT, RetT)

'unit_defn_list'}


//---------------------------------------------------------------------
//- relaxed_descent_pos
//---------------------------------------------------------------------
#define instantiate_relaxed_descent_pos: [](NodeT: v_static_type_t, Shift: shift_t)
{'unit_defn_list'

  namespace position_shift(NodeT, Shift)
  {
    struct relaxed_descent_pos;

    #if (v_guard_ns(relaxed_descent_pos))

      #assert (Shift > 0  &&  "not leaf...")

      using namespace position(NodeT);

      struct relaxed_descent_pos
      {
          node_: *NodeT;
          relaxed_: *NodeT.relaxed_t;
      };

      relaxed_descent_pos.node_t    = NodeT;
      relaxed_descent_pos.relaxed_t = NodeT.relaxed_t;
      relaxed_descent_pos.B         = NodeT.bits;
      relaxed_descent_pos.BL        = NodeT.bits_leaf;

      alwaysinline
      (_.count): (pos: relaxed_descent_pos) ~> count_t  =  pos.relaxed_->d.count;

      alwaysinline
      (_.node): (pos: relaxed_descent_pos) ~> *NodeT  =  pos.node_;

      alwaysinline
      (_.shift): (relaxed_descent_pos) ~> shift_t  =  Shift;

      alwaysinline
      (_.size): (pos: relaxed_descent_pos) ~> size_t  =  pos.relaxed_->d.sizes[pos.relaxed_->d.count - 1];

      inlinehint
      (_.index()): (pos: relaxed_descent_pos, idx: size_t) ~> count_t
      {
          #if (Shift == BL) offset: &count_t := (idx >> BL) & mask(B);
          #else             offset: &count_t := idx >> Shift;
          #endif

          while (pos.relaxed_->d.sizes[offset] <= idx)  ++offset;
          return  offset;
      }


      namespace relaxed_descent_pos
      {
        using namespace position(NodeT);

        #define instantiate_descend: [](Vis: v_static_namespace_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(relaxed_descent_pos, Vis, size_t, RetT)
          {
            #if (v_guard_ns(descend_ns))

              private
              NT = node_type(relaxed_descent_pos);

              #if (Shift == BL)

                #do (instantiate_leaf_descent_pos(NT),
                     position(NT).leaf_descent_pos.instantiate_visit(Vis, size_t, RetT))

              #else

                #do (instantiate_relaxed_descent_pos(NT, Shift - B),
                     position_shift(NT, Shift - B).relaxed_descent_pos.instantiate_visit(Vis, size_t, RetT),
                     instantiate_regular_descent_pos(NT, Shift - B),
                     position_shift(NT, Shift - B).regular_descent_pos.instantiate_visit(Vis, size_t, RetT),
                     )

              #endif

              alwaysinline
              descend: (pos: relaxed_descent_pos, idx: size_t) ~> RetT
              {
                  offset = pos.index(idx);
                  child  = pos.node_->inner[offset];

                  left_size: &size_t := undef;
                  if (offset)   left_size := pos.relaxed_->d.sizes[offset - 1];
                  else          left_size := 0;

                  next_idx = idx - left_size;

                  #if (Shift == BL)

                    ns = position_args(leaf_descent_pos, Vis, size_t, RetT);
                    return  ns.visit({child}, next_idx);

                  #else

                    r = child->relaxed;

                    if (r)
                    {
                        PT = position_shift(NT, Shift - B).relaxed_descent_pos;

                        ns = position_args(PT, Vis, size_t, RetT);
                        return  ns.visit({child, r}, next_idx);
                    }
                    else
                    {
                        PT = position_shift(NT, Shift - B).regular_descent_pos;

                        ns = position_args(PT, Vis, size_t, RetT);
                        return  ns.visit({child}, next_idx);
                    }

                  #endif
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_visit: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(relaxed_descent_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(visit_ns))

              #do (Vis.instantiate_visit_relaxed(struct {relaxed_descent_pos; ArgsT;}, RetT))

              alwaysinline
              visit: (pos: relaxed_descent_pos, args: ArgsT) ~> RetT
              {
                  ns = visitor_args(Vis, struct {relaxed_descent_pos; ArgsT;}, RetT);
                  return  ns.visit_relaxed({pos, args});
              }

            #endif
          }

        'unit_defn_list'}

      }     //- namespace relaxed_descent_pos

    #endif

  }     //- namespace position_shift(NodeT, Shift)

'unit_defn_list'}

//---------------------------------------------------------------------
#define relaxed_descent_args: [](NT: v_static_type_t, VS: v_static_namespace_t,
                                 RT: v_static_type_t = void) ~> v_static_namespace_t
  =  v_generic_ns(relaxed_descent_args_ns, Q(v_namespace_get_name(VS)), T[NT,RT]);

//---------------------------------------------------------------------
#define instantiate_visit_maybe_relaxed_descent: [](NodeT: v_static_type_t, Vis: v_static_namespace_t,
                                                    RetT: v_static_type_t = void)
{'unit_defn_list'

  namespace relaxed_descent_args(NodeT, Vis, RetT)
  {
    #if (v_quard_ns())

      private NT = NodeT;
      private B  = NT.bits;
      private BL = NT.bits_leaf;

      private
      #define instantiate: (n)
      {'unit_defn_list'

          #do (instantiate_relaxed_descent_pos(NT, BL+B*n),
               position_shift(NT, BL+B*n).relaxed_descent_pos.instantiate_visit(Vis, size_t, RetT),
               )

      'unit_defn_list'}

      #do (instantiate(0),
           instantiate(1),
           instantiate(2),
           instantiate(3),
           instantiate(4),
           instantiate(5),
           instantiate_leaf_descent_pos(NT),
           position(NT).leaf_descent_pos.instantiate_visit(Vis, size_t, RetT),
           instantiate_visit_regular_descent(NT, Vis, RetT),
           )

      linkonce_odr
      visit_maybe_relaxed_descent: (node: *NodeT, shift: shift_t, idx: size_t) ~> RetT
      {
          v_assert(node);
          v_assert(shift >= BL);

          r = node->relaxed;

          if (r)
          {
              #define doit: (n: shift_t)
              {'stmt'
                {
                  PT = position_shift(NT, BL+B*n).relaxed_descent_pos;

                  ns = position_args(PT, Vis, size_t, RetT);
                  return  ns.visit({node, r}, idx);
                }
              'stmt'}

              switch(shift)
              {
              case BL+B*0:  doit(0);
              case BL+B*1:  doit(1);
              case BL+B*2:  doit(2);
              case BL+B*3:  doit(3);
              case BL+B*4:  doit(4);
              case BL+B*5:  doit(5);

              default:      //- IMMER_DESCENT_DEEP...
                {
                  node: &*NT := node;

                  for (level: &shift_t := sift; level != endshift(B, BL); level -= B)
                  {
                      r = node->relaxed;

                      if (r)
                      {
                          node_idx: &size_t := (idx >> level) & mask(B);

                          while (r->d.sizes[node_idx] <= idx)  ++node_idx;

                          if (node_idx)  idx -= r->d.sizes[node_idx - 1];

                          node := node->inner[node_idx];
                      }
                      else
                      {
                          loop
                          {
                              node := node->inner[(idx >> level) & mask(B)];

                              if ((level -= B) == endshift(B, BL))  break;
                          }

                          using namespace position(NT);

                          ns = position_args(leaf_descent_pos, Vis, size_t, RetT);
                          return  ns.visit(make_leaf_descent_pos(node), idx);
                      }
                  }

                  using namespace position(NT);

                  ns = position_args(leaf_descent_pos, Vis, size_t, RetT);
                  return  ns.visit(make_leaf_descent_pos(node), idx);
                }
              }
          }
          else
          {
              ns = regular_descent_args(NT, Vis, RetT);
              return  ns.visit_regular_descent(node, shift, idx);
          }
      }

    #endif

  }     //- namespace relaxed_descent_args(NodeT, Vis, RetT)

'unit_defn_list'}


//---------------------------------------------------------------------
}   //- namespace rbts
}   //- namespace detail
}   //- namespace .immer

