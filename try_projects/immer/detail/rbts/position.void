            #if (v_guard_ns(last_oh_ns))

              #do (instantiate_last_oh_regular(regular_sub_pos, Vis, ArgsT, RetT))

              alwaysinline
              last_oh: (pos: regular_sub_pos, offset_hint: count_t, args: ArgsT) ~> RetT
                =  last_oh_regular(pos, offset_hint, args);

            #endif
          }

        'unit_defn_list'}

        #define instantiate_last_sub: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(last_sub_ns))

              private
              NT = node_type(regular_sub_pos);

              #do (instantiate_leaf_sub_pos(NT),    position(NT).leaf_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   instantiate_regular_sub_pos(NT), position(NT).regular_sub_pos.instantiate_visit(Vis, ArgsT, RetT),
                   )

              inlinehint
              last_sub: (pos: regular_sub_pos, args: ArgsT) ~> RetT
              {
                  using namespace position(NT);

                  offset  = pos.count - 1;
                  child   = pos.node_->inner[offset];
                  is_leaf = pos.shift_ == BL;
                  lsize   = pos.size_ - ((offset: size_t) << pos.shift_);

                  if (is_leaf)
                  {
                      ns = position_args(leaf_sub_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_leaf_sub_pos(child, lsize), args);
                  }
                  else
                  {
                      ns = position_args(regular_sub_pos, Vis, ArgsT, RetT);
                      return  ns.visit(make_regular_sub_pos(child, pos.shift_ - B, lsize), args);
                  }
              }

            #endif
          }

        'unit_defn_list'}

        #define instantiate_first_sub: [](Vis: v_static_namespace_t, ArgsT: v_static_type_t, RetT: v_static_type_t = void)
        {'unit_defn_list'

          namespace position_args(regular_sub_pos, Vis, ArgsT, RetT)
          {
            #if (v_guard_ns(first_sub_ns))

              private
              NT = node_type(regular_sub_pos);

              #do (instantiate_full_leaf_pos(NT),   position(NT).full_leaf_pos.instantiate_visit(Vis, ArgsT, RetT),
