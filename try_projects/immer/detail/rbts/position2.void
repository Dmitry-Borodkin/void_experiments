#define instantiate_last_sub: [](Pos: v_static_type_t, Vis: v_static_namespace_t, ArgsT: v_static_type_t)
{'unit_defn_list'

  namespace position_args(Pos, Vis, ArgsT)
  {
    #if (v_guard_ns(last_sub_ns))

      #assert (Pos == regular_sub_pos)

      inlinehint
      last_sub: (pos: Pos, args: ArgsT) ~> Vis.result_t
      {
          offset  = pos.count - 1;
          child   = pos.node_->inner[offset];
          is_leaf = pos.shift_ == BL;
          lsize   = pos.size_ - ((offset: size_t) << pos.shift_);

          if (is_leaf)
          {
              return  make_leaf_sub_pos(child, lsize).visit(Vis, args);
          }
          else
          {
              return  make_regular_sub_pos(child, pos.shift_ - B, lsize).visit(Vis, args);
          }
      }

    #endif
  }

'unit_defn_list'}

