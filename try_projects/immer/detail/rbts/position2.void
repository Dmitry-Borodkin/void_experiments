        linkonce_odr
        each_pred_left_regular: (p: Pos, last: count_t, args: ArgsT) ~> bool
        {
            v_assert(last < p.count);

            if (p.shift == BL)
            {
                n: &*node_t := p.node->inner;
                e:  *node_t  = n + last;

                for (; n != e; ++n)
                {
                    if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                }
            }
            else
            {
                n: &*NT := p.node->inner;
                e:  *NT  = n + last;

                ss = p.shift - B;

                for (; n != e; ++n)
                {
                    if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                }
            }

            return  true;
        }

      #endif
    }

