                    return  make_leaf_sub_pos(child, pos.size_).visit(Vis, args);
                }
                else
                {
                    return  make_regular_sub_pos(child, pos.shift_ - B, pos.size_).visit(Vis, args);
                }
            }
        }
    }

'unit_defn_list'}

