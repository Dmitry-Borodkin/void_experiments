#define _instantiate_singleton_regular_sub_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

    namespace position(NodeT)
    {
        struct singleton_regular_sub_pos
        {
            leaf_:  *NodeT;
            count_: count_t;
        };

        namespace singleton_regular_sub_pos
        {
            using namespace position(NodeT);
        }


        alwaysinline
        (_.count): (singleton_regular_sub_pos) ~> count_t  =  1;

        alwaysinline
        (_.node): (singleton_regular_sub_pos) ~> *NodeT  =  0;

        alwaysinline
        (_.size): (pos: singleton_regular_sub_pos) ~> size_t  =  pos.count_;

        alwaysinline
        (_.shift): (singleton_regular_sub_pos) ~> shift_t  =  BL;

        alwaysinline
        (_.index()): (singleton_regular_sub_pos, size_t) ~> count_t  =  0;

        alwaysinline
        (_.subindex()): (singleton_regular_sub_pos, size_t) ~> count_t  =  0;

        alwaysinline
        (_.size_before): (singleton_regular_sub_pos, count_t) ~> size_t  =  0;

        alwaysinline
        (_.this_size): (pos: singleton_regular_sub_pos) ~> size_t  =  pos.count_;

        alwaysinline
        (_.size()): (pos: singleton_regular_sub_pos, count_t) ~> size_t  =  pos.count_;


        #define (_.each_left_sub()): [](p: singleton_regular_sub_pos, v: v_static_namespace_t, args)  =  undef;

        #define (_.each()): [](p: singleton_regular_sub_pos, v: v_static_namespace_t, args)  =  undef;

        #define (_.last_sub()): [](p: singleton_regular_sub_pos, v: v_static_namespace_t, args)
          =  make_leaf_sub_pos(p.leaf_, p.count_).visit(v, args);

        #define (_.visit()): [](p: singleton_regular_sub_pos, v: v_static_namespace_t, args)
          =  v.visit_regular({p, args});

    }     //- namespace position(NodeT)

'unit_defn_list'}

