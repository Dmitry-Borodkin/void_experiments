//---------------------------------------------------------------------
#define position_shift: [](NodeT: v_static_type_t, Shift: shift_t) ~> v_static_namespace_t  =
{
    ns = v_generic_ns(position_shift_ns, T(NodeT), N(Shift));

    #if (!v_defined(ns, do_inst))

        #define instantiate: [*, NodeT, Shift]()
        {'unit_defn_list'

            #do (instantiate_position_shift(NodeT, Shift))

        'unit_defn_list'}

        v_execute_inst(instantiate);

    #endif

    ns
};

//---------------------------------------------------------------------
#define instantiate_position_shift: [](NodeT: v_static_type_t, Shift: shift_t)
{'unit_defn_list'

  namespace v_generic_ns(position_shift_ns, T(NodeT), N(Shift))
  {
    #if (v_guard_ns())

      #define do_inst: [NodeT, Shift](InstMacro)
      {'stmt'

          {   #define instantiate: [*, NodeT, Shift, InstMacro]()
              {'unit_defn_list'

                  #do (InstMacro(NodeT, Shift))

              'unit_defn_list'}

              v_execute_inst(instantiate);
          }

      'stmt'}

    #endif
  }

'unit_defn_list'}


//---------------------------------------------------------------------
//- regular_descent_pos
//---------------------------------------------------------------------
#define instantiate_regular_descent_pos: [](NodeT: v_static_type_t, Shift: shift_t)
{'unit_defn_list'

  namespace position_shift(NodeT, Shift)
  {
    #if (v_guard_ns(regular_descent_pos_ns))

      #assert (Shift > 0  &&  "not leaf...")

      using namespace position(NodeT);

      struct regular_descent_pos
      {
          node_: *NodeT;
      };

      namespace regular_descent_pos
      {
          using namespace position(NodeT);
      }

      alwaysinline
      (_.node): (pos: regular_descent_pos) ~> *NodeT  =  pos.node_;

      alwaysinline
      (_.shift): (regular_descent_pos) ~> shift_t  =  Shift;

      alwaysinline
      (_.index()): (regular_descent_pos, idx: size_t) ~> count_t  =  ((idx >> Shift) & mask(BL) : count_t);


      #define (_.descend()): [*, Shift](pos: regular_descent_pos, v: v_static_namespace_t, idx: size_t)  =
      {
          offset = pos.index(idx);
          child  = pos.node_->inner[offset];

          #if (Shift == BL)

              make_leaf_descent_pos(child).visit(v, idx)

          #else

              make_regular_descent_pos(Shift - B, child).visit(v, idx)

          #endif
      };

      #define (_.visit()): [](p: regular_descent_pos, v: v_static_namespace_t, args)
        =  v.visit_regular({p, args});

    #endif

  }     //- namespace position_shift(NodeT, Shift)

'unit_defn_list'}

//---------------------------------------------------------------------
#define make_regular_descent_pos: [](Shift: shift_t, node)  =
{
    NodeT = typeof(node).element_type;

    ns = position_shift(NodeT, Shift);

    #if (!v_defined(ns, regular_decsent_pos))

        ns.do_inst(instantiate_regular_descent_pos);

    #endif

    ret: ns.regular_descent_pos = {node};

    ret
};


//---------------------------------------------------------------------
#define regular_descent_args: [](NodeT: v_static_type_t,
                                 Vis: v_static_namespace_t) ~> v_static_namespace_t  =
{
    ns = v_generic_ns(regular_descent_args_ns, Q(v_namespace_get_name(Vis)), T(NodeT));

    #if (!v_defined(ns, do_inst))

        #define instantiate: [*, NodeT]()
        {'unit_defn_list'

            #do (instantiate_regular_descent_args(Pos, Vis, ArgsT, RetT))

        'unit_defn_list'}

        v_execute_inst(instantiate);

    #endif

    ns
};

//---------------------------------------------------------------------
#define instantiate_regular_descent_args: [](NodeT: v_static_type_t, Vis: v_static_namespace_t)
{'unit_defn_list'

  namespace v_generic_ns(regular_descent_args_ns, Q(v_namespace_get_name(Vis)), T(NodeT))
  {
    #if (v_guard_ns())

      #define do_inst: [NodeT, Vis](InstMacro)
      {'stmt'

          {   #define instantiate: [*, NodeT, Vis, InstMacro]()
              {'unit_defn_list'

                  #do (InstMacro(NodeT, Vis))

              'unit_defn_list'}

              v_execute_inst(instantiate);
          }

      'stmt'}

    #endif
  }

'unit_defn_list'}

//---------------------------------------------------------------------
//- visit_regular_descent
//---------------------------------------------------------------------
#define instantiate_visit_regular_descent: [](NodeT: v_static_type_t, Vis: v_static_namespace_t)
{'unit_defn_list'

  namespace regular_descent_args(NodeT, Vis)
  {
    #if (v_quard_ns())

      private B  = NodeT.bits;
      private BL = NodeT.bits_leaf;

      linkonce_odr
      visit_regular_descent: (node: *NodeT, shift: shift_t, idx: size_t) ~> Vis.result_t
      {
          v_assert(node);
          v_assert(shift >= BL);

          switch(shift)
          {
          case BL+B*0:  return  make_regular_descent_pos(BL+B*0, node).visit(Vis, idx);
          case BL+B*1:  return  make_regular_descent_pos(BL+B*1, node).visit(Vis, idx);
          case BL+B*2:  return  make_regular_descent_pos(BL+B*2, node).visit(Vis, idx);
          case BL+B*3:  return  make_regular_descent_pos(BL+B*3, node).visit(Vis, idx);
          case BL+B*4:  return  make_regular_descent_pos(BL+B*4, node).visit(Vis, idx);
          case BL+B*5:  return  make_regular_descent_pos(BL+B*5, node).visit(Vis, idx);

          default:      //- IMMER_DESCENT_DEEP...
            {
              node: &*NodeT := node;

              for (level: &shift_t := sift; level != endshift(B, BL); level -= B)
              {
                  node := node->inner[(idx >> level) & mask(B)];
              }

              return  make_leaf_descent_pos(node).visit(Vis, idx);
            }
          }
      }

    #endif

  }     //- namespace regular_descent_args(NodeT, Vis)

'unit_defn_list'}

//---------------------------------------------------------------------
#define visit_regular_descent: (node, Vis: v_static_namespace_t, shift: shift_t, idx: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = regular_descent_args(NodeT, Vis);

    #if (!v_defined(ns, visit_regular_descent))

        ns.do_inst(instantiate_visit_regular_descent);

    #endif

    ns.visit_regular_descent(node, shift, idx)
};














