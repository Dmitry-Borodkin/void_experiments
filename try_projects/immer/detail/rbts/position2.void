'unit_defn_list'}

//---------------------------------------------------------------------
#define make_leaf_sub_pos: [](node, count: count_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, leaf_sub_pos))

        v_execute_outer(_instantiate_leaf_sub_pos, NodeT);

    #endif

    v_assert(node);
    v_assert(count <= branches(ns.BL));

    ret: ns.leaf_sub_pos = {node, count};

    ret
};


