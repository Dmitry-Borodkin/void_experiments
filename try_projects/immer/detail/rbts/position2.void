//---------------------------------------------------------------------
//- leaf_pos
//---------------------------------------------------------------------
#template _instantiate_leaf_pos: [](NS, NodeT: v_static_type_t)
{
    struct leaf_pos
    {
        node_: *NodeT;
        size_: size_t;
    };

    namespace leaf_pos
    {
        using namespace NS;
    }

    alwaysinline
    (_.index()): (leaf_pos, idx: size_t) ~> count_t  =  (idx & mask(BL) : count_t);

    alwaysinline
    (_.subindex()): (leaf_pos, idx: size_t) ~> count_t  =  (idx: count_t);

    alwaysinline
    (_.count): (pos: leaf_pos) ~> count_t  =  pos.index(pos.size_ -1) + 1;

    alwaysinline
    (_.node): (pos: leaf_pos) ~> *NodeT  =  pos.node_;

    alwaysinline
    (_.shift): (leaf_pos) ~> shift_t  =  0;

    alwaysinline
    (_.size): (pos: leaf_pos) ~> size_t  =  pos.size_;


    #define (_.visit()): [](p: leaf_pos, v: visitor_t, args)
      =  v.visit_leaf(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_leaf_pos: [](node, size: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    _instantiate_leaf_pos(ns, NodeT);

    v_assert(node);
    v_assert(size > 0);

    ret: ns.leaf_pos = {node, size};

    ret
};


