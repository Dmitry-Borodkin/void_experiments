    #endif

    ns._each_pred_right_regular(p, start, args)
};


//---------------------------------------------------------------------
//- each_i_regular
//---------------------------------------------------------------------
#define _instantiate_each_i_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                        ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        linkonce_odr
        _each_i_regular: (p: Pos, f: count_t, l: count_t, args: ArgsT) ~> void
        {
            if (p.shift == BL)
            {
                if (l > f)
                {
                    if (l < p.count)
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l;

                        for (; n != e; ++n)
                        {
                            make_full_leaf_pos(*n).visit(Vis, args);
                        }
                    }
                    else
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l - 1;

                        for (; n != e; ++n)
                        {
                            make_full_leaf_pos(*n).visit(Vis, args);
                        }

                        make_leaf_pos(*n, p.size).visit(Vis, args);
                    }
                }
            }
            else
            {
                if (l > f)
                {
                    ss = p.shift - B;

                    if (l < p.count)
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l;

                        for (; n != e; ++n)
                        {
                            make_full_pos(*n, ss).visit(Vis, args);
                        }
                    }
                    else
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l - 1;

                        for (; n != e; ++n)
                        {
                            make_full_pos(*n, ss).visit(Vis, args);
                        }

                        make_regular_pos(*n, ss, p.size).visit(Vis, args);
                    }
                }
            }
        }
    }

'unit_defn_list'}

