    ns = v_generic_ns(regular_descent_args_ns, Q(v_namespace_get_name(Vis)), T(NodeT));
    ns
};

//---------------------------------------------------------------------
//- visit_regular_descent
//---------------------------------------------------------------------
#define _instantiate_visit_regular_descent: [](NodeT: v_static_type_t, Vis: v_static_namespace_t)
{'unit_defn_list'

    namespace regular_descent_args(NodeT, Vis)
    {
        private B  = NodeT.bits;
        private BL = NodeT.bits_leaf;

        linkonce_odr
        _visit_regular_descent: (node: *NodeT, shift: shift_t, idx: size_t) ~> Vis.result_t
        {
            v_assert(node);
            v_assert(shift >= BL);

            switch(shift)
            {
            case BL+B*0:  return  make_regular_descent_pos(BL+B*0, node).visit(Vis, idx);
            case BL+B*1:  return  make_regular_descent_pos(BL+B*1, node).visit(Vis, idx);
            case BL+B*2:  return  make_regular_descent_pos(BL+B*2, node).visit(Vis, idx);
            case BL+B*3:  return  make_regular_descent_pos(BL+B*3, node).visit(Vis, idx);
            case BL+B*4:  return  make_regular_descent_pos(BL+B*4, node).visit(Vis, idx);
            case BL+B*5:  return  make_regular_descent_pos(BL+B*5, node).visit(Vis, idx);

            default:      //- IMMER_DESCENT_DEEP...
              {
                node: &*NodeT := node;

                for (level: &shift_t := sift; level != endshift(B, BL); level -= B)
                {
                    node := node->inner[(idx >> level) & mask(B)];
                }

                return  make_leaf_descent_pos(node).visit(Vis, idx);
              }
            }
        }
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define visit_regular_descent: (node, Vis: v_static_namespace_t, shift: shift_t, idx: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = regular_descent_args(NodeT, Vis);

    #if (!v_defined(ns, _visit_regular_descent))

        v_execute_outer(_instantiate_visit_regular_descent, NodeT, Vis);

    #endif

    ns._visit_regular_descent(node, shift, idx)
};


//---------------------------------------------------------------------
//- full_pos
//---------------------------------------------------------------------
#define _instantiate_full_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

    namespace position(NodeT)
    {
        struct full_pos
        {
            node_:  *NodeT;
            shift_: shift_t;
        };

        namespace full_pos
        {
            using namespace position(NodeT);
        }


        alwaysinline
        (_.count): (full_pos) ~> count_t  =  branches(B);

        alwaysinline
        (_.node): (pos: full_pos) ~> *NodeT  =  pos.node_;

        alwaysinline
        (_.size): (pos: full_pos) ~> size_t  =  branches(B, size_t) << pos.shift_;

        alwaysinline
        (_.shift): (pos: full_pos) ~> shift_t  =  pos.shift_;

        alwaysinline
        (_.index()): (pos: full_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(B) : count_t);

        alwaysinline
        (_.subindex()): (pos: full_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

        alwaysinline
        (_.size()): (pos: full_pos, count_t) ~> size_t  =  (1: size_t) << pos.shift_;

        alwaysinline
        (_.size_sbh()): (pos: full_pos, count_t, size_t) ~> size_t  =  (1: size_t) << pos.shift_;

        alwaysinline
        (_.size_before()): (pos: full_pos, offset: count_t) ~> size_t  =  (offset: size_t) << pos.shift_;

        inlinehint
        (_.copy_sizes()): (pos: full_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
        {
            e = sizes + n;

            sizes: &*size_t := sizes;
            init:  &size_t  := init;

            for (; sizes != e; ++sizes)
            {
                init := *sizes := init + ((1: size_t) << pos.shift_);
                v_assert(init);
            }
        }


        #define (_.each()): [](p: full_pos, v: v_static_namespace_t, args)
          =  each_full(p, v, args);

        #define (_.each_pred()): [](p: full_pos, v: v_static_namespace_t, args) ~> bool
          =  each_pred_full(p, v, args);

        #define (_.each_pred_zip()): [](p: full_pos, v: v_static_namespace_t, other: *node_t, args) ~> bool
          =  each_pred_zip_full(p, v, other, args);

        #define (_.each_pred_i()): [](p: full_pos, v: v_static_namespace_t, i: count_t, n: count_t, args) ~> bool
          =  each_pred_i_full(p, v, i, n, args);

        #define (_.each_i()): [](p: full_pos, v: v_static_namespace_t, i: count_t, n: count_t, args)
          =  each_i_full(p, v, i, n, args);

        #define (_.each_pred_right()): [](p: full_pos, v: v_static_namespace_t, start: count_t, args) ~> bool
          =  p.each_pred_i(v, start, branches(B), args);

        #define (_.each_pred_left()): [](p: full_pos, v: v_static_namespace_t, last: count_t, args) ~> bool
          =  p.each_pred_i(v, 0, last, args);

        #define (_.each_sub()): [](p: full_pos, v: v_static_namespace_t, args)
          =  p.each(v, args);

        #define (_.each_left_sub()): [](p: full_pos, v: v_static_namespace_t, args)
          =  p.each_i(v, 0, branches(B) - 1, args);

        #define (_.each_right_sub()): [](p: full_pos, v: v_static_namespace_t, args)
          =  p.each_i(v, 1, branches(B), args);

        #define (_.each_right()): [](p: full_pos, v: v_static_namespace_t, start: count_t, args)
          =  p.each_i(v, start, branches(B), args);

        #define (_.each_left()): [](p: full_pos, v: v_static_namespace_t, last: count_t, args)
          =  p.each_i(v, 0, last, args);

        #define (_.towards()): [](p: full_pos, v: v_static_namespace_t, idx: size_t, args)
          =  p.towards_oh(v, idx, p.index(idx), args);

        #define (_.towards_oh_ch()): [](p: full_pos, v: v_static_namespace_t,
                                        idx: size_t,
                                        offset_hint: count_t,
                                        count_hint: count_t,
                                        args)
          =  p.towards_oh(v, idx, offset_hint, args);

        #define (_.towards_oh()): [](p: full_pos, v: v_static_namespace_t, idx: size_t, offset_hint: count_t, args)
          =  towards_oh_full(p, v, idx, offset_hint, args);

        #define (_.towards_sub_oh()): [](p: full_pos, v: v_static_namespace_t, idx: size_t, offset_hint: count_t, args)
          =  towards_sub_oh_full(p, v, idx, offset_hint, args);

        #define (_.first_sub()): [](p: full_pos, v: v_static_namespace_t, args)
          =  first_sub_full(p, v, args);

        #define (_.first_sub_leaf()): [](p: full_pos, v: v_static_namespace_t, args)
          =  first_sub_leaf_full(p, v, args);

        #define (_.first_sub_inner()): (p: full_pos, v: v_static_namespace_t, args)
          =  first_sub_inner_full(p, v, args);

        #define (_.nth_sub()): [](p: full_pos, v: v_static_namespace_t, idx: count_t, args)
          =  nth_sub_full(p, v, idx, args);

        #define (_.nth_sub_leaf()): [](p: full_pos, v: v_static_namespace_t, idx: count_t, args)
          =  nth_sub_leaf_full(p, v, idx, args);

        #define (_.visit()): [](p: full_pos, v: v_static_namespace_t, args)
          =  v.visit_regular({p, args});

    }     //- namespace position(NodeT)

'unit_defn_list'}

//---------------------------------------------------------------------
#define make_full_pos: [](node, shift: shift_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, full_pos))

        v_execute_outer(_instantiate_full_pos, NodeT);

    #endif

    v_assert(node);
    v_assert(shift >= ns.BL);

    ret: ns.full_pos = {node, shift};

    ret
};


//---------------------------------------------------------------------
//- each_full
//---------------------------------------------------------------------
#define _instantiate_each_full: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                   ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        inlinehint
        _each_full: (pos: Pos, args: ArgsT) ~> void
        {
            p: &*NT := pos.node_->inner;
            e        = p + branches(B);

            if (pos.shift_ == BL)
            {
                for (; p != e; ++p)
                {
                    make_full_leaf_pos(*p).visit(Vis, args);
                }
            }
            else
            {
                ss = pos.shift_ - B;

                for (; p != e; ++p)
                {
                    make_full_pos(*p, ss).visit(Vis, args);
                }
            }
        }
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_full: [](p, Vis: v_static_namespace_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    #assert (Pos == position(Pos.node_t).full_pos)

    ns = position_args(Pos, Vis, ArgsT);

    #if (!v_defined(ns, _each_full))

        v_execute_outer(_instantiate_each_full, Pos, Vis, ArgsT);

    #endif

    ns._each_full(p, args)
};


//---------------------------------------------------------------------
//- each_pred_full
//---------------------------------------------------------------------
#define _instantiate_each_pred_full: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                        ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        inlinehint
        _each_pred_full: (pos: Pos, args: ArgsT) ~> bool
        {
            p: &*NT := pos.node_->inner;
            e        = p + branches(B);

            if (pos.shift_ == BL)
            {
                for (; p != e; ++p)
                {
                    if (!make_full_leaf_pos(*p).visit(Vis, args))  return false;
                }
            }
            else
            {
                ss = pos.shift_ - B;

                for (; p != e; ++p)
                {
                    if (!make_full_pos(*p, ss).visit(Vis, args))   return false;
                }
            }

            return true;
        }
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_pred_full: [](p, Vis: v_static_namespace_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

