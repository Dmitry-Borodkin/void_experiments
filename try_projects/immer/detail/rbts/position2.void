//---------------------------------------------------------------------
//- regular_pos
//---------------------------------------------------------------------
#define instantiate_regular_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

  namespace position(NodeT)
  {
    #if (v_guard_ns(regular_pos_ns))

      struct regular_pos
      {
          node_:  *NodeT;
          shift_: shift_t;
          size_:  size_t;
      };

      namespace regular_pos
      {
          using namespace position(NodeT);
      }

      alwaysinline
      (_.index()): (pos: regular_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(B) : count_t);

      alwaysinline
      (_.subindex()): (pos: regular_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

      alwaysinline
      (_.count): (pos: regular_pos) ~> count_t  =  pos.index(pos.size_ - 1) + 1;

      alwaysinline
      (_.node): (pos: regular_pos) ~> *NodeT  =  pos.node_;

      alwaysinline
      (_.shift): (pos: regular_pos) ~> shift_t  =  pos.shift_;

      alwaysinline
      (_.size): (pos: regular_pos) ~> size_t  =  pos.size_;

      alwaysinline
      (_.this_size): (pos: regular_pos) ~> size_t
        =  ((pos.size_ -1) & ~((-1: size_t) << (pos.shift_ + B))) + 1;


      #define (_.each()): [](p: regular_pos, v: v_static_namespace_t, args)
        =  each_regular(p, v, args);

      #define (_.each_pred()): [](p: regular_pos, v: v_static_namespace_t, args) ~> bool
        =  each_pred_regular(p, v, args);

      #define (_.each_pred_zip()): [](p: regular_pos, v: v_static_namespace_t, other: *node_t, args) ~> bool
        =  each_pred_zip_regular(p, v, other, args);

      #define (_.each_pred_i()): [](p: regular_pos, v: v_static_namespace_t, i: count_t, n: count_t, args) ~> bool
        =  each_pred_i_regular(p, v, i, n, args);

      #define (_.each_pred_right()): [](p: regular_pos, v: v_static_namespace_t, start: count_t, args) ~> bool
        =  each_pred_right_regular(p, v, start, args);

      #define (_.each_pred_left()): [](p: regular_pos, v: v_static_namespace_t, last: count_t, args) ~> bool
        =  each_pred_left_regular(p, v, last, args);

      #define (_.each_i()): [](p: regular_pos, v: v_static_namespace_t, i: count_t, n: count_t, args)
        =  each_i_regular(p, v, i, n, args);

      #define (_.each_right()): [](p: regular_pos, v: v_static_namespace_t, start: count_t, args)
        =  each_right_regular(p, v, start, args);

      #define (_.each_left()): [](p: regular_pos, v: v_static_namespace_t, last: count_t, args)
        =  each_left_regular(p, v, last, args);

      #define (_.towards()): [](p: regular_pos, v: v_static_namespace_t, idx: size_t, args)
        =  towards_oh_ch_regular(p, v, idx, p.index(idx), p.count, args);

      #define (_.towards_oh()): [](p: regular_pos, v: v_static_namespace_t, idx: size_t, offset_hint: count_t, args)
        =  towards_oh_ch_regular(p, v, idx, offset_hint, p.count, args);

      #define (_.towards_oh_ch()): [](p: regular_pos, v: v_static_namespace_t,
                                      idx: size_t,
                                      offset_hint: count_t,
                                      count_hint: count_t,
                                      args)
        =  towards_oh_ch_regular(p, v, idx, offset_hint, count_hint, args);

      #define (_.towards_sub_oh()): [](p: regular_pos, v: v_static_namespace_t, idx: size_t, offset_hint: count_t, args)
        =  towards_sub_oh_regular(p, v, idx, offset_hint, args);

      #define (_.last_oh()): [](p: regular_pos, v: v_static_namespace_t, offset_hint: count_t, args)
        =  last_oh_regular(p, v, offset_hint, args);

      #define (_.visit()): [](p: regular_pos, v: v_static_namespace_t, args)
        =  v.visit_regular({p, args});

    #endif

  }     //- namespace position(NodeT)

'unit_defn_list'}

//---------------------------------------------------------------------
#define make_regular_pos: [](node, shift: shift_t, size: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, regular_pos))

        ns.do_inst(instantiate_regular_pos);

    #endif

    v_assert(node);
    v_assert(shift >= ns.BL);
    v_assert(size > 0);

    ret: ns.regular_pos = {node, shift, size};

    ret
};


//---------------------------------------------------------------------
//- each_regular
//---------------------------------------------------------------------
#define instantiate_each_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                     ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
      #if (v_guard_ns(each_regular_ns))

        linkonce_odr
        each_regular: (p: Pos, args: ArgsT) ~> void
        {
            n: &*node_t := p.node->inner;
            last         = p.count - 1;
            e            = n + last;

            if (p.shift == BL)
            {
                for (; n != e; ++n)
                {
                    make_full_leaf_pos(*n).visit(Vis, args);
                }

                make_leaf_pos(*n, p.size).visit(Vis, args);
            }
            else
            {
                ss = p.shift - B;

                for (; n != e; ++n)
                {
                    make_full_pos(*n, ss).visit(Vis, args);
                }

                make_regular_pos(*n, ss, p.size).visit(Vis, args);
            }
        }

      #endif
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_regular: [](p, Vis: v_static_namespace_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    #if (!v_defined(ns, each_regular))

        ns.do_inst(instantiate_each_regular);

    #endif

    ns.each_regular(p, args)
};


//---------------------------------------------------------------------
//- each_pred_regular
//---------------------------------------------------------------------
#define instantiate_each_pred_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                          ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
      #if (v_guard_ns(each_pred_regular_ns))

        linkonce_odr
        each_pred_regular: (p: Pos, args: ArgsT) ~> bool
        {
            n: &*node_t := p.node->inner;
            last         = p.count - 1;
            e            = n + last;

            if (p.shift == BL)
            {
                for (; n != e; ++n)
                {
                    if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                }

                return  make_leaf_pos(*n, p.size).visit(Vis, args);
            }
            else
            {
                ss = p.shift - B;

                for (; n != e; ++n)
                {
                    if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                }

                return  make_regular_pos(*n, ss, p.size).visit(Vis, args);
            }
        }

      #endif
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_pred_regular: [](p, Vis: v_static_namespace_t, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    #if (!v_defined(ns, each_pred_regular))

        ns.do_inst(instantiate_each_pred_regular);

    #endif

    ns.each_pred_regular(p, args)
};


//---------------------------------------------------------------------
//- each_pred_zip_regular
//---------------------------------------------------------------------
#define instantiate_each_pred_zip_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                              ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
      #if (v_guard_ns(each_pred_zip_regular_ns))

        linkonce_odr
        each_pred_zip_regular: (p: Pos, other: *node_t, args: ArgsT) ~> bool
        {
            n:  &*node_t := p.node->inner;
            n2: &*node_t := other->inner;
            last          = p.count - 1;
            e             = n + last;

            if (p.shift == BL)
            {
                for (; n != e; ++n, ++n2)
                {
                    if (!make_full_leaf_pos(*n).visit(Vis, {*n2, args}))  return false;
                }

                return  make_leaf_pos(*n, p.size).visit(Vis, {*n2, args});
            }
            else
            {
                ss = p.shift - B;

                for (; n != e; ++n, ++n2)
                {
                    if (!make_full_pos(*n, ss).visit(Vis, {*n2, args}))  return false;
                }

                return  make_regular_pos(*n, ss, p.size).visit(Vis, {*n2, args});
            }
        }

      #endif
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_pred_zip_regular: [](p, Vis: v_static_namespace_t, other, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    #if (!v_defined(ns, each_pred_zip_regular))

        ns.do_inst(instantiate_each_pred_zip_regular);

    #endif

    ns.each_pred_zip_regular(p, other, args)
};


//---------------------------------------------------------------------
//- each_pred_i_regular
//---------------------------------------------------------------------
#define instantiate_each_pred_i_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                            ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
      #if (v_guard_ns(each_pred_i_regular_ns))

        linkonce_odr
        each_pred_i_regular: (p: Pos, f: count_t, l: count_t, args: ArgsT) ~> bool
        {
            if (p.shift == BL)
            {
                if (l > f)
                {
                    if (l < p.count)
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l;

                        for (; n != e; ++n)
                        {
                            if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                        }
                    }
                    else
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l - 1;

                        for (; n != e; ++n)
                        {
                            if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                        }

                        if (!make_leaf_pos(*n, p.size).visit(Vis, args))  return false;
                    }
                }
            }
            else
            {
                if (l > f)
                {
                    ss = p.shift - B;

                    if (l < p.count)
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l;

                        for (; n != e; ++n)
                        {
                            if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                        }
                    }
                    else
                    {
                        n: &*node_t := p.node->inner + f;
                        e:  *node_t  = p.node->inner + l - 1;

                        for (; n != e; ++n)
                        {
                            if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                        }

                        if (!make_regular_pos(*n, ss, p.size).visit(Vis, args))  return false;
                    }
                }
            }

            return  true;
        }

      #endif
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_pred_i_regular: [](p, Vis: v_static_namespace_t, f: count_t, l: count_t, args) ~> bool  =
{
