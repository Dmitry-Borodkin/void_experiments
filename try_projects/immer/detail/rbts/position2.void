#define make_singleton_regular_sub_pos: [](leaf, count: count_t)  =
{
    NodeT = typeof(leaf).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, singleton_regular_sub_pos))

        v_execute_outer(_instantiate_singleton_regular_sub_pos, NodeT);

    #endif

    v_assert(leaf);
    v_assert(count > 0);

    ret: ns.singleton_regular_sub_pos = {leaf, count};

    ret
};


//---------------------------------------------------------------------
//- regular_sub_pos
//---------------------------------------------------------------------
#define _instantiate_regular_sub_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

    namespace position(NodeT)
    {
        struct regular_sub_pos
        {
            node_:  *NodeT;
            shift_: shift_t;
            size_:  size_t;
        };

        namespace regular_sub_pos
        {
            using namespace position(NodeT);
        }

        alwaysinline
        (_.index()): (pos: regular_sub_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(B) : count_t);

        alwaysinline
        (_.subindex()): (pos: regular_sub_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

        alwaysinline
        (_.count): (pos: regular_sub_pos) ~> count_t  =  pos.subindex(pos.size_ - 1) + 1;

        alwaysinline
        (_.node): (pos: regular_sub_pos) ~> *NodeT  =  pos.node_;

        alwaysinline
        (_.shift): (pos: regular_sub_pos) ~> shift_t  =  pos.shift_;

        alwaysinline
        (_.size): (pos: regular_sub_pos) ~> size_t  =  pos.size_;

        alwaysinline
        (_.this_size): (pos: regular_sub_pos) ~> size_t  =  pos.size_;

        alwaysinline
        (_.size_before()): (pos: regular_sub_pos, offset: count_t) ~> size_t  =  (offset: size_t) << pos.shift_;

        alwaysinline
        (_.size()): (pos: regular_sub_pos, offset: count_t) ~> size_t
        {
            if (offset == pos.subindex(pos.size_ - 1))  return  pos.size_ - pos.size_before(offset);
            else                                        return  (1: size_t) << pos.shift_;
        }

        alwaysinline
        (_.size_sbh()): (pos: regular_sub_pos, offset: count_t, size_before_hint: size_t) ~> size_t
        {
            v_assert(size_before_hint == pos.size_before(offset));

            if (offset == pos.subindex(pos.size_ - 1))  return  pos.size_ - size_before_hint;
            else                                        return  (1: size_t) << pos.shift_;
        }

        inlinehint
        (_.copy_sizes()): (pos: regular_sub_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
        {
            if (n == 0) return;

            last = offset + n - 1;
            e    = sizes  + n - 1;

            sizes: &*size_t := sizes;
            init:  &size_t  := init;

            for (; sizes != e; ++sizes)
            {
                init := *sizes := init + ((1: size_t) << pos.shift_);
                v_assert(init);
            }

            *sizes := init + pos.size(last);
            v_assert(*sizes);
        }


        #define (_.each()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  each_regular(p, v, args);

        #define (_.each_pred()): [](p: regular_sub_pos, v: v_static_namespace_t, args) ~> bool
          =  each_pred_regular(p, v, args);

        #define (_.each_pred_zip()): [](p: regular_sub_pos, v: v_static_namespace_t, other: *node_t, args) ~> bool
          =  each_pred_zip_regular(p, v, other, args);

        #define (_.each_pred_i()): [](p: regular_sub_pos, v: v_static_namespace_t, i: count_t, n: count_t, args) ~> bool
          =  each_pred_i_regular(p, v, i, n, args);

        #define (_.each_pred_right()): [](p: regular_sub_pos, v: v_static_namespace_t, start: count_t, args) ~> bool
          =  each_pred_right_regular(p, v, start, args);

        #define (_.each_pred_left()): [](p: regular_sub_pos, v: v_static_namespace_t, last: count_t, args) ~> bool
          =  each_pred_left_regular(p, v, last, args);

        #define (_.each_i()): [](p: regular_sub_pos, v: v_static_namespace_t, i: count_t, n: count_t, args)
          =  each_i_regular(p, v, i, n, args);

        #define (_.each_right()): [](p: regular_sub_pos, v: v_static_namespace_t, start: count_t, args)
          =  each_right_regular(p, v, start, args);

        #define (_.each_left()): [](p: regular_sub_pos, v: v_static_namespace_t, last: count_t, args)
          =  each_left_regular(p, v, last, args);

        #define (_.each_right_sub_()): [](p: regular_sub_pos, v: v_static_namespace_t, i: count_t, args)
          =  each_right_sub_regular_sub_(p, v, i, args);

        #define (_.each_sub()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  p.each_right_sub_(v, 0, args);

        #define (_.each_right_sub()): [](p: regular_sub_pos, v: v_static_namespace_t, args)  =
        {
            if (p.count > 1)  p.each_right_sub_(v, 1, args);

            undef         //- ?!?!?
        };

        #define (_.each_left_sub()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  p.each_left(v, p.count - 1, args);

        #define (_.towards()): [](p: regular_sub_pos, v: v_static_namespace_t, idx: size_t, args)
          =  towards_oh_ch_regular(p, v, idx, p.index(idx), p.count, args);

        #define (_.towards_oh()): [](p: regular_sub_pos, v: v_static_namespace_t, idx: size_t, offset_hint: count_t, args)
          =  towards_oh_ch_regular(p, v, idx, offset_hint, p.count, args);

        #define (_.towards_oh_ch()): [](p: regular_sub_pos, v: v_static_namespace_t,
                                        idx: size_t,
                                        offset_hint: count_t,
                                        count_hint: count_t,
                                        args)
          =  towards_oh_ch_regular(p, v, idx, offset_hint, count_hint, args);

        #define (_.towards_sub_oh()): [](p: regular_sub_pos, v: v_static_namespace_t, idx: size_t, offset_hint: count_t, args)
          =  towards_sub_oh_regular(p, v, idx, offset_hint, args);

        #define (_.last_oh()): [](p: regular_sub_pos, v: v_static_namespace_t, offset_hint: count_t, args)
          =  last_oh_regular(p, v, offset_hint, args);

        #define (_.last_sub()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  last_sub_regular_sub(p, v, args);

        #define (_.first_sub()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  first_sub_regular_sub(p, v, args);

        #define (_.first_sub_leaf()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  first_sub_leaf_regular_sub(p, v, args);

        #define (_.first_sub_inner()): (p: regular_sub_pos, v: v_static_namespace_t, args)
          =  first_sub_inner_regular_sub(p, v, args);

        #define (_.nth_sub()): [](p: regular_sub_pos, v: v_static_namespace_t, idx: count_t, args)
          =  nth_sub_regular_sub(p, v, idx, args);

        #define (_.nth_sub_leaf()): [](p: regular_sub_pos, v: v_static_namespace_t, idx: count_t, args)
          =  nth_sub_leaf_regular_sub(p, v, idx, args);

        #define (_.visit()): [](p: regular_sub_pos, v: v_static_namespace_t, args)
          =  v.visit_regular({p, args});

    }     //- namespace position(NodeT)

'unit_defn_list'}

//---------------------------------------------------------------------
#define make_regular_sub_pos: [](node, shift: shift_t, size: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, regular_sub_pos))

        v_execute_outer(_instantiate_regular_sub_pos, NodeT);

    #endif

    v_assert(node);
    v_assert(shift >= ns.BL);
    v_assert(size > 0);
    v_assert(size <= (branches(ns.BL, size_t) << shift));

    ret: ns.regular_sub_pos = {node, shift, size};

    ret
};


//---------------------------------------------------------------------
//- each_right_sub_regular_sub_
//---------------------------------------------------------------------
#define _instantiate_each_right_sub_regular_sub_: [](Pos: v_static_type_t,
                                                     Vis: v_static_namespace_t, ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        inlinehint
        _each_right_sub_regular_sub_: (pos: Pos, i: count_t, args: ArgsT) ~> void
        {
            last         = pos.count - 1;
            lsize        = pos.size_ - (last << pos.shift_);
            n: &*node_t := pos.node->inner + i;
            e            = pos.node->inner + last;

            if (pos.shift == BL)
            {
                for (; n != e; ++n)
                {
                    make_full_leaf_pos(*n).visit(Vis, args);
                }

                make_leaf_sub_pos(*n, lsize).visit(Vis, args);
            }
            else
            {
                ss = pos.shift_ - B;

                for (; n != e; ++n)
                {
                    make_full_pos(*n, ss).visit(Vis, args);
                }

                make_regular_sub_pos(*n, ss, lsize).visit(Vis, args);
            }
        }
    }

'unit_defn_list'}

