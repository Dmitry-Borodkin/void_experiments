#define instantiate_each_pred_left_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                               ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
