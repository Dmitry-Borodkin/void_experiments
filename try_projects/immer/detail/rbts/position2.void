  namespace position_args(Pos, Vis, ArgsT)
  {
    #if (v_guard_ns(nth_sub_ns))

      #assert (Pos == regular_sub_pos)

      inlinehint
      nth_sub: (pos: Pos, idx: count_t, args: ArgsT) ~> Vis.result_t
      {
          v_assert(idx < pos.count_);
          is_leaf = pos.shift_ == BL;
          child   = pos.node_->inner[idx];
          lsize   = pos.size(idx);
          is_full = idx + 1 < pos.count;

          if (is_full)
          {
              if (is_leaf)
              {
                  return  make_full_leaf_pos(child).visit(Vis, args);
              }
              else
              {
                  return  make_full_pos(child, pos.shift_ - B).visit(Vis, args);
              }
          }
          else
          {
              if (is_leaf)
              {
                  return  make_leaf_sub_pos(child, lsize).visit(Vis, args);
              }
              else
              {
                  return  make_regular_sub_pos(child, pos.shift_ - B, lsize).visit(Vis, args);
              }
          }
      }

    #endif
  }

