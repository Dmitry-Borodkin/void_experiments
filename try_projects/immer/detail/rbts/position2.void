//---------------------------------------------------------------------
//- leaf_pos
//---------------------------------------------------------------------
#define _instantiate_leaf_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

    namespace position(NodeT)
    {
        struct leaf_pos
        {
            node_: *NodeT;
            size_: size_t;
        };

        namespace leaf_pos
        {
            using namespace position(NodeT);
        }

        alwaysinline
        (_.index()): (leaf_pos, idx: size_t) ~> count_t  =  (idx & mask(BL) : count_t);

        alwaysinline
        (_.subindex()): (leaf_pos, idx: size_t) ~> count_t  =  (idx: count_t);

        alwaysinline
        (_.count): (pos: leaf_pos) ~> count_t  =  pos.index(pos.size_ -1) + 1;

        alwaysinline
        (_.node): (pos: leaf_pos) ~> *NodeT  =  pos.node_;

        alwaysinline
        (_.shift): (leaf_pos) ~> shift_t  =  0;

        alwaysinline
        (_.size): (pos: leaf_pos) ~> size_t  =  pos.size_;


        #define (_.visit()): [](p: leaf_pos, v: v_static_namespace_t, args)
          =  v.visit_leaf({p, args});

    }   //- namespace position(NodeT)

'unit_defn_list'}

//---------------------------------------------------------------------
#define make_leaf_pos: [](node, size: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, leaf_pos))

        v_execute_outer(_instantiate_leaf_pos, NodeT);

    #endif

    v_assert(node);
    v_assert(size > 0);

    ret: ns.leaf_pos = {node, size};

    ret
};


