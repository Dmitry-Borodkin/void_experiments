    alwaysinline
    (_.count): (pos: leaf_sub_pos) ~> count_t  =  pos.count_;

    alwaysinline
    (_.node): (pos: leaf_sub_pos) ~> *NodeT  =  pos.node_;

    alwaysinline
    (_.shift): (leaf_sub_pos) ~> shift_t  =  0;

    alwaysinline
    (_.size): (pos: leaf_sub_pos) ~> size_t  =  pos.count_;


    #define (_.visit()): [](p: leaf_sub_pos, v: visitor_t, args)
      =  v.visit_leaf(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_leaf_sub_pos: [](node, count: count_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    _instantiate_leaf_sub_pos(ns, NodeT);

    v_assert(node);
    v_assert(count <= branches(ns.BL));

    ret: ns.leaf_sub_pos = {node, count};

    ret
};


