//---------------------------------------------------------------------
//- towards_oh_ch_regular
//---------------------------------------------------------------------
#define _instantiate_towards_oh_ch_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                               ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        linkonce_odr
        _towards_oh_ch_regular: (p: Pos,
                                 idx: size_t,
                                 offset_hint: count_t,
                                 count_hint: count_t,
                                 args: ArgsT) ~> Vis.result_t
        {
            v_assert(offset_hint == p.index(idx));
            v_assert(count_hint == pcount);

            is_leaf = p.shift == BL;
            child   = p.node->inner[offset_hint];
            is_full = offset_hint + 1 != count_hint;

            if (is_full)
            {
                if (is_leaf)
                {
                    return  make_full_leaf_pos(child).visit(Vis, {idx, args});
                }
                else
                {
                    return  make_full_pos(child, p.shift - B).visit(Vis, {idx, args});
                }
            }
            else
            {
                if (is_leaf)
                {
                    return  make_leaf_pos(child, p.size).visit(Vis, {idx, args});
                }
                else
                {
                    return  make_regular_pos(child, p.shift - B, p.size).visit(Vis, {idx, args});
                }
            }
        }
    }

'unit_defn_list'}

