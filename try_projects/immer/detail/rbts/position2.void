};


//---------------------------------------------------------------------
//- towards_sub_oh_regular
//---------------------------------------------------------------------
#define _instantiate_towards_sub_oh_regular: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                                ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        linkonce_odr
        _towards_sub_oh_regular: (p: Pos,
                                  idx: size_t,
                                  offset_hint: count_t,
                                  args: ArgsT) ~> Vis.result_t
        {
            v_assert(offset_hint == p.index(idx));

            is_leaf = p.shift == BL;
            child   = p.node->inner[offset_hint];
            lsize   = offset_hint << p.shift;
            size    = p.this_size;
            is_full = (size - lsize) >= ((1: size_t) << p.shift);

            if (is_full)
            {
                if (is_leaf)
                {
                    return  make_full_leaf_pos(child).visit(Vis, {idx - lsize, args});
                }
                else
                {
                    return  make_full_pos(child, p.shift - B).visit(Vis, {idx - lsize, args});
                }
            }
            else
            {
                if (is_leaf)
                {
                    return  make_leaf_sub_pos(child, p.size - lsize).visit(Vis, {idx - lsize, args});
                }
                else
                {
                    return  make_regular_sub_pos(child, p.shift - B, size - lsize).visit(Vis, {idx - lsize, args});
                }
            }
        }
    }

'unit_defn_list'}

