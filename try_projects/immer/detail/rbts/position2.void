//---------------------------------------------------------------------
//- each_pred_zip_full
//---------------------------------------------------------------------
#define _instantiate_each_pred_zip_full: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                            ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        private NT = Pos.node_t;

        inlinehint
        _each_pred_zip_full: (pos: Pos, other: *NT, args: ArgsT) ~> bool
        {
            p:  &*NT := pos.node_->inner;
            p2: &*NT := other->inner;
            e         = p + branches(B);

            if (pos.shift_ == BL)
            {
                for (; p != e; ++p, ++p2)
                {
                    if (!make_full_leaf_pos(*p).visit(Vis, {*p2, args}))  return false;
                }
            }
            else
            {
                ss = pos.shift_ - B;

                for (; p != e; ++p, ++p2)
                {
                    if (!make_full_pos(*p, ss).visit(Vis, {*p2, args}))  return false;
                }
            }

            return true;
        }
    }

'unit_defn_list'}

//---------------------------------------------------------------------
#define each_pred_zip_full: [](p, Vis: v_static_namespace_t, other, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    #assert (Pos == position(Pos.node_t).full_pos)

    ns = position_args(Pos, Vis, ArgsT);

    #if (!v_defined(ns, _each_pred_zip_full))

        v_execute_outer(_instantiate_each_pred_zip_full, Pos, Vis, ArgsT);

    #endif

    ns._each_pred_zip_full(p, other, args)
};


