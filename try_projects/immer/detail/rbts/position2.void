//---------------------------------------------------------------------
//- regular_pos
//---------------------------------------------------------------------
#template _instantiate_regular_pos: [](NS, NodeT: v_static_type_t)
{
    struct regular_pos
    {
        node_:  *NodeT;
        shift_: shift_t;
        size_:  size_t;
    };

    namespace regular_pos
    {
        using namespace NS;
    }

    alwaysinline
    (_.index()): (pos: regular_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(B) : count_t);

    alwaysinline
    (_.subindex()): (pos: regular_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

    alwaysinline
    (_.count): (pos: regular_pos) ~> count_t  =  pos.index(pos.size_ - 1) + 1;

    alwaysinline
    (_.node): (pos: regular_pos) ~> *NodeT  =  pos.node_;

    alwaysinline
    (_.shift): (pos: regular_pos) ~> shift_t  =  pos.shift_;

    alwaysinline
    (_.size): (pos: regular_pos) ~> size_t  =  pos.size_;

    alwaysinline
    (_.this_size): (pos: regular_pos) ~> size_t
      =  ((pos.size_ -1) & ~((-1: size_t) << (pos.shift_ + B))) + 1;


    #define (_.each()): [](p: regular_pos, v: visitor_t, args)
      =  each_regular(p, v, args);

    #define (_.each_pred()): [](p: regular_pos, v: visitor_t, args) ~> bool
      =  each_pred_regular(p, v, args);

    #define (_.each_pred_zip()): [](p: regular_pos, v: visitor_t, other: *node_t, args) ~> bool
      =  each_pred_zip_regular(p, v, other, args);

    #define (_.each_pred_i()): [](p: regular_pos, v: visitor_t, i: count_t, n: count_t, args) ~> bool
      =  each_pred_i_regular(p, v, i, n, args);

    #define (_.each_pred_right()): [](p: regular_pos, v: visitor_t, start: count_t, args) ~> bool
      =  each_pred_right_regular(p, v, start, args);

    #define (_.each_pred_left()): [](p: regular_pos, v: visitor_t, last: count_t, args) ~> bool
      =  each_pred_left_regular(p, v, last, args);

    #define (_.each_i()): [](p: regular_pos, v: visitor_t, i: count_t, n: count_t, args)
      =  each_i_regular(p, v, i, n, args);

    #define (_.each_right()): [](p: regular_pos, v: visitor_t, start: count_t, args)
      =  each_right_regular(p, v, start, args);

    #define (_.each_left()): [](p: regular_pos, v: visitor_t, last: count_t, args)
      =  each_left_regular(p, v, last, args);

    #define (_.towards()): [](p: regular_pos, v: visitor_t, idx: size_t, args)
      =  towards_oh_ch_regular(p, v, idx, p.index(idx), p.count, args);

    #define (_.towards_oh()): [](p: regular_pos, v: visitor_t, idx: size_t, offset_hint: count_t, args)
      =  towards_oh_ch_regular(p, v, idx, offset_hint, p.count, args);

    #define (_.towards_oh_ch()): [](p: regular_pos, v: visitor_t,
                                    idx: size_t,
                                    offset_hint: count_t,
                                    count_hint: count_t,
                                    args)
      =  towards_oh_ch_regular(p, v, idx, offset_hint, count_hint, args);

    #define (_.towards_sub_oh()): [](p: regular_pos, v: visitor_t, idx: size_t, offset_hint: count_t, args)
      =  towards_sub_oh_regular(p, v, idx, offset_hint, args);

    #define (_.last_oh()): [](p: regular_pos, v: visitor_t, offset_hint: count_t, args)
      =  last_oh_regular(p, v, offset_hint, args);

    #define (_.visit()): [](p: regular_pos, v: visitor_t, args)
      =  v.visit_regular(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_regular_pos: [](node, shift: shift_t, size: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    _instantiate_regular_pos(ns, NodeT);

    v_assert(node);
    v_assert(shift >= ns.BL);
    v_assert(size > 0);

    ret: ns.regular_pos = {node, shift, size};

    ret
};


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
#define position_args: [](Pos: v_static_type_t, Vis: visitor_t,
                          ArgsT: v_static_type_t) ~> v_static_namespace_t  =
{
    ns = Pos.v_generic_ns(position_args_ns, Q(v_namespace_get_name(Vis)), T(ArgsT));
    ns
};


//---------------------------------------------------------------------
//- each_regular
//---------------------------------------------------------------------
#template _instantiate_each_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                        ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_regular: (p: Pos, args: ArgsT) ~> void
    {
        n: &*node_t := p.node->inner;
        last         = p.count - 1;
        e            = n + last;

        if (p.shift == BL)
        {
            for (; n != e; ++n)
            {
                make_full_leaf_pos(*n).visit(Vis, args);
            }

            make_leaf_pos(*n, p.size).visit(Vis, args);
        }
        else
        {
            ss = p.shift - B;

            for (; n != e; ++n)
            {
                make_full_pos(*n, ss).visit(Vis, args);
            }

            make_regular_pos(*n, ss, p.size).visit(Vis, args);
        }
    }
}

//---------------------------------------------------------------------
#define each_regular: [](p, Vis: visitor_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_regular(ns, Pos, Vis, ArgsT);

    ns._each_regular(p, args)
};


//---------------------------------------------------------------------
//- each_pred_regular
//---------------------------------------------------------------------
#template _instantiate_each_pred_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                             ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_pred_regular: (p: Pos, args: ArgsT) ~> bool
    {
        n: &*node_t := p.node->inner;
        last         = p.count - 1;
        e            = n + last;

        if (p.shift == BL)
        {
            for (; n != e; ++n)
            {
                if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
            }

            return  make_leaf_pos(*n, p.size).visit(Vis, args);
        }
        else
        {
            ss = p.shift - B;

            for (; n != e; ++n)
            {
                if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
            }

            return  make_regular_pos(*n, ss, p.size).visit(Vis, args);
        }
    }
}

//---------------------------------------------------------------------
#define each_pred_regular: [](p, Vis: visitor_t, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_pred_regular(ns, Pos, Vis, ArgsT);

    ns._each_pred_regular(p, args)
};


//---------------------------------------------------------------------
//- each_pred_zip_regular
//---------------------------------------------------------------------
#template _instantiate_each_pred_zip_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                                 ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_pred_zip_regular: (p: Pos, other: *node_t, args: ArgsT) ~> bool
    {
        n:  &*node_t := p.node->inner;
        n2: &*node_t := other->inner;
        last          = p.count - 1;
        e             = n + last;

        if (p.shift == BL)
        {
            for (; n != e; ++n, ++n2)
            {
                if (!make_full_leaf_pos(*n).visit(Vis, {*n2, args}))  return false;
            }

            return  make_leaf_pos(*n, p.size).visit(Vis, {*n2, args});
        }
        else
        {
            ss = p.shift - B;

            for (; n != e; ++n, ++n2)
            {
                if (!make_full_pos(*n, ss).visit(Vis, {*n2, args}))  return false;
            }

            return  make_regular_pos(*n, ss, p.size).visit(Vis, {*n2, args});
        }
    }
}

//---------------------------------------------------------------------
#define each_pred_zip_regular: [](p, Vis: visitor_t, other, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_pred_zip_regular(ns, Pos, Vis, ArgsT);

    ns._each_pred_zip_regular(p, other, args)
};


//---------------------------------------------------------------------
//- each_pred_i_regular
//---------------------------------------------------------------------
#template _instantiate_each_pred_i_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                               ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_pred_i_regular: (p: Pos, f: count_t, l: count_t, args: ArgsT) ~> bool
    {
        if (p.shift == BL)
        {
            if (l > f)
            {
                if (l < p.count)
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l;

                    for (; n != e; ++n)
                    {
                        if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                    }
                }
                else
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l - 1;

                    for (; n != e; ++n)
                    {
                        if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                    }

                    if (!make_leaf_pos(*n, p.size).visit(Vis, args))  return false;
                }
            }
        }
        else
        {
            if (l > f)
            {
                ss = p.shift - B;

                if (l < p.count)
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l;

                    for (; n != e; ++n)
                    {
                        if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                    }
                }
                else
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l - 1;

                    for (; n != e; ++n)
                    {
                        if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                    }

                    if (!make_regular_pos(*n, ss, p.size).visit(Vis, args))  return false;
                }
            }
        }

        return  true;
    }
}

//---------------------------------------------------------------------
#define each_pred_i_regular: [](p, Vis: visitor_t, f: count_t, l: count_t, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_pred_i_regular(ns, Pos, Vis, ArgsT);

    ns._each_pred_i_regular(p, f, l, args)
};


//---------------------------------------------------------------------
//- each_pred_left_regular
//---------------------------------------------------------------------
#template _instantiate_each_pred_left_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                                  ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_pred_left_regular: (p: Pos, last: count_t, args: ArgsT) ~> bool
    {
        v_assert(last < p.count);

        if (p.shift == BL)
        {
            n: &*node_t := p.node->inner;
            e:  *node_t  = n + last;

            for (; n != e; ++n)
            {
                if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
            }
        }
        else
        {
            n: &*NT := p.node->inner;
            e:  *NT  = n + last;

            ss = p.shift - B;

            for (; n != e; ++n)
            {
                if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
            }
        }

        return  true;
    }
}

//---------------------------------------------------------------------
#define each_pred_left_regular: [](p, Vis: visitor_t, last: count_t, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_pred_left_regular(ns, Pos, Vis, ArgsT);

    ns._each_pred_left_regular(p, last, args)
};


//---------------------------------------------------------------------
//- each_pred_right_regular
//---------------------------------------------------------------------
#template _instantiate_each_pred_right_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                                   ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_pred_right_regular: (p: Pos, start: count_t, args: ArgsT) ~> bool
    {
        if (p.shift == BL)
        {
            n: &*node_t := p.node->inner + start;
            last         = p.count - 1;
            e:  *node_t  = n.node->inner + last;

            if (n <= e)
            {
                for (; n != e; ++n)
                {
                    if (!make_full_leaf_pos(*n).visit(Vis, args))  return false;
                }

                if (!make_leaf_pos(*n, p.size).visit(Vis, args))  return false;
            }
        }
        else
        {
            n: &*node_t := p.node->inner + start;
            last         = p.count - 1;
            e:  *node_t  = n.node->inner + last;

            ss = p.shift - B;

            if (n <= e)
            {
                for (; n != e; ++n)
                {
                    if (!make_full_pos(*n, ss).visit(Vis, args))  return false;
                }

                if (!make_regular_pos(*n, ss, p.size).visit(Vis, args))  return false;
            }
        }

        return  true;
    }
}

//---------------------------------------------------------------------
#define each_pred_right_regular: [](p, Vis: visitor_t, start: count_t, args) ~> bool  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_pred_right_regular(ns, Pos, Vis, ArgsT);

    ns._each_pred_right_regular(p, start, args)
};


//---------------------------------------------------------------------
//- each_i_regular
//---------------------------------------------------------------------
#template _instantiate_each_i_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                          ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_i_regular: (p: Pos, f: count_t, l: count_t, args: ArgsT) ~> void
    {
        if (p.shift == BL)
        {
            if (l > f)
            {
                if (l < p.count)
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l;

                    for (; n != e; ++n)
                    {
                        make_full_leaf_pos(*n).visit(Vis, args);
                    }
                }
                else
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l - 1;

                    for (; n != e; ++n)
                    {
                        make_full_leaf_pos(*n).visit(Vis, args);
                    }

                    make_leaf_pos(*n, p.size).visit(Vis, args);
                }
            }
        }
        else
        {
            if (l > f)
            {
                ss = p.shift - B;

                if (l < p.count)
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l;

                    for (; n != e; ++n)
                    {
                        make_full_pos(*n, ss).visit(Vis, args);
                    }
                }
                else
                {
                    n: &*node_t := p.node->inner + f;
                    e:  *node_t  = p.node->inner + l - 1;

                    for (; n != e; ++n)
                    {
                        make_full_pos(*n, ss).visit(Vis, args);
                    }

                    make_regular_pos(*n, ss, p.size).visit(Vis, args);
                }
            }
        }
    }
}

//---------------------------------------------------------------------
#define each_i_regular: [](p, Vis: visitor_t, f: count_t, l: count_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_i_regular(ns, Pos, Vis, ArgsT);

    ns._each_i_regular(p, f, l, args)
};


//---------------------------------------------------------------------
//- each_left_regular
//---------------------------------------------------------------------
#template _instantiate_each_left_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                             ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_left_regular: (p: Pos, last: count_t, args: ArgsT) ~> void
    {
        v_assert(last < p.count);

        if (p.shift == BL)
        {
            n: &*node_t := p.node->inner;
            e:  *node_t  = n + last;

            for (; n != e; ++n)
            {
                make_full_leaf_pos(*n).visit(Vis, args);
            }
        }
        else
        {
            n: &*node_t := p.node->inner;
            e:  *node_t  = n + last;

            ss = p.shift - B;

            for (; n != e; ++n)
            {
                make_full_pos(*n, ss).visit(Vis, args);
            }
        }
    }
}

//---------------------------------------------------------------------
#define each_left_regular: [](p, Vis: visitor_t, last: count_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_left_regular(ns, Pos, Vis, ArgsT);

    ns._each_left_regular(p, last, args)
};


//---------------------------------------------------------------------
//- each_right_regular
//---------------------------------------------------------------------
#template _instantiate_each_right_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                              ArgsT: v_static_type_t)
{
    linkonce_odr
    _each_right_regular: (p: Pos, start: count_t, args: ArgsT) ~> void
    {
        if (p.shift == BL)
        {
            n: &*node_t := p.node->inner + start;
            last         = p.count - 1;
            e:  *node_t  = n.node->inner + last;

            if (n <= e)
            {
                for (; n != e; ++n)
                {
                    make_full_leaf_pos(*n).visit(Vis, args);
                }

                make_leaf_pos(*n, p.size).visit(Vis, args);
            }
        }
        else
        {
            n: &*node_t := p.node->inner + start;
            last         = p.count - 1;
            e:  *node_t  = n.node->inner + last;

            ss = p.shift - B;

            if (n <= e)
            {
                for (; n != e; ++n)
                {
                    make_full_pos(*n, ss).visit(Vis, args);
                }

                make_regular_pos(*n, ss, p.size).visit(Vis, args);
            }
        }
    }
}

//---------------------------------------------------------------------
#define each_right_regular: [](p, Vis: visitor_t, start: count_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_each_right_regular(ns, Pos, Vis, ArgsT);

    ns._each_right_regular(p, start, args)
};


//---------------------------------------------------------------------
//- towards_oh_ch_regular
//---------------------------------------------------------------------
#template _instantiate_towards_oh_ch_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                                 ArgsT: v_static_type_t)
{
    linkonce_odr
    _towards_oh_ch_regular: (p: Pos,
                             idx: size_t,
                             offset_hint: count_t,
                             count_hint: count_t,
                             args: ArgsT) ~> Vis.result_t
    {
        v_assert(offset_hint == p.index(idx));
        v_assert(count_hint == pcount);

        is_leaf = p.shift == BL;
        child   = p.node->inner[offset_hint];
        is_full = offset_hint + 1 != count_hint;

        if (is_full)
        {
            if (is_leaf)
            {
                return  make_full_leaf_pos(child).visit(Vis, {idx, args});
            }
            else
            {
                return  make_full_pos(child, p.shift - B).visit(Vis, {idx, args});
            }
        }
        else
        {
            if (is_leaf)
            {
                return  make_leaf_pos(child, p.size).visit(Vis, {idx, args});
            }
            else
            {
                return  make_regular_pos(child, p.shift - B, p.size).visit(Vis, {idx, args});
            }
        }
    }
}

//---------------------------------------------------------------------
#define towards_oh_ch_regular: [](p, Vis: visitor_t,
                                  idx: size_t,
                                  offset_hint: count_t,
                                  count_hint: count_t,
                                  args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_towards_oh_ch_regular(ns, Pos, Vis, ArgsT);

    ns._towards_oh_ch_regular(p, idx, offset_hint, count_hint, args)
};


//---------------------------------------------------------------------
//- towards_sub_oh_regular
//---------------------------------------------------------------------
#template _instantiate_towards_sub_oh_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                                  ArgsT: v_static_type_t)
{
    linkonce_odr
    _towards_sub_oh_regular: (p: Pos,
                              idx: size_t,
                              offset_hint: count_t,
                              args: ArgsT) ~> Vis.result_t
    {
        v_assert(offset_hint == p.index(idx));

        is_leaf = p.shift == BL;
        child   = p.node->inner[offset_hint];
        lsize   = offset_hint << p.shift;
        size    = p.this_size;
        is_full = (size - lsize) >= ((1: size_t) << p.shift);

        if (is_full)
        {
            if (is_leaf)
            {
                return  make_full_leaf_pos(child).visit(Vis, {idx - lsize, args});
            }
            else
            {
                return  make_full_pos(child, p.shift - B).visit(Vis, {idx - lsize, args});
            }
        }
        else
        {
            if (is_leaf)
            {
                return  make_leaf_sub_pos(child, p.size - lsize).visit(Vis, {idx - lsize, args});
            }
            else
            {
                return  make_regular_sub_pos(child, p.shift - B, size - lsize).visit(Vis, {idx - lsize, args});
            }
        }
    }
}

//---------------------------------------------------------------------
#define towards_sub_oh_regular: [](p, Vis: visitor_t,
                                   idx: size_t,
                                   offset_hint: count_t,
                                   args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_towards_sub_oh_regular(ns , Pos, Vis, ArgsT);

    ns._towards_sub_oh_regular(p, idx, offset_hint, args)
};


//---------------------------------------------------------------------
//- last_oh_regular
//---------------------------------------------------------------------
#template _instantiate_last_oh_regular: [](NS, Pos: v_static_type_t, Vis: visitor_t,
                                           ArgsT: v_static_type_t)
{
    linkonce_odr
    _last_oh_regular: (p: Pos, offset_hint: count_t, args: ArgsT) ~> Vis.result_t
    {
        v_assert(offset_hint == p.count - 1);

        is_leaf = p.shift == BL;
        child   = p.node->inner[offset_hint];

        if (is_leaf)
        {
            return  make_leaf_pos(child, p.size).visit(Vis, args);
        }
        else
        {
            return  make_regular_pos(child, p.shift - B, p.size).visit(Vis, args);
        }
    }
}

//---------------------------------------------------------------------
#define last_oh_regular: [](p, Vis: visitor_t, offset_hint: count_t, args)  =
{
    Pos   = typeof(p);
    ArgsT = typeof(args);

    ns = position_args(Pos, Vis, ArgsT);

    _instantiate_last_oh_regular(ns, Pos, Vis, ArgsT);

    ns._last_oh_regular(p, offset_hint, args)
};


//---------------------------------------------------------------------
//- null_sub_pos
//---------------------------------------------------------------------
struct null_sub_pos {};

#define (_.node): (p: null_sub_pos)  =  0;

#define (_.each_sub()): [](p: null_sub_pos, v: visitor_t, args)  =  undef;

#define (_.each_right_sub()): [](p: null_sub_pos, v: visitor_t, args)  =  undef;

#define (_.each_left_sub()): [](p: null_sub_pos, v: visitor_t, args)  =  undef;

#define (_.visit()): [](p: null_sub_pos, v: visitor_t, args)  =  undef;

//---------------------------------------------------------------------
#define make_null_sub_pos: []() ~> null_sub_pos  =  {};


//---------------------------------------------------------------------
//- singleton_regular_sub_pos
//---------------------------------------------------------------------
#template _instantiate_singleton_regular_sub_pos: [](NS, NodeT: v_static_type_t)
{
    struct singleton_regular_sub_pos
    {
        leaf_:  *NodeT;
        count_: count_t;
    };

    namespace singleton_regular_sub_pos
    {
        using namespace NS;
    }


    alwaysinline
    (_.count): (singleton_regular_sub_pos) ~> count_t  =  1;

    alwaysinline
    (_.node): (singleton_regular_sub_pos) ~> *NodeT  =  0;

    alwaysinline
    (_.size): (pos: singleton_regular_sub_pos) ~> size_t  =  pos.count_;

    alwaysinline
    (_.shift): (singleton_regular_sub_pos) ~> shift_t  =  BL;

    alwaysinline
    (_.index()): (singleton_regular_sub_pos, size_t) ~> count_t  =  0;

    alwaysinline
    (_.subindex()): (singleton_regular_sub_pos, size_t) ~> count_t  =  0;

    alwaysinline
    (_.size_before): (singleton_regular_sub_pos, count_t) ~> size_t  =  0;

    alwaysinline
    (_.this_size): (pos: singleton_regular_sub_pos) ~> size_t  =  pos.count_;

    alwaysinline
    (_.size()): (pos: singleton_regular_sub_pos, count_t) ~> size_t  =  pos.count_;


    #define (_.each_left_sub()): [](p: singleton_regular_sub_pos, v: visitor_t, args)  =  undef;

    #define (_.each()): [](p: singleton_regular_sub_pos, v: visitor_t, args)  =  undef;

    #define (_.last_sub()): [](p: singleton_regular_sub_pos, v: visitor_t, args)
      =  make_leaf_sub_pos(p.leaf_, p.count_).visit(v, args);

    #define (_.visit()): [](p: singleton_regular_sub_pos, v: visitor_t, args)
      =  v.visit_regular(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_singleton_regular_sub_pos: [](leaf, count: count_t)  =
{
    NodeT = typeof(leaf).element_type;

    ns = position(NodeT);

    _instantiate_singleton_regular_sub_pos(ns, NodeT);

    v_assert(leaf);
    v_assert(count > 0);

    ret: ns.singleton_regular_sub_pos = {leaf, count};

    ret
};


//---------------------------------------------------------------------
//- regular_sub_pos
//---------------------------------------------------------------------
#template _instantiate_regular_sub_pos: [](NS, NodeT: v_static_type_t)
{
    struct regular_sub_pos
    {
        node_:  *NodeT;
        shift_: shift_t;
        size_:  size_t;
    };

    namespace regular_sub_pos
    {
        using namespace NS;
    }

    alwaysinline
    (_.index()): (pos: regular_sub_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(B) : count_t);

    alwaysinline
    (_.subindex()): (pos: regular_sub_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

    alwaysinline
    (_.count): (pos: regular_sub_pos) ~> count_t  =  pos.subindex(pos.size_ - 1) + 1;

    alwaysinline
    (_.node): (pos: regular_sub_pos) ~> *NodeT  =  pos.node_;

    alwaysinline
    (_.shift): (pos: regular_sub_pos) ~> shift_t  =  pos.shift_;

    alwaysinline
    (_.size): (pos: regular_sub_pos) ~> size_t  =  pos.size_;

    alwaysinline
    (_.this_size): (pos: regular_sub_pos) ~> size_t  =  pos.size_;

    alwaysinline
    (_.size_before()): (pos: regular_sub_pos, offset: count_t) ~> size_t  =  (offset: size_t) << pos.shift_;

    alwaysinline
    (_.size()): (pos: regular_sub_pos, offset: count_t) ~> size_t
    {
        if (offset == pos.subindex(pos.size_ - 1))  return  pos.size_ - pos.size_before(offset);
        else                                        return  (1: size_t) << pos.shift_;
    }

    alwaysinline
    (_.size_sbh()): (pos: regular_sub_pos, offset: count_t, size_before_hint: size_t) ~> size_t
    {
        v_assert(size_before_hint == pos.size_before(offset));

        if (offset == pos.subindex(pos.size_ - 1))  return  pos.size_ - size_before_hint;
        else                                        return  (1: size_t) << pos.shift_;
    }

    inlinehint
    (_.copy_sizes()): (pos: regular_sub_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
    {
        if (n == 0) return;

        last = offset + n - 1;
        e    = sizes  + n - 1;

        sizes: &*size_t := sizes;
        init:  &size_t  := init;

        for (; sizes != e; ++sizes)
        {
            init := *sizes := init + ((1: size_t) << pos.shift_);
            v_assert(init);
        }

        *sizes := init + pos.size(last);
        v_assert(*sizes);
    }


    #define (_.each()): [](p: regular_sub_pos, v: visitor_t, args)
      =  each_regular(p, v, args);

    #define (_.each_pred()): [](p: regular_sub_pos, v: visitor_t, args) ~> bool
      =  each_pred_regular(p, v, args);

    #define (_.each_pred_zip()): [](p: regular_sub_pos, v: visitor_t, other: *node_t, args) ~> bool
      =  each_pred_zip_regular(p, v, other, args);

    #define (_.each_pred_i()): [](p: regular_sub_pos, v: visitor_t, i: count_t, n: count_t, args) ~> bool
      =  each_pred_i_regular(p, v, i, n, args);

    #define (_.each_pred_right()): [](p: regular_sub_pos, v: visitor_t, start: count_t, args) ~> bool
      =  each_pred_right_regular(p, v, start, args);

    #define (_.each_pred_left()): [](p: regular_sub_pos, v: visitor_t, last: count_t, args) ~> bool
      =  each_pred_left_regular(p, v, last, args);

    #define (_.each_i()): [](p: regular_sub_pos, v: visitor_t, i: count_t, n: count_t, args)
      =  each_i_regular(p, v, i, n, args);

    #define (_.each_right()): [](p: regular_sub_pos, v: visitor_t, start: count_t, args)
      =  each_right_regular(p, v, start, args);

    #define (_.each_left()): [](p: regular_sub_pos, v: visitor_t, last: count_t, args)
      =  each_left_regular(p, v, last, args);

    #define (_.each_right_sub_()): [](p: regular_sub_pos, v: visitor_t, i: count_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template each_right_sub_: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _each_right_sub_: (pos: Pos, i: count_t, args: ArgsT) ~> void
            {
                last         = pos.count - 1;
                lsize        = pos.size_ - (last << pos.shift_);
                n: &*node_t := pos.node->inner + i;
                e            = pos.node->inner + last;

                if (pos.shift == BL)
                {
                    for (; n != e; ++n)
                    {
                        make_full_leaf_pos(*n).visit(v, args);
                    }

                    make_leaf_sub_pos(*n, lsize).visit(v, args);
                }
                else
                {
                    ss = pos.shift_ - B;

                    for (; n != e; ++n)
                    {
                        make_full_pos(*n, ss).visit(v, args);
                    }

                    make_regular_sub_pos(*n, ss, lsize).visit(v, args);
                }
            }
        }

        ns._each_right_sub_(p, i, args)
    };

    #define (_.each_sub()): [](p: regular_sub_pos, v: visitor_t, args)
      =  p.each_right_sub_(v, 0, args);

    #define (_.each_right_sub()): [](p: regular_sub_pos, v: visitor_t, args)  =
    {
        if (p.count > 1)  p.each_right_sub_(v, 1, args);

        undef         //- ?!?!?
    };

    #define (_.each_left_sub()): [](p: regular_sub_pos, v: visitor_t, args)
      =  p.each_left(v, p.count - 1, args);

    #define (_.towards()): [](p: regular_sub_pos, v: visitor_t, idx: size_t, args)
      =  towards_oh_ch_regular(p, v, idx, p.index(idx), p.count, args);

    #define (_.towards_oh()): [](p: regular_sub_pos, v: visitor_t, idx: size_t, offset_hint: count_t, args)
      =  towards_oh_ch_regular(p, v, idx, offset_hint, p.count, args);

    #define (_.towards_oh_ch()): [](p: regular_sub_pos, v: visitor_t,
                                    idx: size_t,
                                    offset_hint: count_t,
                                    count_hint: count_t,
                                    args)
      =  towards_oh_ch_regular(p, v, idx, offset_hint, count_hint, args);

    #define (_.towards_sub_oh()): [](p: regular_sub_pos, v: visitor_t, idx: size_t, offset_hint: count_t, args)
      =  towards_sub_oh_regular(p, v, idx, offset_hint, args);

    #define (_.last_oh()): [](p: regular_sub_pos, v: visitor_t, offset_hint: count_t, args)
      =  last_oh_regular(p, v, offset_hint, args);

    #define (_.last_sub()): [](p: regular_sub_pos, v: visitor_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template last_sub: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _last_sub: (pos: Pos, args: ArgsT) ~> v.result_t
            {
                offset  = pos.count - 1;
                child   = pos.node_->inner[offset];
                is_leaf = pos.shift_ == BL;
                lsize   = pos.size_ - ((offset: size_t) << pos.shift_);

                if (is_leaf)
                {
                    return  make_leaf_sub_pos(child, lsize).visit(v, args);
                }
                else
                {
                    return  make_regular_sub_pos(child, pos.shift_ - B, lsize).visit(v, args);
                }
            }
        }

        ns._last_sub(p, args)
    };

    #define (_.first_sub()): [](p: regular_sub_pos, v: visitor_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template first_sub: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _first_sub: (pos: Pos, args: ArgsT) ~> v.result_t
            {
                is_leaf = pos.shift_ == BL;
                child   = pos.node_->inner[0];
                is_full = pos.size_ >= ((1: size_t) << pos.shift_);

                if (is_full)
                {
                    if (is_leaf)
                    {
                        return  make_full_leaf_pos(child).visit(v, args);
                    }
                    else
                    {
                        return  make_full_pos(child, pos.shift_ - B).visit(v, args);
                    }
                }
                else
                {
                    if (is_leaf)
                    {
                        return  make_leaf_sub_pos(child, pos.size_).visit(v, args);
                    }
                    else
                    {
                        return  make_regular_sub_pos(child, pos.shift_ - B, pos.size_).visit(v, args);
                    }
                }
            }
        }

        ns._first_sub(p, args)
    };

    #define (_.first_sub_leaf()): [](p: regular_sub_pos, v: visitor_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template first_sub_leaf: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _first_sub_leaf: (pos: Pos, args: ArgsT) ~> v.result_t
            {
                v_assert(pos.shift_ == BL);
                child   = pos.node_->inner[0];
                is_full = pos.size_ >= branches(BL);

                if (is_full)
                {
                    return  make_full_leaf_pos(child).visit(v, args);
                }
                else
                {
                    return  make_leaf_sub_pos(child, pos.size_).visit(v, args);
                }
            }
        }

        ns._first_sub_leaf(p, args)
    };

    #define (_.first_sub_inner()): (p: regular_sub_pos, v: visitor_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template first_sub_inner: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _first_sub_inner: (pos: Pos, args: ArgsT) ~> v.result_t
            {
                v_assert(pos.shift_ == BL);
                child   = pos.node_->inner[0];
                is_full = pos.size_ >= branches(BL);

                if (is_full)
                {
                    return  make_full_pos(child, pos.shift_ - B).visit(v, args);
                }
                else
                {
                    return  make_regular_sub_pos(child, pos.shift_ - B, pos.size_).visit(v, args);
                }
            }
        }

        ns._first_sub_inner(p, args)
    };

    #define (_.nth_sub()): [](p: regular_sub_pos, v: visitor_t, idx: count_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template nth_sub: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _nth_sub: (pos: Pos, idx: count_t, args: ArgsT) ~> v.result_t
            {
                v_assert(idx < pos.count_);
                is_leaf = pos.shift_ == BL;
                child   = pos.node_->inner[idx];
                lsize   = pos.size(idx);
                is_full = idx + 1 < pos.count;

                if (is_full)
                {
                    if (is_leaf)
                    {
                        return  make_full_leaf_pos(child).visit(v, args);
                    }
                    else
                    {
                        return  make_full_pos(child, pos.shift_ - B).visit(v, args);
                    }
                }
                else
                {
                    if (is_leaf)
                    {
                        return  make_leaf_sub_pos(child, lsize).visit(v, args);
                    }
                    else
                    {
                        return  make_regular_sub_pos(child, pos.shift_ - B, lsize).visit(v, args);
                    }
                }
            }
        }

        ns._nth_sub(p, idx, args)
    };

    #define (_.nth_sub_leaf()): [](p: regular_sub_pos, v: visitor_t, idx: count_t, args)  =
    {
        Pos   = regular_sub_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template nth_sub_leaf: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _nth_sub_leaf: (pos: Pos, idx: count_t, args: ArgsT) ~> v.result_t
            {
                v_assert(pos.shift_ == BL);
                child   = pos.node_->inner[idx];
                lsize   = pos.size(idx);
                is_full = idx + 1 < pos.count;

                if (is_full)
                {
                    return  make_full_leaf_pos(child).visit(v, args);
                }
                else
                {
                    return  make_leaf_sub_pos(child, lsize).visit(v, args);
                }
            }
        }

        ns._nth_sub_leaf(p, idx, args)
    };

    #define (_.visit()): [](p: regular_sub_pos, v: visitor_t, args)
      =  v.visit_regular(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_regular_sub_pos: [](node, shift: shift_t, size: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    _instantiate_regular_sub_pos(ns, NodeT);

    v_assert(node);
    v_assert(shift >= ns.BL);
    v_assert(size > 0);
    v_assert(size <= (branches(ns.BL, size_t) << shift));

    ret: ns.regular_sub_pos = {node, shift, size};

    ret
};


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
#define position_shift: [](NodeT: v_static_type_t, Shift: shift_t) ~> v_static_namespace_t  =
{
    ns = v_generic_ns(position_shift_ns, T(NodeT), N(Shift));

    #template [ns, NodeT]()
    {
        using namespace position(NodeT);
    }

    ns
};


//---------------------------------------------------------------------
//- regular_descent_pos
//---------------------------------------------------------------------
#template _instantiate_regular_descent_pos: [](NS, NodeT: v_static_type_t, Shift: shift_t)
{
    #assert (Shift > 0)         //- Not leaf...

    struct regular_descent_pos
    {
        node_: *NodeT;
    };

    namespace regular_descent_pos
    {
        using namespace NS;
    }

    alwaysinline
    (_.node): (pos: regular_descent_pos) ~> *NodeT  =  pos.node_;

    alwaysinline
    (_.shift): (regular_descent_pos) ~> shift_t  =  Shift;

    alwaysinline
    (_.index()): (regular_descent_pos, idx: size_t) ~> count_t  =  ((idx >> Shift) & mask(BL) : count_t);


    private _Shift = Shift;         //- Sic!

    #define (_.descend()): [*, _Shift](pos: regular_descent_pos, v: visitor_t, idx: size_t)  =
    {
        offset = pos.index(idx);
        child  = pos.node_->inner[offset];

        #if (_Shift == BL)

            make_leaf_descent_pos(child).visit(v, idx)

        #else

            make_regular_descent_pos(_Shift - B, child).visit(v, idx)

        #endif
    };

    #define (_.visit()): [](p: regular_descent_pos, v: visitor_t, args)
      =  v.visit_regular(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_regular_descent_pos: [](Shift: shift_t, node)  =
{
    NodeT = typeof(node).element_type;

    ns = position_shift(NodeT, Shift);

    _instantiate_regular_descent_pos(ns, NodeT, Shift);

    ret: ns.regular_descent_pos = {node};

    ret
};


//---------------------------------------------------------------------
//- ...
//---------------------------------------------------------------------
#define regular_descent_args: [](NodeT: v_static_type_t,
                                 Vis: visitor_t) ~> v_static_namespace_t  =
{
    ns = v_generic_ns(regular_descent_args_ns, Q(v_namespace_get_name(Vis)), T(NodeT));
    ns
};

//---------------------------------------------------------------------
//- visit_regular_descent
//---------------------------------------------------------------------
#template _instantiate_visit_regular_descent: [](NS, NodeT: v_static_type_t, Vis: visitor_t)
{
    private B  = NodeT.bits;
    private BL = NodeT.bits_leaf;

    linkonce_odr
    _visit_regular_descent: (node: *NodeT, shift: shift_t, idx: size_t) ~> Vis.result_t
    {
        v_assert(node);
        v_assert(shift >= BL);

        switch(shift)
        {
        case BL+B*0:  return  make_regular_descent_pos(BL+B*0, node).visit(Vis, idx);
        case BL+B*1:  return  make_regular_descent_pos(BL+B*1, node).visit(Vis, idx);
        case BL+B*2:  return  make_regular_descent_pos(BL+B*2, node).visit(Vis, idx);
        case BL+B*3:  return  make_regular_descent_pos(BL+B*3, node).visit(Vis, idx);
        case BL+B*4:  return  make_regular_descent_pos(BL+B*4, node).visit(Vis, idx);
        case BL+B*5:  return  make_regular_descent_pos(BL+B*5, node).visit(Vis, idx);

        default:      //- IMMER_DESCENT_DEEP...
          {
            node: &*NodeT := node;

            for (level: &shift_t := sift; level != endshift(B, BL); level -= B)
            {
                node := node->inner[(idx >> level) & mask(B)];
            }

            return  make_leaf_descent_pos(node).visit(Vis, idx);
          }
        }
    }
}

//---------------------------------------------------------------------
#define visit_regular_descent: (node, Vis: visitor_t, shift: shift_t, idx: size_t)  =
{
    NodeT = typeof(node).element_type;

    ns = regular_descent_args(NodeT, Vis);

    _instantiate_visit_regular_descent(ns, NodeT, Vis);

    ns._visit_regular_descent(node, shift, idx)
};


//---------------------------------------------------------------------
//- full_pos
//---------------------------------------------------------------------
#template _instantiate_full_pos: [](NS, NodeT: v_static_type_t)
{
    struct full_pos
    {
        node_:  *NodeT;
        shift_: shift_t;
    };

    namespace full_pos
    {
        using namespace NS;
    }


    alwaysinline
    (_.count): (full_pos) ~> count_t  =  branches(B);

    alwaysinline
    (_.node): (pos: full_pos) ~> *NodeT  =  pos.node_;

    alwaysinline
    (_.size): (pos: full_pos) ~> size_t  =  branches(B, size_t) << pos.shift_;

    alwaysinline
    (_.shift): (pos: full_pos) ~> shift_t  =  pos.shift_;

    alwaysinline
    (_.index()): (pos: full_pos, idx: size_t) ~> count_t  =  ((idx >> pos.shift_) & mask(B) : count_t);

    alwaysinline
    (_.subindex()): (pos: full_pos, idx: size_t) ~> count_t  =  (idx >> pos.shift_ : count_t);

    alwaysinline
    (_.size()): (pos: full_pos, count_t) ~> size_t  =  (1: size_t) << pos.shift_;

    alwaysinline
    (_.size_sbh()): (pos: full_pos, count_t, size_t) ~> size_t  =  (1: size_t) << pos.shift_;

    alwaysinline
    (_.size_before()): (pos: full_pos, offset: count_t) ~> size_t  =  (offset: size_t) << pos.shift_;

    inlinehint
    (_.copy_sizes()): (pos: full_pos, offset: count_t, n: count_t, init: size_t, sizes: *size_t) ~> void
    {
        e = sizes + n;

        sizes: &*size_t := sizes;
        init:  &size_t  := init;

        for (; sizes != e; ++sizes)
        {
            init := *sizes := init + ((1: size_t) << pos.shift_);
            v_assert(init);
        }
    }


    #define (_.each()): [](p: full_pos, v: visitor_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template each: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _each: (pos: Pos, args: ArgsT) ~> void
            {
                p: &*NT := pos.node_->inner;
                e        = p + branches(B);

                if (pos.shift_ == BL)
                {
                    for (; p != e; ++p)
                    {
                        make_full_leaf_pos(*p).visit(v, args);
                    }
                }
                else
                {
                    ss = pos.shift_ - B;

                    for (; p != e; ++p)
                    {
                        make_full_pos(*p, ss).visit(v, args);
                    }
                }
            }
        }

        ns._each(p, args)
    };

    #define (_.each_pred()): [](p: full_pos, v: visitor_t, args) ~> bool  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template each_pred: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _each_pred: (pos: Pos, args: ArgsT) ~> bool
            {
                p: &*NT := pos.node_->inner;
                e        = p + branches(B);

                if (pos.shift_ == BL)
                {
                    for (; p != e; ++p)
                    {
                        if (!make_full_leaf_pos(*p).visit(v, args))  return false;
                    }
                }
                else
                {
                    ss = pos.shift_ - B;

                    for (; p != e; ++p)
                    {
                        if (!make_full_pos(*p, ss).visit(v, args))   return false;
                    }
                }

                return true;
            }
        }

        ns._each_pred(p, args)
    };

    #define (_.each_pred_zip()): [](p: full_pos, v: visitor_t, other: *node_t, args) ~> bool  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template each_pred_zip: [ns, Pos, v, ArgsT]()
        {
            private NT = Pos.node_t;

            inlinehint
            _each_pred_zip: (pos: Pos, other: *NT, args: ArgsT) ~> bool
            {
                p:  &*NT := pos.node_->inner;
                p2: &*NT := other->inner;
                e         = p + branches(B);

                if (pos.shift_ == BL)
                {
                    for (; p != e; ++p, ++p2)
                    {
                        if (!make_full_leaf_pos(*p).visit(v, {*p2, args}))  return false;
                    }
                }
                else
                {
                    ss = pos.shift_ - B;

                    for (; p != e; ++p, ++p2)
                    {
                        if (!make_full_pos(*p, ss).visit(v, {*p2, args}))  return false;
                    }
                }

                return true;
            }
        }

        ns._each_pred_zip(p, other, args)
    };

    #define (_.each_pred_i()): [](p: full_pos, v: visitor_t, i: count_t, n: count_t, args) ~> bool  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template each_pred_i: [ns, Pos, v, ArgsT]()
        {
            private NT = Pos.node_t;

            inlinehint
            _each_pred_i: (pos: Pos, i: count_t, n: count_t, args: ArgsT) ~> bool
            {
                p: &*NT := pos.node_->inner + i;
                e        = pos.node_->inner + n;

                if (pos.shift_ == BL)
                {
                    for (; p != e; ++p)
                    {
                        if (!make_full_leaf_pos(*p).visit(v, args))  return false;
                    }
                }
                else
                {
                    ss = pos.shift_ - B;

                    for (; p != e; ++p)
                    {
                        if (!make_full_pos(*p, ss).visit(v, args))  return false;
                    }
                }

                return true;
            }
        }

        ns._each_pred_i(p, i, n, args)
    };

    #define (_.each_i()): [](p: full_pos, v: visitor_t, i: count_t, n: count_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template each_i: [ns, Pos, v, ArgsT]()
        {
            private NT = Pos.node_t;

            inlinehint
            _each_i_full: (pos: Pos, i: count_t, n: count_t, args: ArgsT) ~> void
            {
                p: &*NT := pos.node_->inner + i;
                e        = pos.node_->inner + n;

                if (pos.shift_ == BL)
                {
                    for (; p != e; ++p)
                    {
                        make_full_leaf_pos(*p).visit(v, args);
                    }
                }
                else
                {
                    ss = pos.shift_ - B;

                    for (; p != e; ++p)
                    {
                        make_full_pos(*p, ss).visit(v, args);
                    }
                }
            }
        }

        ns._each_i(p, i, n, args)
    };

    #define (_.each_pred_right()): [](p: full_pos, v: visitor_t, start: count_t, args) ~> bool
      =  p.each_pred_i(v, start, branches(B), args);

    #define (_.each_pred_left()): [](p: full_pos, v: visitor_t, last: count_t, args) ~> bool
      =  p.each_pred_i(v, 0, last, args);

    #define (_.each_sub()): [](p: full_pos, v: visitor_t, args)
      =  p.each(v, args);

    #define (_.each_left_sub()): [](p: full_pos, v: visitor_t, args)
      =  p.each_i(v, 0, branches(B) - 1, args);

    #define (_.each_right_sub()): [](p: full_pos, v: visitor_t, args)
      =  p.each_i(v, 1, branches(B), args);

    #define (_.each_right()): [](p: full_pos, v: visitor_t, start: count_t, args)
      =  p.each_i(v, start, branches(B), args);

    #define (_.each_left()): [](p: full_pos, v: visitor_t, last: count_t, args)
      =  p.each_i(v, 0, last, args);

    #define (_.towards()): [](p: full_pos, v: visitor_t, idx: size_t, args)
      =  p.towards_oh(v, idx, p.index(idx), args);

    #define (_.towards_oh_ch()): [](p: full_pos, v: visitor_t,
                                    idx: size_t,
                                    offset_hint: count_t,
                                    count_hint: count_t,
                                    args)
      =  p.towards_oh(v, idx, offset_hint, args);

    #define (_.towards_oh()): [](p: full_pos, v: visitor_t, idx: size_t, offset_hint: count_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template towards_oh: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _towards_oh: (pos: Pos, idx: size_t, offset_hint: count_t, args: ArgsT) ~> v.result_t
            {
                v_assert(offset_hint == pos.index(idx));

                is_leaf = pos.shift_ == BL;
                child   = pos.node_->inner[offset_hint];

                if (is_leaf)
                {
                    return  make_full_leaf_pos(child).visit(v, {idx, args});
                }
                else
                {
                    return  make_full_pos(child, pos.shift_ - B).visit(v, {idx, args});
                }
            }
        }

        ns._towards_oh(p, idx, offset_hint, args)
    };

    #define (_.towards_sub_oh()): [](p: full_pos, v: visitor_t, idx: size_t, offset_hint: count_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template towards_sub_oh: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _towards_sub_oh: (pos: Pos, idx: size_t, offset_hint: count_t, args: ArgsT) ~> v.result_t
            {
                v_assert(offset_hint == pos.index(idx));

                is_leaf = pos.shift_ == BL;
                child   = pos.node_->inner[offset_hint];
                lsize   = (offset_hint: size_t) << pos.shift_;

                if (is_leaf)
                {
                    return  make_full_leaf_pos(child).visit(v, {idx - lsize, args});
                }
                else
                {
                    return  make_full_pos(child, pos.shift_ - B).visit(v, {idx - lsize, args});
                }
            }
        }

        ns._towards_sub_oh(p, idx, offset_hint, args)
    };

    #define (_.first_sub()): [](p: full_pos, v: visitor_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template first_sub: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _first_sub: (pos: Ppos, args: ArgsT) ~> v.result_t
            {
                v_assert(offset_hint == pos.index(idx));

                is_leaf = pos.shift_ == BL;
                child   = pos.node_->inner[0];

                if (is_leaf)
                {
                    return  make_full_leaf_pos(child).visit(v, args);
                }
                else
                {
                    return  make_full_pos(child, pos.shift_ - B).visit(v, args);
                }
            }
        }

        ns._first_sub(p, args)
    };

    #define (_.first_sub_leaf()): [](p: full_pos, v: visitor_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template first_sub_leaf: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _first_sub_leaf: (pos: Pos, args: ArgsT) ~> v.result_t
            {
                v_assert(pos.shift_ == BL);
                child = pos.node_->inner[0];

                return  make_full_leaf_pos(child).visit(v, args);
            }
        }

        ns._first_sub_leaf(p, args)
    };

    #define (_.first_sub_inner()): (p: full_pos, v: visitor_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template first_sub_inner: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _first_sub_inner: (pos: Pos, args: ArgsT) ~> v.result_t
            {
                v_assert(pos.shift_ >= BL);
                child = pos.node_->inner[0];

                return  make_full_pos(child, pos.shift_ - B).visit(v, args);
            }
        }

        ns._first_sub_inner(p, args)
    };

    #define (_.nth_sub()): [](p: full_pos, v: visitor_t, idx: count_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template nth_sub: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _nth_sub: (pos: Pos, idx: count_t, args: ArgsT) ~> v.result_t
            {
                v_assert(idx < pos.count);

                is_leaf = pos.shift_ == BL;
                child   = pos.node_->inner[idx];

                if (is_leaf)
                {
                    return  make_full_leaf_pos(child).visit(v, args);
                }
                else
                {
                    return  make_full_pos(child, pos.shift_ - B).visit(v, args);
                }
            }
        }

        ns._nth_sub(p, idx, args)
    };

    #define (_.nth_sub_leaf()): [](p: full_pos, v: visitor_t, idx: count_t, args)  =
    {
        Pos   = full_pos;
        ArgsT = typeof(args);

        ns = position_args(Pos, v, ArgsT);

        #template nth_sub_leaf: [ns, Pos, v, ArgsT]()
        {
            inlinehint
            _nth_sub_leaf: (pos: Pos, idx: count_t, args: ArgsT) ~> v.result_t
            {
                v_assert(pos.shift_ == BL);
                v_assert(idx < pos.count);
                child = pos.node_->inner[idx];

                return  make_full_leaf_pos(child).visit(v, args);
            }
        }

        ns._nth_sub_leaf(p, idx, args)
    };

    #define (_.visit()): [](p: full_pos, v: visitor_t, args)
      =  v.visit_regular(p, args);

}   //- #template

//---------------------------------------------------------------------
#define make_full_pos: [](node, shift: shift_t)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    _instantiate_full_pos(ns, NodeT);

    v_assert(node);
    v_assert(shift >= ns.BL);

    ret: ns.full_pos = {node, shift};

    ret
};



























//---------------------------------------------------------------------
}   //- namespace rbts
}   //- namespace detail
}   //- namespace .immer

