#define _instantiate_towards_oh_full: [](Pos: v_static_type_t, Vis: v_static_namespace_t,
                                         ArgsT: v_static_type_t)
{'unit_defn_list'

    namespace position_args(Pos, Vis, ArgsT)
    {
        inlinehint
        _towards_oh_full: (pos: Pos, idx: size_t, offset_hint: count_t, args: ArgsT) ~> Vis.result_t
        {
            v_assert(offset_hint == pos.index(idx));

            is_leaf = pos.shift_ == BL;
            child   = pos.node_->inner[offset_hint];

            if (is_leaf)
            {
                return  make_full_leaf_pos(child).visit(Vis, {idx, args});
            }
            else
            {
                return  make_full_pos(child, pos.shift_ - B).visit(Vis, {idx, args});
            }
        }
    }

