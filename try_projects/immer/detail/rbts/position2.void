{ voidc_import("libvoidc.void"); }
{ voidc_make_header("position"); }
//---------------------------------------------------------------------
{
    v_export_import("bits.void");
    v_export_import("../util.void");
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
//- <immer/detail/rbts/position.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {
namespace rbts {


//---------------------------------------------------------------------
#define position: [](NodeT: v_static_type_t) ~> v_static_namespace_t  =
{
    ns = v_generic_ns(position_ns, T(NodeT));

    #if (!v_defined(ns, node_t))

        v_execute_outer(_instantiate_position, ns, NodeT);

    #endif

    ns
};

//---------------------------------------------------------------------
#define _instantiate_position: [](NS: v_static_namespace_t, NodeT: v_static_type_t)
{'unit_defn_list'

    namespace (NS)
    {
        node_t    = NodeT;
        B         = NodeT.bits;
        BL        = NodeT.bits_leaf;
        value_t   = NodeT.value_t;
        relaxed_t = NodeT.relaxed_t;
    }

'unit_defn_list'}


//---------------------------------------------------------------------
//- empty_regular_pos
//---------------------------------------------------------------------
#define _instantiate_empty_regular_pos: [](NodeT: v_static_type_t)
{'unit_defn_list'

    namespace position(NodeT)
    {
        struct empty_regular_pos
        {
            node_: *NodeT;
        };

        namespace empty_regular_pos
        {
            using namespace position(NodeT);
        }

        alwaysinline
        (_.count): (empty_regular_pos) ~> count_t  =  0;

        alwaysinline
        (_.node): (pos: empty_regular_pos) ~> *NodeT  =  pos.node_;

        alwaysinline
        (_.shift): (empty_regular_pos) ~> shift_t  =  0;

        alwaysinline
        (_.size): (empty_regular_pos) ~> size_t  =  0;


        #define (_.each()): [](p: empty_regular_pos, v: v_static_namespace_t, args) ~> void  =  {};

        #define (_.each_pred()): [](p: empty_regular_pos, v: v_static_namespace_t, args) ~> bool  =  true;

        #define (_.visit()): [](p: empty_regular_pos, v: v_static_namespace_t, args)
          =  v.visit_regular({p, args});

    }   //- namespace position(NodeT)

'unit_defn_list'}

//---------------------------------------------------------------------
#define make_empty_regular_pos: [](node)  =
{
    NodeT = typeof(node).element_type;

    ns = position(NodeT);

    #if (!v_defined(ns, empty_regular_pos))

        v_execute_outer(_instantiate_empty_regular_pos, NodeT);

    #endif

    ret: ns.empty_regular_pos = {node};

    ret
};


