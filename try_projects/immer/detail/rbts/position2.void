    {
        linkonce_odr
        _each_left_regular: (p: Pos, last: count_t, args: ArgsT) ~> void
        {
            v_assert(last < p.count);

            if (p.shift == BL)
            {
                n: &*node_t := p.node->inner;
                e:  *node_t  = n + last;

                for (; n != e; ++n)
                {
                    make_full_leaf_pos(*n).visit(Vis, args);
                }
            }
            else
            {
                n: &*node_t := p.node->inner;
