{ voidc_import("libvoidc.void"); }
{ voidc_make_header("rbtree"); }
//---------------------------------------------------------------------
{
    v_import("../../config.void");
    v_export_import("node.void");
    v_export_import("operations.void");
    v_export_import("position.void");

    v_import("cstdio.void");        //- ?
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
//- <immer/detail/rbts/rbtree.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {
namespace rbts {


//---------------------------------------------------------------------
#define rbtree: [](T: v_static_type_t, MemoryPolicy: v_static_namespace_t,
                   B: bits_t, BL: bits_t) ~> v_static_type_t  =
{
    rbt = v_generic(".immer.detail.rbts.rbtree", T(T), Q(v_namespace_get_name(MemoryPolicy)), N[B,BL]);

    _instantiate_rbtree(rbt, T, MemoryPolicy, B, BL);

    rbt
};

//---------------------------------------------------------------------
#template _instantiate_rbtree: [](RBT: v_static_type_t, T: v_static_type_t,
                                  MemoryPolicy: v_static_namespace_t,
                                  B: bits_t, BL: bits_t)
{
    using namespace .immer.detail.rbts;

    node_t   = node(T, MemoryPolicy, B, BL);
    rbtree_t = RBT;

    max_size = (1: size_t) << ((size_t.width - BL)/B * B + BL);

    struct impl_t
    {
        size:  size_t;
        shift: shift_t;
        root:  *node_t;
        tail:  *node_t;
    };

    #do (v_set_implementation_type(rbtree_t, impl_t))

    inlinehint
    (v_initialize(_)): (p: *rbtree_t) ~> void
    {
        impl = *(p: *impl_t);

        empty_root = node_t.make_inner_n(0);                //- TODO !!!
        empty_tail = node_t.make_leaf_n(0);                 //- TODO !!!

        impl := { 0, BL, empty_root, empty_tail };
    }

    inlinehint
    (v_terminate(_)): (p: *rbtree_t) ~> void;

    inlinehint
    (v_copy(_)): (d: *rbtree_t, s: *const rbtree_t) ~> void;

    inlinehint
    (v_move(_)): (d: *rbtree_t, s: *rbtree_t) ~> void;

    inlinehint
    (v_empty(_)): (p: *rbtree_t) ~> bool  =
    {
        impl = *(p: *const impl_t);

        impl.size == 0
    };

    inlinehint
    (_:=_): (d: &rbtree_t, s: rbtree_t) ~> &rbtree_t  =
    {
        v_copy(&d, &s);

        d
    };

    inlinehint
    (_.inc): (self: &const rbtree_t) ~> void
    {
        impl = *(&self: *const impl_t);

        impl.root->inc;
        impl.tail->inc;
    }

    inlinehint
    (_.dec): (self: &const rbtree_t) ~> void;

    inlinehint
    (v_terminate(_)): (p: *rbtree_t) ~> void
    {
        p->dec;
    }

    inlinehint
    (v_copy(_)): (d: *rbtree_t, s: *const rbtree_t) ~> void
    {
        d->dec;

        di = *(d: *impl_t);
        si = *(s: *const impl_t);

        di := si;

        d->inc;
    }

    inlinehint
    (v_move(_)): (d: *rbtree_t, s: *rbtree_t) ~> void
    {
        d->dec;

        di = *(d: *impl_t);
        si = *(s: *impl_t);

        di := si;

        s->dec;
    }

    private alwaysinline
    make: (sz: size_t, sh: shift_t, r: *node_t, t: *node_t) ~> rbtree_t
    {
        ret = v_get_return_value();

        ret.dec;

        impl = *(&ret: *impl_t);

        impl := {sz, sh, r, t};         //- Sic !!!
    }

    inlinehint
    (_.tail_size): (self: rbtree_t) ~> size_t  =
    {
        impl = *(&self: *const impl_t);

        util.if_(impl.size,  ((impl.size - 1) & mask(BL)) + 1,  0)
    };

    inlinehint
    (_.tail_offset): (self: rbtree_t) ~> size_t  =
    {
        impl = *(&self: *const impl_t);

        util.if_(impl.size,  (impl.size - 1) & ~mask(BL),  0)
    };

    #define (_.traverse()): [](self: rbtree_t, v: visitor_t, args)
    {'stmt_list'

        impl = *(&self: *const impl_t);

        tail_off  = self.tail_offset;
        tail_size = impl.size - tail_off;

        if (tail_off)
            make_regular_sub_pos(impl.root, impl.shift, tail_off).visit(v, args);
        else
            make_empty_regular_pos(impl.root).visit(v, args);

        make_leaf_sub_pos(impl.tail, (tail_size: count_t)).visit(v, args);

    'stmt_list'}

    inlinehint
    (_.dec): (self: &const rbtree_t) ~> void  { self.traverse(dec_visitor, {}); }

    #define (_.traverse_i()): [](self: rbtree_t, v: visitor_t, first: size_t, last: size_t, args)
    {'stmt_list'

        impl = *(&self: *const impl_t);

        tail_off  = self.tail_offset;
        tail_size = impl.size - tail_off;

        if (first < tail_off)
        {
            make_regular_sub_pos(impl.root, impl.shift, tail_off)
                .visit(v, {first, util.min(last, tail_off), args});
        }

        if (last > tail_off)
        {
            make_leaf_sub_pos(impl.tail, (tail_size: count_t))
                .visit(v,
                       {util.if_(first > tail_off, first - tail_off, 0),
                       last - tail_off,
                       args});
        }

    'stmt_list'}

    #define (_.traverse_p()): [](self: rbtree_t, v: visitor_t, args) ~> bool  =
    {
        impl = *(&self: *const impl_t);

        tail_off  = self.tail_offset;
        tail_size = impl.size - tail_off;

        r: &bool := undef;

        if (tail_off)
            r := make_regular_sub_pos(impl.root, impl.shift, tail_off).visit(v, args);
        else
            r := make_empty_regular_pos(impl.root).visit(v, args);

        r  &&  make_leaf_sub_pos(impl.tail, (tail_size: count_t)).visit(v, args)
    };

    #define (_.traverse_p_i()): [](self: rbtree_t, v: visitor_t, first: size_t, last: size_t, args) ~> bool  =
    {
        impl = *(&self: *const impl_t);

        tail_off  = self.tail_offset;
        tail_size = impl.size - tail_off;

        r: &bool := true;

        if (first < tail_off)
        {
            r := make_regular_sub_pos(impl.root, impl.shift, tail_off)
                     .visit(v, {first, util.min(last, tail_off), args});
        }

        if (r  &&  last > tail_off)
        {
            r := make_leaf_sub_pos(impl.tail, (tail_size: count_t))
                     .visit(v,
                            {util.if_(first > tail_off, first - tail_off, 0),
                            last - tail_off,
                            args});
        }

        r
    };

    #define (_.descend()): [](self: rbtree_t, v: visitor_t, idx: size_t)  =
    {
        is_reference = v.result_t.is_reference;

        #if (is_reference)  ret_t = *v.result_t.element_type;
        #else               ret_t = v.result_t;
        #endif

        impl = *(&self: *const impl_t);

        tail_off = self.tail_offset;

        ret: &ret_t := undef;

        #if (is_reference)

            if (idx >= tail_off)  ret := &make_leaf_descent_pos(impl.tail).visit(v, idx);
            else                  ret := &visit_regular_descent(impl.root, impl.shift, v, idx);

            ret = *ret;

        #else

            if (idx >= tail_off)  ret := make_leaf_descent_pos(impl.tail).visit(v, idx);
            else                  ret := visit_regular_descent(impl.root, impl.shift, v, idx);

            ret = (ret: ret_t);

        #endif

        ret
    };

    #define (_.for_each_chunk()): [](selt: rbtree_t, fn)
    {'stmt'
        self.traverse(for_each_chunk_visitor, fn);
    'stmt'}

    #define (_.for_each_chunk_i()): [](selt: rbtree_t, first: size_t, last: size_t, fn)
    {'stmt'
        self.traverse_i(for_each_chunk_i_visitor, first, last, fn);
    'stmt'}

    #define (_.for_each_chunk_p()): [](selt: rbtree_t, fn) ~> bool
      =  self.traverse_p(for_each_chunk_p_visitor, fn);

    #define (_.for_each_chunk_p_i()): [](selt: rbtree_t, first: size_t, last: size_t, fn) ~> bool
      =  self.traverse_p_i(for_each_chunk_p_i_visitor, first, last, fn);

    inlinehint
    (_.equals()): (self: rbtree_t, other: rbtree_t) ~> bool
    {
        si = *(&self:  *const impl_t);
        oi = *(&other: *const impl_t);

        if (si.size != oi.size)  return  false;

        if (si.size == 0)  return  true;

        return  (si.size <= branches(BL)  ||
                 make_regular_sub_pos(si.root, si.shift, self.tail_offset)
                     .visit(equals_visitor, oi.root))  &&
                 make_leaf_sub_pos(si.tail, (self.tail_size: count_t))
                     .visit(equals_visitor, oi.tail);
    }







    inlinehint
    (_.push_back()): (self: rbtree_t, value: T) ~> rbtree_t
    {
        impl = *(&self: *const impl_t);

        tail_off = self.tail_offset;
        ts       = impl.size - tail_off;

        if (ts < branches(BL))
        {
            new_tail = node_t.copy_leaf_emplace(impl.tail, (ts: count_t), value);
            return  make(impl.size + 1, impl.shift, impl.root->inc, new_tail);
        }
        else
        {
            new_tail = node_t.make_leaf_n1(1, value);

            if (tail_off == branches(B) << impl.shift)
            {
                new_root = node_t.make_inner_n(2);

                path                = node_t.make_path(impl.shift, impl.tail);
                new_root->inner[0] := impl.root;
                new_root->inner[1] := path;
                impl.root->inc;
                impl.tail->inc;
                return  make(impl.size + 1, impl.shift + B, new_root, new_tail);
            }
            else if (tail_off)
            {
                new_root = make_regular_sub_pos(impl.root, impl.shift, tail_off)
                               .visit(push_tail_visitor(node_t), impl.tail);
                impl.tail->inc;
                return  make(impl.size + 1, impl.shift, new_root, new_tail);
            } else {
                new_root = node_t.make_path(impl.shift, impl.tail);
                impl.tail->inc;
                return  make(impl.size + 1, impl.shift, new_root, new_tail);
            }
        }
    }

    inlinehint
    (_.get()): (self: rbtree_t, index: size_t) ~> &const T
      =  self.descend(get_visitor(T), index);











}   //- #template








//---------------------------------------------------------------------
}   //- namespace rbts
}   //- namespace detail
}   //- namespace .immer

