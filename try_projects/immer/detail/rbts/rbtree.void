{ voidc_import("libvoidc.void"); }
{ voidc_make_header("rbtree"); }
//---------------------------------------------------------------------
{
//  v_import("../../config.void");
    v_export_import("node.void");
    v_export_import("operations.void");
    v_export_import("position.void");

    v_import("cstdio.void");        //- ?
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
//- <immer/detail/rbts/rbtree.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {
namespace rbts {


//---------------------------------------------------------------------
#define rbtree: [](T: v_static_type_t, MemoryPolicy: v_static_namespace_t,
                   B: bits_t, BL: bits_t) ~> v_static_type_t  =
{
    rbt = v_generic(".immer.detail.rbts.rbtree", T(T), Q(v_namespace_get_name(MemoryPolicy)), N[B,BL]);

    _instantiate_rbtree(rbt, T, MemoryPolicy, B, BL);

    rbt
};

//---------------------------------------------------------------------
#template _instantiate_rbtree: [](RBT: v_static_type_t, T: v_static_type_t,
                                  MemoryPolicy: v_static_namespace_t,
                                  B: bits_t, BL: bits_t)
{
    using namespace .immer.detail.rbts;

    node_t   = node(T, MemoryPolicy, B, BL);
    rbtree_t = RBT;

    max_size = (1: size_t) << ((size_t.width - BL)/B * B + BL);

    struct impl_t
    {
        size:  size_t;
        shift: shift_t;
        root:  *node_t;
        tail:  *node_t;
    };

    #do (v_set_implementation_type(rbtree_t, impl_t),
         v_make_trivial_coercion(v_coe_projective,  rbtree_t, &const impl_t),
         v_make_trivial_coercion(v_coe_projective, &rbtree_t, &impl_t),
         v_make_trivial_coercion(v_coe_projective, *rbtree_t, *impl_t))

    alwaysinline empty_root: () ~> *node_t  =  node_t.make_inner_n(0);      //- TODO !!!
    alwaysinline empty_tail: () ~> *node_t  =  node_t.make_leaf_n(0);       //- TODO !!!

    inlinehint
    (v_initialize(_)): (p: *rbtree_t) ~> void
    {
        *(p: *impl_t) := { 0, BL, empty_root(), empty_tail() };
    }

    inlinehint
    (v_terminate(_)): (p: *rbtree_t) ~> void;

    inlinehint
    (v_copy(_)): (d: *rbtree_t, s: *const rbtree_t) ~> void;

    inlinehint
    (v_move(_)): (d: *rbtree_t, s: *rbtree_t) ~> void;

    inlinehint
    (v_empty(_)): (p: *rbtree_t) ~> bool  =  p->size == 0;

    inlinehint
    (_:=_): (d: &rbtree_t, s: rbtree_t) ~> &rbtree_t  =
    {
        v_copy(&d, &s);

        d
    };

    inlinehint
    (_.inc): (self: &const rbtree_t) ~> void
    {
        self.root->inc;
        self.tail->inc;
    }

    inlinehint
    (_.dec): (self: &const rbtree_t) ~> void;

    inlinehint
    (v_terminate(_)): (p: *rbtree_t) ~> void
    {
        p->dec;
    }

    inlinehint
    (v_copy(_)): (d: *rbtree_t, s: *const rbtree_t) ~> void
    {
        d->dec;
        s->inc;

        *(d: *impl_t) := *(s: *const impl_t);
    }

    inlinehint
    (v_move(_)): (d: *rbtree_t, s: *rbtree_t) ~> void
    {
        d->dec;

        *(d: *impl_t) := *(s: *impl_t);

        v_initialize(s);        //- Sic !?!
    }

    private alwaysinline
    make: (sz: size_t, sh: shift_t, r: *node_t, t: *node_t) ~> rbtree_t
    {
        ret = v_get_return_value();

        ret.dec;

        *(&ret: *impl_t) := {sz, sh, r, t};         //- Sic !!!
    }

    inlinehint
    (_.tail_size): (self: rbtree_t) ~> size_t
      =  util.if_(self.size,  ((self.size - 1) & mask(BL)) + 1,  0);

    inlinehint
    (_.tail_offset): (self: rbtree_t) ~> size_t
      =  util.if_(self.size,  (self.size - 1) & ~mask(BL),  0);

    #define (_.traverse()): [](self: rbtree_t, v: visitor_t, args)
    {'stmt_list'

        tail_off  = self.tail_offset;
        tail_size = self.size - tail_off;

        if (tail_off)
            make_regular_sub_pos(self.root, self.shift, tail_off).visit(v, args);
        else
            make_empty_regular_pos(self.root).visit(v, args);

        make_leaf_sub_pos(self.tail, (tail_size: count_t)).visit(v, args);

    'stmt_list'}

    inlinehint
    (_.dec): (self: &const rbtree_t) ~> void  { self.traverse(dec_visitor, {}); }

    #define (_.traverse_i()): [](self: rbtree_t, v: visitor_t, first: size_t, last: size_t, args)
    {'stmt_list'

        tail_off  = self.tail_offset;
        tail_size = self.size - tail_off;

        if (first < tail_off)
        {
            make_regular_sub_pos(self.root, self.shift, tail_off)
                .visit(v, {first, util.min(last, tail_off), args});
        }

        if (last > tail_off)
        {
            make_leaf_sub_pos(self.tail, (self_size: count_t))
                .visit(v,
                       {util.if_(first > tail_off, first - tail_off, 0),
                       last - tail_off,
                       args});
        }

    'stmt_list'}

    #define (_.traverse_p()): [](self: rbtree_t, v: visitor_t, args) ~> bool  =
    {
        tail_off  = self.tail_offset;
        tail_size = self.size - tail_off;

        r: &bool := undef;

        if (tail_off)
            r := make_regular_sub_pos(self.root, self.shift, tail_off).visit(v, args);
        else
            r := make_empty_regular_pos(self.root).visit(v, args);

        r  &&  make_leaf_sub_pos(self.tail, (tail_size: count_t)).visit(v, args)
    };

    #define (_.traverse_p_i()): [](self: rbtree_t, v: visitor_t, first: size_t, last: size_t, args) ~> bool  =
    {
        tail_off  = self.tail_offset;
        tail_size = self.size - tail_off;

        r: &bool := true;

        if (first < tail_off)
        {
            r := make_regular_sub_pos(self.root, self.shift, tail_off)
                     .visit(v, {first, util.min(last, tail_off), args});
        }

        if (r  &&  last > tail_off)
        {
            r := make_leaf_sub_pos(self.tail, (tail_size: count_t))
                     .visit(v,
                            {util.if_(first > tail_off, first - tail_off, 0),
                            last - tail_off,
                            args});
        }

        r
    };

    #define (_.descend()): [](self: rbtree_t, v: visitor_t, idx: size_t)  =
    {
        is_reference = v.result_t.is_reference;

        #if (is_reference)  ret_t = *v.result_t.element_type;
        #else               ret_t = v.result_t;
        #endif

        tail_off = self.tail_offset;

        ret: &ret_t := undef;

        #if (is_reference)

            if (idx >= tail_off)  ret := &make_leaf_descent_pos(self.tail).visit(v, idx);
            else                  ret := &visit_regular_descent(self.root, self.shift, v, idx);

            ret = *ret;

        #else

            if (idx >= tail_off)  ret := make_leaf_descent_pos(self.tail).visit(v, idx);
            else                  ret := visit_regular_descent(self.root, self.shift, v, idx);

            ret = (ret: ret_t);

        #endif

        ret
    };

    #define (_.for_each_chunk()): [](selt: rbtree_t, fn)
    {'stmt'
        self.traverse(for_each_chunk_visitor, fn);
    'stmt'}

    #define (_.for_each_chunk_i()): [](selt: rbtree_t, first: size_t, last: size_t, fn)
    {'stmt'
        self.traverse_i(for_each_chunk_i_visitor, first, last, fn);
    'stmt'}

    #define (_.for_each_chunk_p()): [](selt: rbtree_t, fn) ~> bool
      =  self.traverse_p(for_each_chunk_p_visitor, fn);

    #define (_.for_each_chunk_p_i()): [](selt: rbtree_t, first: size_t, last: size_t, fn) ~> bool
      =  self.traverse_p_i(for_each_chunk_p_i_visitor, first, last, fn);

    inlinehint
    (_.equals()): (self: rbtree_t, other: rbtree_t) ~> bool
    {
        if (self.size != other.size)  return  false;

        if (self.size == 0)  return  true;

        return  (self.size <= branches(BL)  ||
                 make_regular_sub_pos(self.root, self.shift, self.tail_offset)
                     .visit(equals_visitor, other.root))  &&
                 make_leaf_sub_pos(self.tail, (self.tail_size: count_t))
                     .visit(equals_visitor, other.tail);
    }

    inlinehint
    (_.ensure_mutable_tail()): (self: &rbtree_t, n: count_t) ~> void
    {
        if (self.tail->can_mutate)  return;

        new_tail = node_t.copy_leaf_e(self.tail, n);
        dec_leaf(self.tail, n);
        self.tail := new_tail;
    }

    inlinehint
    (_.push_back_mut()): (self: &rbtree_t, value: T) ~> void
    {
        tail_off = self.tail_offset;
        ts       = self.size - tail_off;
        if (ts < branches(BL))
        {
            self.ensure_mutable_tail((ts: count_t));
            util.uninitialized_copy(&self.tail->leaf[ts], &value);
        }
        else
        {
            new_tail = node_t.make_leaf_e1(value);
            if (tail_off == (branches(B) : size_t) << self.shift)
            {
                new_root = node_t.make_inner_e();

                path = node_t.make_path_e(self.shift, self.tail);
                new_root->inner[0] := self.root;
                new_root->inner[1] := path;
                self.root          := new_root;
                self.tail          := new_tail;
                self.shift += B;
            }
            else if (tail_off)
            {
                new_root =
                    make_regular_sub_pos(self.root, self.shift, tail_off)
                        .visit(push_tail_mut_visitor(node_t), self.tail);
                self.root := new_root;
                self.tail := new_tail;
            }
            else
            {
                new_root = node_t.make_path_e(self.shift, self.tail);
                v_assert(tail_off == 0);
                dec_empty_regular(self.root);
                self.root := new_root;
                self.tail := new_tail;
            }
        }
        ++self.size;
    }

    inlinehint
    (_.push_back()): (self: rbtree_t, value: T) ~> rbtree_t
    {
        tail_off = self.tail_offset;
        ts       = self.size - tail_off;

        if (ts < branches(BL))
        {
            new_tail = node_t.copy_leaf_emplace(self.tail, (ts: count_t), value);
            return  make(self.size + 1, self.shift, self.root->inc, new_tail);
        }
        else
        {
            new_tail = node_t.make_leaf_n1(1, value);

            if (tail_off == branches(B) << self.shift)
            {
                new_root = node_t.make_inner_n(2);

                path                = node_t.make_path(self.shift, self.tail);
                new_root->inner[0] := self.root;
                new_root->inner[1] := path;
                self.root->inc;
                self.tail->inc;
                return  make(self.size + 1, self.shift + B, new_root, new_tail);
            }
            else if (tail_off)
            {
                new_root = make_regular_sub_pos(self.root, self.shift, tail_off)
                               .visit(push_tail_visitor(node_t), self.tail);
                self.tail->inc;
                return  make(self.size + 1, self.shift, new_root, new_tail);
            } else {
                new_root = node_t.make_path(self.shift, self.tail);
                self.tail->inc;
                return  make(self.size + 1, self.shift, new_root, new_tail);
            }
        }
    }

    inlinehint
    (_.array_for()): (self: rbtree_t, index: size_t) ~> *const T
      =  self.descend(array_for_visitor(T), index);

    inlinehint
    (_.get_mut()): (self: &rbtree_t, idx: size_t) ~> &T
    {
        tail_off = self.tail_offset;
        if (idx >= tail_off)
        {
            self.ensure_mutable_tail((self.size - tail_off : count_t));
            return  self.tail->leaf[idx & mask(BL)];
        }
        else
        {
            return  make_regular_sub_pos(self.root, self.shift, tail_off)
                        .visit(get_mut_visitor(node_t), {idx, &self.root});
        }
    }

    inlinehint
    (_.get()): (self: rbtree_t, index: size_t) ~> &const T
      =  self.descend(get_visitor(T), index);

    alwaysinline
    (_.front): (self: rbtree_t) ~> &const T  =  self.get(0);

    inlinehint
    (_.back): (self: rbtree_t) ~> &const T  =  self.tail->leaf[(self.size - 1) & mask(BL)];

    #define (_.update_mut()): [*, T](self: &rbtree_t, idx: size_t, fn)
    {'stmt'
        {   elem = self.get_mut(idx);
            elem := fn({e: T = elem; e});           //- WTF !?!?!?!?!
        }
    'stmt'}

    #define (_.update()): [](self: rbtree_t, idx: size_t, fn) ~> rbtree_t  =
    {
        new_root: &*node_t := undef;
        new_tail: &*node_t := undef;

        tail_off = self.tail_offset;
        if (idx >= tail_off)
        {
            tail_size = self.size - tail_off;
            new_tail :=
                make_leaf_sub_pos(self.tail, (tail_size: count_t))
                    .visit(update_visitor(node_t), {idx - tail_off, fn});
            new_root := self.root->inc;
        }
        else
        {
            new_root := make_regular_sub_pos(self.root, self.shift, tail_off)
                            .visit(update_visitor(node_t), {idx, fn});
            new_tail := self.tail->inc;
        }

        make(self.size, self.shift, new_root, new_tail)
    };

    inlinehint
    (_.assoc_mut()): (self: &rbtree_t, idx: size_t, value: T) ~> void
    {
        #define fun: (v) ~> T  =  value;            //- Sic!

        self.update_mut(idx, fun);
    }

    inlinehint
    (_.assoc()): (self: rbtree_t, idx: size_t, value: T) ~> rbtree_t  =
    {
        type = v_generic(".immer.detail.rbts.assoc_function_tag", T(T));

        #template [type, T]()
        {
            #do (v_set_implementation_type(type, T))

            alwaysinline
            (_()): (p: *type, v: T) ~> T  =  *(p: *T);
        }

        fn: &T := value;
        fn = (&fn: *type);

        self.update(idx, fn)
    };

    inlinehint
    (_.take()): (self: rbtree_t, new_size: size_t) ~> rbtree_t
    {
        tail_off = self.tail_offset;
        if (new_size == 0)
        {
            return {};
        }
        else if (new_size >= self.size)
        {
            return self;
        }
        else if (new_size > tail_off)
        {
            new_tail = node_t.copy_leaf(self.tail, (new_size - tail_off : count_t));
            return  make(new_size, self.shift, self.root->inc, new_tail);
        }
        else
        {
            l = new_size - 1;
            v = slice_right_visitor(node_t);
            r = make_regular_sub_pos(self.root, self.shift, tail_off).visit(v, l);
            new_shift = r[0];
            new_root  = r[1];
            new_tail  = r[3];
            if (new_root)
            {
                return make(new_size, new_shift, new_root, new_tail);
            }
            else
            {
                return make(new_size, BL, empty_root(), new_tail);
            }
        }
    }

    inlinehint
    (_.take_mut()): (self: &rbtree_t, new_size: size_t) ~> void
    {
        tail_off = self.tail_offset;
        if (new_size == 0)
        {
            // todo: more efficient?
            self := {};
        }
        else if (new_size >= self.size)
        {
            return;
        }
        else if (new_size > tail_off)
        {
            ts    = self.size - tail_off;
            newts = new_size - tail_off;
            if (self.tail->can_mutate)
            {
                util.conditional_terminate(self.tail->leaf + newts, ts - newts);
            }
            else
            {
                new_tail = node_t.copy_leaf_e(self.tail, (newts: count_t));
                dec_leaf(self.tail, (ts: count_t));
                self.tail := new_tail;
            }
            self.size := new_size;
            return;
        }
        else
        {
            l = new_size - 1;
            v = slice_right_mut_visitor(node_t);
            r = make_regular_sub_pos(self.root, self.shift, tail_off).visit(v, l);
            new_shift = r[0];
            new_root  = r[1];
            new_tail  = r[3];
            if (new_root)
            {
                self.root  := new_root;
                self.shift := new_shift;
            }
            else
            {
                self.root  := empty_root();
                self.shift := BL;
            }
            dec_leaf(self.tail, (self.size - tail_off : count_t));
            self.size := new_size;
            self.tail := new_tail;
            return;
        }
    }



    //- ...



}   //- #template


//---------------------------------------------------------------------
}   //- namespace rbts
}   //- namespace detail
}   //- namespace .immer

