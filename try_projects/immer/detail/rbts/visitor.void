{ voidc_import("libvoidc.void"); }
{ voidc_make_header("visitor"); }
//---------------------------------------------------------------------
{
    v_import("../util.void");
}


//---------------------------------------------------------------------
{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
//- <immer/detail/rbts/visitor.hpp>
//---------------------------------------------------------------------
namespace .immer {
namespace detail {
namespace rbts {


//---------------------------------------------------------------------
visitor_t = v_static_namespace_t;

#define visitor_base: [](Derived: visitor_t) ~> visitor_t  =
{
    ns = v_generic_ns(visitor_base_tag, Q(v_namespace_get_name(Derived)));

    #template [ns, Derived]()
    {
        _base    = ns;
        _derived = Derived;

        #define visit_relaxed: [](pos, args)  =  _derived.visit_inner(pos, args);
        #define visit_regular: [](pos, args)  =  _derived.visit_inner(pos, args);
        #define visit_inner:   [](pos, args)  =  _derived.visit_node(pos, args);
        #define visit_leaf:    [](pos, args)  =  _derived.visit_node(pos, args);
        #define visit_node:    [](pos, args)  =  v_assert(false && "Kinda, unreachable...");
    }

    ns
};


//---------------------------------------------------------------------
}   //- namespace rbts
}   //- namespace detail
}   //- namespace .immer

