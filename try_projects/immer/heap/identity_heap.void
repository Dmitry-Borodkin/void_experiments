{ voidc_import("libvoidc.void"); }
{ voidc_make_header("identity_heap"); }
//---------------------------------------------------------------------
{
    v_import("../config.void");
    v_export_import("../detail/util.void");
}


//---------------------------------------------------------------------
//- <immer/heap/identity_heap.hpp>
//---------------------------------------------------------------------
namespace .immer {


//---------------------------------------------------------------------
#define identity_heap: [](HeapNS: v_static_namespace_t) ~> v_static_namespace_t  =
{
    ih = v_generic_ns(identity_heap_ns, Q(v_namespace_get_name(HeapNS)));

    #if (!v_defined(ih, allocate))

        v_execute_outer(_instantiate_identity_heap, ih, HeapNS);

    #endif

    ih
};

//---------------------------------------------------------------------
#define _instantiate_identity_heap: [](IH: v_static_namespace_t, HeapNS: v_static_namespace_t)
{'unit_defn_list'

    alwaysinline
    IH.allocate: (size: size_t) ~> *void  =  HeapNS.allocate(size);

    alwaysinline
    IH.deallocate: (size: size_t, data: *void) ~> void
    {
        HeapNS.deallocate(size, data);
    }

'unit_defn_list'}


//---------------------------------------------------------------------
}   //- namespace .immer

