{ voidc_import("libvoidc.void"); }
{ voidc_make_header("debug_size_heap"); }
//---------------------------------------------------------------------
{
    v_import("../config.void");
    v_export_import("../detail/util.void");
    v_export_import("identity_heap.void");
}


//---------------------------------------------------------------------
//- <immer/heap/debug_size_heap.hpp>
//---------------------------------------------------------------------
namespace .immer {


#if (IMMER_ENABLE_DEBUG_SIZE_HEAP)

  //---------------------------------------------------------------------
  #define debug_size_heap: [](HeapNS: v_static_namespace_t) ~> v_static_namespace_t  =
  {
    ds = v_generic_ns(debug_size_heap_ns, Q(v_namespace_get_name(HeapNS)));

    #if (!v_defined(ds, allocate))

        v_execute_outer(_instantiate_debug_size_heap, ds, HeapNS);

    #endif

    ds
  };

  //---------------------------------------------------------------------
  #define _instantiate_debug_size_heap: [](DS: v_static_namespace_t, HeapNS: v_static_namespace_t)
  {'unit_defn_list'

    namespace (DS)              //- WTF ?
    {
        extra_size = 16;            //- Kinda  alignof(max_align_t)

        alwaysinline
        allocate: (size: size_t) ~> *void
        {
            p = HeapNS.allocate(extra_size + size);

            *(p: *size_t) := size;

            return  (p: *char) + extra_size;
        }

        alwaysinline
        deallocate: (size: size_t, data: *void) ~> void
        {
            p = (data: *char) - extra_size;

            v_assert(*(p: *size_t) == size);

            HeapNS.deallocate(extra_size + size, p);
        }
    }

  'unit_defn_list'}

#else   //- IMMER_ENABLE_DEBUG_SIZE_HEAP

  debug_size_heap = identity_heap;

#endif  //- IMMER_ENABLE_DEBUG_SIZE_HEAP


//---------------------------------------------------------------------
}   //- namespace .immer

