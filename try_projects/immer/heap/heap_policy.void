{ voidc_import("libvoidc.void"); }
{ voidc_make_header("heap_policy"); }
//---------------------------------------------------------------------
{
    v_import("../config.void");
    v_export_import("malloc_heap.void");
    v_export_import("debug_size_heap.void");
}


//---------------------------------------------------------------------
//- <immer/heap/heap_policy.hpp>
//---------------------------------------------------------------------
namespace .immer {


//---------------------------------------------------------------------
#define heap_policy: [](HeapNS: v_static_namespace_t) ~> v_static_namespace_t  =
{
    hp = v_generic_ns(heap_policy_ns, Q(v_namespace_get_name(HeapNS)));

    #if (!v_defined(hp, heap))

        v_execute_outer(_instantiate_heap_policy, hp, HeapNS);

    #endif

    hp
};

//---------------------------------------------------------------------
#define _instantiate_heap_policy: [](HP: v_static_namespace_t, HeapNS: v_static_namespace_t)
{'unit_defn_list'

    namespace (HP)
    {
        heap = HeapNS;

        #define optimized: [](Size: size_t) ~> v_static_namespace_t  =
        {
            op = v_generic_ns(optimized_ns, N(Size));

            #if (!v_defined(op, optimal_size))

                v_execute_outer(_instantiate_optimized, op, heap, Size);        //- Sic!

            #endif

            op
        };

        #define _instantiate_optimized: [](OP, HeapNS, Size)                    //- Sic!
        {'unit_defn_list'

            namespace (OP)
            {
                optimal_size = Size;        //- ?..

                heap = HeapNS;              //- ?..
            }

        'unit_defn_list'}
    }

'unit_defn_list'}


//---------------------------------------------------------------------
}   //- namespace .immer

