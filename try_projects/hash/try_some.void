{ v_import("mainline.void"); }
{ v_enable_mainline(); }
//---------------------------------------------------------------------
{
    v_import("cstdio.void");

    v_import("try_fnv1a.void");
}


{ v_import("stack_trace.void"); }
{ voidc_enable_stack_trace(); }


//---------------------------------------------------------------------
using namespace my.hash.detail;         //- ?


//---------------------------------------------------------------------
{   using namespace fnv1a_const(uint(32));

    printf("basis: 0x%08x\n", basis);
    printf("prime: 0x%08x\n", prime);
}


//---------------------------------------------------------------------
{   hash: &fnv1a(uint(32)) := {};

    data = "Hello World";

    hash.update(&data, 11);

    h = hash.result;

    printf("h: %x\n", h);
}


//---------------------------------------------------------------------
{
    d: &uint(8)[] := "chongo <Landon Curt Noll> /\\../\\";

    #define check: (T: v_static_type_t) ~> bool  =
    {
        b: &T := 0;

        for (i: &size_t := 0; i < 32; ++i)
        {
            b *= fnv1a_const(T).prime;
            b ^= d[i];
        }

        b == fnv1a_const(T).basis
    };

    v_assert(check(uint(32)));
    v_assert(check(uint(64)));
    v_assert(check(uint(128)));
    v_assert(check(uint(256)));
    v_assert(check(uint(512)));
    v_assert(check(uint(1024)));

    printf("\nOK\n");
}










