export
my_make_expr_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - size;

    ret  = (ast: *v_ast_expr_list_t);
    expr = (ast: *v_ast_expr_t);

    if (size) v_make_list(ret, expr, size);
    else      v_make_list_nil(ret);

    top := ret + 1;

    cmd += 1;
}

export
my_append_expr_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - (size + 1);

    ret  = (ast   : *v_ast_expr_list_t);
    expr = (ast+1 : *v_ast_expr_t);

    v_list_append(ret, ret, expr, size);

    top := ret + 1;

    cmd += 1;
}

private
gen_expr_list: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    lst = (self: *v_ast_expr_list_t);

    size = v_list_get_size(lst);

    M = 32;         //- ?

    for (i: &size_t := 0;;)
    {
        n: &size_t := undef;

        if (m = size - i, m < M)  n := m;
        else                      n := M;

        for (s = i+n; i < s; ++i)
        {
            gen.visit(v_list_get_item(lst, i));
        }

        if (i == n)
        {
            gen.add_item(my_make_expr_list);
            gen.add_item((n: *void));

            gen.pop_n((n - 1 : int));
        }
        else
        {
            gen.add_item(my_append_expr_list);
            gen.add_item((n: *void));

            gen.pop_n((n: int));
        }

        if (i == size)  break;
    }
}

