//---------------------------------------------------------------------
//- stmt switch
//---------------------------------------------------------------------
export
my_make_stmt_switch: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret = (ast:   *v_ast_stmt_t);
    arg = (ast:   *v_ast_expr_t);
    lst = (ast+1: *v_ast_generic_list_t);

    v_ast_make_stmt_switch(ret, arg, lst);

    top -= 1;
}

private
gen_stmt_switch: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_stmt_switch_t);

    arg = &obj[0];
    lst = &obj[1];

    gen.visit(arg);
    gen.visit(lst);

    gen.add_item(my_make_stmt_switch);

    gen.pop;
}


//---------------------------------------------------------------------
//- case block
//---------------------------------------------------------------------
export
my_make_case_block: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret =  ast;
    arg = (ast+0: *v_ast_expr_list_t);
    lst = (ast+1: *v_ast_stmt_list_t);

    v_ast_make_case_block(ret, arg, lst);

    top -= 1;
}

private
gen_case_block: (aux: *void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_case_block_t);

    arg = &obj[0];
    lst = &obj[1];

    gen.visit(arg);
    gen.visit(lst);

    gen.add_item(my_make_case_block);

    gen.pop;
}


//---------------------------------------------------------------------
//- expr list
//---------------------------------------------------------------------
export
my_make_expr_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - size;

    ret  = (ast: *v_ast_expr_list_t);
    expr = (ast: *v_ast_expr_t);

    if (size) v_make_list(ret, expr, size);
    else      v_make_list_nil(ret);

    top := ret + 1;

    cmd += 1;
}

export
my_append_expr_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - (size + 1);

    ret  = (ast   : *v_ast_expr_list_t);
    expr = (ast+1 : *v_ast_expr_t);

    v_list_append(ret, ret, expr, size);

    top := ret + 1;

    cmd += 1;
}

private
gen_expr_list: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    lst = (self: *v_ast_expr_list_t);

    size = v_list_get_size(lst);

    M = 32;         //- ?

    for (i: &size_t := 0;;)
    {
        n: &size_t := undef;

        if (m = size - i, m < M)  n := m;
        else                      n := M;

        for (s = i+n; i < s; ++i)
        {
            gen.visit(v_list_get_item(lst, i));
        }

        if (i == n)
        {
            gen.add_item(my_make_expr_list);
            gen.add_item((n: *void));

            gen.pop_n((n - 1 : int));
        }
        else
        {
            gen.add_item(my_append_expr_list);
            gen.add_item((n: *void));

            gen.pop_n((n: int));
        }

        if (i == size)  break;
    }
}


//---------------------------------------------------------------------
//- expr call
//---------------------------------------------------------------------
export
my_make_expr_call: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret = (ast:   *v_ast_expr_t);
    fun = (ast+0: *v_ast_expr_t);
    lst = (ast+1: *v_ast_expr_list_t);

    v_ast_make_expr_call(ret, fun, lst);

    top -= 1;
}

private
gen_expr_call: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    call = (self: *v_ast_expr_t);

    fun = v_ast_expr_call_get_fun_expr(call);
    lst = v_ast_expr_call_get_arg_list(call);

    gen.visit(fun);
    gen.visit(lst);

    gen.add_item(my_make_expr_call);

    gen.pop;
}


//---------------------------------------------------------------------
//- expr identifier
//---------------------------------------------------------------------
export
my_make_expr_identifier: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    qn = (cmd[0] : v_quark_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_identifier_q(ret, qn);

    cmd += 1;
    top += 1;
}

private
gen_expr_identifier: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    eid = (self: *v_ast_expr_t);

    qn = v_ast_expr_identifier_get_name_q(eid);

    gen.add_item(my_make_expr_identifier);
    gen.add_item((qn: *void));

    gen.push;
}


//---------------------------------------------------------------------
//- expr integer
//---------------------------------------------------------------------
export
my_make_expr_integer: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    num = (cmd[0] : intptr_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_integer(ret, num);

    cmd += 1;
    top += 1;
}

private
gen_expr_integer: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    enum = (self: *v_ast_expr_t);

    num = v_ast_expr_integer_get_number(enum);

    gen.add_item(my_make_expr_integer);
    gen.add_item((num: *void));

    gen.push;
