{ v_import("mainline.void"); }
{ v_enable_mainline(); }
{
    v_import("type_traits.void");
    v_import("cstring.void");
}

//---------------------------------------------------------------------
printf: (*const char, ...) ~> int;


//---------------------------------------------------------------------
struct my_ast_generator_t
{
    visitor: voidc_visitor_t;           //- Kinda, "base class"...

    //---------------------------------------------------------
    gen_list: v_util_list_t;

    max_stk: int;
    cur_stk: int;
};


//---------------------------------------------------------------------
(v_initialize(_)): (d: *my_ast_generator_t) ~> void
{
    v_initialize(&d->visitor);

    my_get_ast_generator_visitor: () ~> *voidc_visitor_t;

    v_copy(&d->visitor, my_get_ast_generator_visitor());

    v_initialize(&d->gen_list);

    v_make_list_nil(&d->gen_list);

    d->max_stk := 0;
    d->cur_stk := 0;
}

(v_terminate(_)): (*my_ast_generator_t) ~> void  =  derive;

(v_copy(_)): (*my_ast_generator_t, *const my_ast_generator_t) ~> void  =  derive;


//---------------------------------------------------------------------
(_.add_item()): (gen: &my_ast_generator_t, item: *void) ~> void
{
    list = &gen.gen_list;

    a: &v_std_any_t := {};

    v_std_any_set_value(&a, (item: intptr_t));

    v_list_append(list, list, &a);
}

(_.get_item()): (gen: &my_ast_generator_t, idx: size_t) ~> *void  =
{
    list = &gen.gen_list;

    (v_std_any_get_value(intptr_t, v_list_get_item(list, idx)) : *void)
};

//---------------------------------------------------------------------
(_.push): (gen: &my_ast_generator_t) ~> void
{
    r: int = ++gen.cur_stk;

    if (gen.max_stk < r)  gen.max_stk := r;
}

(_.push_n()): (gen: &my_ast_generator_t, n: int) ~> void
{
    r: int = gen.cur_stk += n;

    if (gen.max_stk < r)  gen.max_stk := r;
}

(_.pop): (gen: &my_ast_generator_t) ~> void
{
    v_assert(gen.cur_stk > 0);

    --gen.cur_stk;
}

(_.pop_n()): (gen: &my_ast_generator_t, n: int) ~> void
{
    v_assert(gen.cur_stk >= n);

    gen.cur_stk -= n;

    if (n < 0  &&  gen.max_stk < gen.cur_stk)  gen.max_stk := gen.cur_stk;
}


//---------------------------------------------------------------------
DEBUG_PRINT = false;

#if (DEBUG_PRINT)

indent: &int := 0;

pr_indent: () ~> void
{
    for (i: &int := 0; i < indent; ++i) printf("  ");
}

pr_ctx: (ctx: &my_ast_generator_t) ~> void
{
    printf("[%d, %d, %zd]\n", ctx.max_stk, ctx.cur_stk, v_list_get_size(&ctx.gen_list));
}

#endif

//---------------------------------------------------------------------
export
my_make_empty: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    v_terminate(top);
    v_initialize(top);

    ++top;
}

(_.visit()): (gen: &my_ast_generator_t, ast: *v_ast_base_t) ~> void
{
#if (DEBUG_PRINT)

    if (v_empty(ast))
    {
    //  pr_indent();  printf("empty(\n");
        pr_indent();  printf("empty( ");  pr_ctx(gen);
    }
    else
    {
        q = v_ast_base_get_tag(ast);

    //  pr_indent();  printf("%s(\n", v_quark_to_string(q));
        pr_indent();  printf("%s( ", v_quark_to_string(q));  pr_ctx(gen);
    }

    indent++;

#endif

    if (v_empty(ast))
    {
        gen.add_item(my_make_empty);

        gen.push;
    }
    else
    {
        v_ast_accept_visitor(ast, &gen.visitor);
    }

#if (DEBUG_PRINT)

    indent--;

//  pr_indent();  printf(")\n");
    pr_indent();  printf(") "); pr_ctx(gen);

#endif
}


//---------------------------------------------------------------------
//- unit
//---------------------------------------------------------------------
export
my_make_unit: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    line   = (cmd[0] : int);
    column = (cmd[1] : int);

    ast = top - 1;

    ret  = (ast: *v_ast_unit_t);
    list = (ast: *v_ast_stmt_list_t);

    v_ast_make_unit(ret, list, line, column);

    cmd += 2;
}

private
gen_unit: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    unit = (self: *v_ast_unit_t);

    list   = v_ast_unit_get_stmt_list(unit);
    line   = v_ast_unit_get_line(unit);
    column = v_ast_unit_get_column(unit);

    gen = *(vis: *my_ast_generator_t);

    gen.visit(list);

    gen.add_item(my_make_unit);
    gen.add_item((line  : *void));
    gen.add_item((column: *void));
}


//---------------------------------------------------------------------
//- generic list
//---------------------------------------------------------------------
export
my_make_generic_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size  = (cmd[0] : size_t);
    quark = (cmd[1] : v_quark_t);

    ast = top - size;

    ret = (ast: *v_ast_generic_list_t);

    if (size) v_make_list(ret, quark, ast, size);
    else      v_make_list_nil(ret, quark);

    top := ret + 1;

    cmd += 2;
}

export
my_append_generic_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - (size + 1);

    ret = (ast: *v_ast_generic_list_t);

    v_list_append(ret, ret, ast+1, size);

    top := ret + 1;

    cmd += 1;
}

private
gen_generic_list: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    quark = v_ast_base_get_tag(self);

    lst = (self: *v_ast_generic_list_t);

    size = v_list_get_size(lst);

    M = 32;         //- ?

    for (i: &size_t := 0;;)
    {
        n: &size_t := undef;

        if (m = size - i, m < M)  n := m;
        else                      n := M;

        for (s = i+n; i < s; ++i)
        {
            gen.visit(v_list_get_item(lst, i));
        }

        if (i == n)
        {
            gen.add_item(my_make_generic_list);
            gen.add_item((n    : *void));
            gen.add_item((quark: *void));

            gen.pop_n((n - 1 : int));
        }
        else
        {
            gen.add_item(my_append_generic_list);
            gen.add_item((n: *void));

            gen.pop_n((n: int));
        }

        if (i == size)  break;
    }
}


//---------------------------------------------------------------------
//- unit_stmt_init
//---------------------------------------------------------------------
export
my_make_unit_stmt_init: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 1;

    ret  =  ast;
    stmt = (ast: *v_ast_stmt_t);

    v_ast_make_unit_stmt_init(ret, stmt);
}

private
gen_unit_stmt_init: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_unit_stmt_t);

    gen.visit(&obj.body);

    gen.add_item(my_make_unit_stmt_init);
}


