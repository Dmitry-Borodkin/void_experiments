    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_stmt_loop_t);

    body = &obj[0];

    gen.visit(body);

    gen.add_item(my_make_stmt_loop);
