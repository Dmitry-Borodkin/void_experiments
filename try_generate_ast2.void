//---------------------------------------------------------------------
//- expr string
//---------------------------------------------------------------------
export
my_make_expr_string: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    str = (cmd[0] : *const char);
    len = (cmd[1] : size_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_string_data(ret, str, len);

    cmd += 2;
    top += 1;
}

private
gen_expr_string: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    estr = (self: *v_ast_expr_t);

    len: &size_t := undef;

    str = v_ast_expr_string_get_string_data(estr, &len);

    gen.add_item(my_make_expr_string);
    gen.add_item(str);
    gen.add_item((len: *void));

    gen.push;
}


//---------------------------------------------------------------------
//- expr char
//---------------------------------------------------------------------
export
my_make_expr_char: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    chr = (cmd[0] : char32_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_char(ret, chr);

    cmd += 1;
    top += 1;
}

private
gen_expr_char: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    echr = (self: *v_ast_expr_t);

    chr = v_ast_expr_char_get_char(echr);

    gen.add_item(my_make_expr_char);
    gen.add_item((chr: *void));

    gen.push;
}


//---------------------------------------------------------------------
//- expr struct
//---------------------------------------------------------------------
export
my_make_expr_struct: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    flags = (cmd[0] : int);

    packed = (flags >> 1  : bool);
    export = (flags & 0x1 : bool);

    ast = top - 2;

    ret  = (ast:   *v_ast_expr_t);
    name = (ast+0: *v_ast_expr_t);
    body = (ast+1: *v_ast_stmt_list_t);

    v_ast_make_expr_struct(ret, name, body, packed, export);

    cmd += 1;
    top -= 1;
}

private
gen_expr_struct: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_struct_t);

    name = &obj[0];
    body = &obj[1];

    packed = obj[2];
    export = obj[3];

    gen.visit(name);
    gen.visit(body);

    gen.add_item(my_make_expr_struct);
    gen.add_item(((packed << 1) | export: *void));

    gen.pop;
}


//---------------------------------------------------------------------
//- expr union
//---------------------------------------------------------------------
export
my_make_expr_union: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    export = (cmd[0] : bool);

    ast = top - 2;

    ret  = (ast:   *v_ast_expr_t);
    name = (ast+0: *v_ast_expr_t);
    body = (ast+1: *v_ast_stmt_list_t);

    v_ast_make_expr_union(ret, name, body, export);

    cmd += 1;
    top -= 1;
}

private
gen_expr_union: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_union_t);

    gen.visit(&obj.name);
    gen.visit(&obj.body);

    gen.add_item(my_make_expr_union);
    gen.add_item((obj.export: *void));

    gen.pop;
}


//---------------------------------------------------------------------
//- expr stmt
//---------------------------------------------------------------------
export
my_make_expr_stmt: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 1;

    ret  = (ast: *v_ast_expr_t);
    stmt = (ast: *v_ast_stmt_t);

    v_ast_make_expr_stmt(ret, stmt);
}

private
gen_expr_stmt: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_stmt_t);

    gen.visit(&obj.stmt);

    gen.add_item(my_make_expr_stmt);
}


//---------------------------------------------------------------------
//- expr block
//---------------------------------------------------------------------
export
my_make_expr_block: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret  = (ast:   *v_ast_expr_t);
    slst = (ast+0: *v_ast_stmt_list_t);
    expr = (ast+1: *v_ast_expr_t);

    v_ast_make_expr_block(ret, slst, expr);

    top -= 1;
}

private
gen_expr_block: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_block_t);

    gen.visit(&obj.slst);
    gen.visit(&obj.expr);

    gen.add_item(my_make_expr_block);

    gen.pop;
}


//---------------------------------------------------------------------
//- operator nullary
//---------------------------------------------------------------------
export
my_make_operator: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    quark = (cmd[0] : v_quark_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    sstr: &v_std_string_t := {};

    v_std_string_set(&sstr, "v_");

    v_std_string_append(&sstr, v_quark_to_string(quark)+2);     //- Skip "v."

    op = v_find_symbol_value(v_std_string_get(&sstr));          //- Sic!
    v_assert(op);

    v_copy(ret, (op: *v_ast_expr_t));

    top += 1;
    cmd += 1;
}

export
my_make_operator_nullary: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    quark = (cmd[0] : v_quark_t);

    ast = top - 1;

    ret = (ast: *v_ast_expr_t);
    pay =  ast;

    v_ast_make_operator_nullary(ret, quark, pay);

    cmd += 1;
}

private
gen_operator_nullary: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_operator_nullary_t);

    quark =  obj[0];
    pay   = &obj[1];

    if (v_empty(pay))
    {
        gen.push;

        gen.add_item(my_make_operator);
    }
    else
    {
        gen.visit(pay);

        gen.add_item(my_make_operator_nullary);
    }

    gen.add_item((quark: *void));
}


//---------------------------------------------------------------------
//- operator unary
//---------------------------------------------------------------------
export
my_make_operator_unary: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    prec  = (cmd[0] : unsigned);
    quark = (cmd[1] : v_quark_t);

    ast = top - 1;

    ret = (ast: *v_ast_expr_t);
    pay =  ast;

    v_ast_make_operator_unary(ret, quark, prec, pay);

    cmd += 2;
}

private
gen_operator_unary: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_operator_unary_t);

    quark =  obj[0];
    prec  =  obj[1];
    pay   = &obj[2];

    if (v_empty(pay))
    {
        gen.push;

        gen.add_item(my_make_operator);
    }
    else
    {
        gen.visit(pay);

        gen.add_item(my_make_operator_unary);
        gen.add_item((prec: *void));
    }

    gen.add_item((quark: *void));
}


//---------------------------------------------------------------------
//- operator binary
//---------------------------------------------------------------------
export
my_make_operator_binary: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    prec_l = (cmd[0] : unsigned);
    prec_r = (cmd[1] : unsigned);
    quark  = (cmd[2] : v_quark_t);

    ast = top - 1;

    ret = (ast: *v_ast_expr_t);
    pay =  ast;

    v_ast_make_operator_binary(ret, quark, prec_l, prec_r, pay);

    cmd += 3;
}

private
gen_operator_binary: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *my_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_operator_binary_t);

    quark  =  obj[0];
    prec_l =  obj[1];
    prec_r =  obj[2];
    pay    = &obj[3];

    if (v_empty(pay))
    {
        gen.push;

        gen.add_item(my_make_operator);
    }
    else
    {
        gen.visit(pay);

        gen.add_item(my_make_operator_binary);
        gen.add_item((prec_l: *void));
        gen.add_item((prec_r: *void));
    }

    gen.add_item((quark: *void));
}


